{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/start-engram-daemon.sh\"",
            "timeout": 15,
            "statusMessage": "Starting ENGRAM surface daemon..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/start-engramd-owner.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-session-start-hook.py\"",
            "timeout": 5,
            "statusMessage": "Resetting ENGRAM prompt counter..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-stale-tree-pull-hook.py\"",
            "timeout": 20,
            "statusMessage": "Checking watched repos for stale trees..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-model-gate-prompt.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-time-bar-hook.py\"",
            "timeout": 3,
            "statusMessage": "Stamping ambient time..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-user-identity-hook.py\"",
            "timeout": 3,
            "statusMessage": "Detecting user identity..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-surface-hook.py\"",
            "timeout": 10,
            "statusMessage": "Searching ENGRAM..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-deference-detector-prompt.py\"",
            "timeout": 3,
            "statusMessage": "Surfacing deference markers..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-end-of-day-hook.py\"",
            "timeout": 3,
            "statusMessage": "Checking for end-of-day signals..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-inter-agent-prompt-hook.py\"",
            "timeout": 5,
            "statusMessage": "Checking for inter-agent letters..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-baton-prompt-hook.py\"",
            "timeout": 5,
            "statusMessage": "Checking baton turn-state..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-forum-prompt-hook.py\"",
            "timeout": 5,
            "statusMessage": "Checking forum..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-bash-pipe-exit-warn.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-bash-memrun-advisory.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-lesson-tripwire-hook.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-lesson-tripwire-hook.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^(?:mcp__engram__|mcp__plugin_engram_engram__)(?:engram_activate_goal|engram_add_axiom|engram_add_conjecture|engram_add_cornerstone|engram_add_definition|engram_add_edge|engram_add_goal|engram_add_lesson|engram_add_observation|engram_add_observation_batch|engram_add_person|engram_add_special_moment|engram_add_task|engram_add_trust_signal|engram_advance_turn|engram_ask|engram_cascade_end_unblock|engram_cascade_resolve|engram_cascade_start_unblock|engram_checkpoint|engram_contradict|engram_deactivate_goal|engram_derive|engram_focus|engram_focus_delete_set|engram_focus_load|engram_focus_save|engram_focus_swap|engram_goal_tension|engram_lesson_register_incident|engram_link_about|engram_nap|engram_outgrow_cornerstone|engram_reflect|engram_register_exemplar|engram_remove_edge|engram_report_feeling|engram_requote|engram_resolve|engram_retract|engram_retype_edge|engram_set_person_lineage|engram_set_recall_summaries|engram_set_trust_tier|engram_supersede|engram_unfocus|engram_update_lesson|engram_update_person|engram_update_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-model-gate-pretool.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-lesson-tripwire-hook.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-stale-tree-warn-hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-postcompact-hook.py\"",
            "timeout": 5,
            "statusMessage": "Resetting ENGRAM prompt counter..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-stop-hook.py\"",
            "timeout": 5,
            "statusMessage": "Flagging ENGRAM write check..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-deference-detector-stop.py\"",
            "timeout": 5,
            "statusMessage": "Detecting deference patterns..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-utility-credit-mention-stop.py\"",
            "timeout": 5,
            "statusMessage": "Crediting mentioned nodes..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-loop-arm-stop-hook.py\"",
            "timeout": 5,
            "statusMessage": "Checking loop-arm confirmation..."
          },
          {
            "type": "command",
            "command": "{{PYTHON}} \"${CLAUDE_PLUGIN_ROOT}/hooks/engram-nap-compact-backstop-stop.py\"",
            "timeout": 30,
            "statusMessage": "Checking nap compaction backstop..."
          }
        ]
      }
    ]
  }
}
