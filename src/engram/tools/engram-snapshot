def _snapshot_web(url: str, config: dict) -> dict:
    """Fetch and archive a web page's raw bytes (not extracted text) and
    return the output JSON dict.

    Raw bytes, extension .html -- #1253 open question 1 resolves toward
    verifiability; text extraction, if ever wanted, is a query-time
    derivation, not a capture-time one.

    Any fetch failure (non-2xx, timeout, DNS/connection failure, oversize)
    exits non-zero with the failure in the message and writes NOTHING to the
    archive -- _fetch_url_bytes only ever returns a complete read or raises;
    _archive_write is never reached on failure.
    """
    try:
        content_bytes = _fetch_url_bytes(url, WEB_FETCH_TIMEOUT_SECONDS, WEB_FETCH_MAX_BYTES)
    except RuntimeError as exc:
        print(f"engram-snapshot: web: fetch failed: {exc}", file=sys.stderr)
        sys.exit(EXIT_IO)

    try:
        archive_path, sha = _archive_write(content_bytes, "html")
    except OSError as exc:
        print(f"engram-snapshot: archive write failed: {exc}", file=sys.stderr)
        sys.exit(EXIT_IO)

    return {
        "file_url": _file_url(archive_path),
        "content_hash": sha,
        "captured_at": _now_utc_iso(),
        "git_sha": None,
        "archive_status": "archived",
        "original_url": url,
        "source_type": "web",
        "block_reason": None,
        "evidence_type": EVIDENCE_TYPE_BY_SOURCE["web"],
    }


