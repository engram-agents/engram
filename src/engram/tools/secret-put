#!/usr/bin/env python3
"""secret-put — store one secret from stdin into <home>/secrets/NAME, value-blind [engram#4842 item 3].

Usage:
    secret-put [--home DIR] NAME      (value on stdin; ONE trailing newline is dropped)

If secrets/ is missing it is created 0700 and its inherited ACLs are stripped
(setfacl -b -k) before anything is written. If it exists and the check refuses it, this
refuses with the check's remediation and repairs nothing. The temp file is made INSIDE
secrets/ (mkstemp(dir=secrets), fchmod 0600, fsync, os.replace, fsync of secrets/ itself), because rename keeps the
inode's ACL and a file staged elsewhere can carry a named entry in. The result is re-checked.
Nothing here ever prints a secret value.
"""

import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(_DIR))

import secrets_check  # noqa: E402

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
USAGE = "usage: secret-put [--home DIR] NAME   (value on stdin)"


def _die(msg, code=1):
    print("secret-put: " + msg, file=sys.stderr)
    return code


def _fsync_dir(path):
    """Make the rename itself durable: fsync the directory that holds the new entry."""
    dfd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def _create_secrets_dir(sec):
    try:
        os.mkdir(sec, 0o700)
    except OSError as exc:
        return _die("cannot create secrets folder (%s)" % type(exc).__name__)
    os.chmod(sec, 0o700)
    if sys.platform == "linux":
        try:
            r = subprocess.run(["setfacl", "-b", "-k", str(sec)], capture_output=True, timeout=30)
            ok = r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            ok = False
        if not ok:
            try:
                os.rmdir(sec)
            except OSError:
                pass
            return _die("cannot tell: setfacl failed, so the new folder's ACL could not be cleared; folder removed", 2)
    return 0


def main(argv):
    home = None
    names = []
    j = 0
    while j < len(argv):
        if argv[j] == "--home" and j + 1 < len(argv):
            home = Path(argv[j + 1])
            j += 2
        elif argv[j].startswith("-") and argv[j] != "-":
            return _die("unknown option; " + USAGE)
        else:
            names.append(argv[j])
            j += 1
    if len(names) != 1:
        return _die(USAGE)
    name = names[0]
    if not NAME_RE.match(name):
        return _die("a secret NAME must match ^[A-Za-z0-9][A-Za-z0-9_.-]*$ (refused: %r)" % name)
    if home is None:
        try:
            sys.path.insert(0, str(_DIR))
            from _owner_read import engram_home

            home = engram_home()
        except ValueError as exc:
            return _die(str(exc))

    # Read and validate the value FIRST: a refused value must leave no folder and no temp file.
    try:
        text = sys.stdin.buffer.read().decode("utf-8")
    except UnicodeDecodeError:
        return _die("stdin is not valid UTF-8")
    if text.endswith("\n"):
        text = text[:-1]
    if not text:
        return _die("empty value; nothing stored")
    if "\x00" in text:
        return _die("value contains a NUL byte; nothing stored")

    sec = home / "secrets"
    if not os.path.lexists(sec):
        rc = _create_secrets_dir(sec)
        if rc:
            return rc
    res = secrets_check.check(home)
    if res.code != 0:
        print(secrets_check.render(res), file=sys.stderr)
        return res.code

    fd, tmp = tempfile.mkstemp(dir=str(sec), prefix=".put-")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, sec / name)
        _fsync_dir(sec)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

    res = secrets_check.check(home)
    if res.code != 0:
        print(secrets_check.render(res), file=sys.stderr)
        return res.code
    print("secret-put: stored %s" % name, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
