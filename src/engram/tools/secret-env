#!/usr/bin/env python3
"""secret-env — load named secrets into the environment of ONE child, value-blind [engram#4842 item 3].

Usage:
    secret-env [--home DIR] [--as VAR=NAME ...] NAME [NAME ...] -- CMD [ARGS...]

Refuses (CMD never started) when <home>/secrets/ fails the secrets check (exit 1 refuse,
2 cannot tell). The variable for a NAME is NAME.upper() with '-' and '.' replaced by '_';
--as VAR=NAME overrides it for that NAME. The value is the file content minus ONE trailing
newline. On success the helper becomes CMD (os.execvpe) and prints nothing itself.
Nothing here ever prints a secret value.

The startup-variable list below blocks ACCIDENTS: a secret file whose name maps onto a
variable that changes how programs start or where they connect. It is not a security
boundary, because a secret's name is chosen by the person storing it.
"""

import os
import re
import stat
import sys
from pathlib import Path

_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(_DIR))

import secrets_check  # noqa: E402

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
VAR_RE = re.compile(r"^[A-Z_][A-Z0-9_]*$")
# Variables that change how programs START (or where they look or connect): a secret mapped onto
# one hijacks the child (and whatever it spawns) instead of being a credential, so it is refused
# by name. This blocks ACCIDENTS, not attackers: it is NOT a security boundary, because a
# secret's name is chosen by the person storing it. The lowercase proxy names cannot arise today
# (VAR must match ^[A-Z_][A-Z0-9_]*$); they are listed so the set stays right if that rule changes.
_STARTUP_VARS = frozenset("""PATH HOME SHELL IFS ENV BASH_ENV CDPATH PROMPT_COMMAND PS4 TMPDIR NODE_OPTIONS
GCONV_PATH PERL5OPT PERL5LIB PERLLIB RUBYOPT RUBYLIB
SHELLOPTS BASHOPTS POSIXLY_CORRECT GLIBC_TUNABLES LOCPATH NLSPATH LC_ALL LANG
GIT_SSH_COMMAND GIT_SSH GIT_ASKPASS SSH_ASKPASS GIT_EXEC_PATH EDITOR VISUAL PAGER GIT_PAGER LESSOPEN LESSCLOSE
JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS CLASSPATH NODE_PATH NODE_EXTRA_CA_CERTS
SSL_CERT_FILE SSL_CERT_DIR CURL_CA_BUNDLE REQUESTS_CA_BUNDLE
HTTPS_PROXY HTTP_PROXY ALL_PROXY NO_PROXY https_proxy http_proxy all_proxy no_proxy
GOFLAGS RUSTC_WRAPPER PERL5DB""".split())
_STARTUP_PREFIXES = ("LD_", "DYLD_", "PYTHON", "BASH_FUNC_", "GIT_CONFIG_", "CARGO_", "NPM_CONFIG_", "LC_")
USAGE = "usage: secret-env [--home DIR] [--as VAR=NAME ...] NAME [NAME ...] -- CMD [ARGS...]"


def _die(msg, code=1):
    print("secret-env: " + msg, file=sys.stderr)
    return code


def default_var(name):
    return name.upper().replace("-", "_").replace(".", "_")


def is_startup_var(var):
    return var in _STARTUP_VARS or var.startswith(_STARTUP_PREFIXES)


class SecretRefused(Exception):
    """A secret that cannot be loaded; the message names the NAME and the rule, never a value."""


def read_secret(path):
    """Read one secret file: open without following a symlink and without blocking, fstat the
    OPENED fd and refuse anything but a regular file, then decode (UTF-8, no NUL, ONE trailing
    newline dropped). O_NONBLOCK means a fifo planted after the check cannot hang the open."""
    path = Path(path)
    name = path.name
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        raise SecretRefused("no secret named %s" % name)
    except OSError as exc:
        raise SecretRefused("cannot open secret %s (%s)" % (name, type(exc).__name__))
    with os.fdopen(fd, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            raise SecretRefused("secret %s is not a regular file" % name)
        raw = fh.read()
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise SecretRefused("secret %s is not valid UTF-8" % name)
    if text.endswith("\n"):
        text = text[:-1]
    if "\x00" in text:
        raise SecretRefused("secret %s contains a NUL byte" % name)
    return text


def main(argv):
    if "--" not in argv:
        return _die("missing '--' before the command; " + USAGE)
    i = argv.index("--")
    head, cmd = argv[:i], argv[i + 1:]
    if not cmd:
        return _die("no command after '--'")
    home = None
    overrides = {}  # NAME -> VAR
    names = []
    j = 0
    while j < len(head):
        a = head[j]
        if a == "--home" and j + 1 < len(head):
            home = Path(head[j + 1])
            j += 2
        elif a == "--as" and j + 1 < len(head):
            var, sep, nm = head[j + 1].partition("=")
            if not sep or not VAR_RE.match(var) or not NAME_RE.match(nm):
                return _die("--as wants VAR=NAME, VAR matching ^[A-Z_][A-Z0-9_]*$ and NAME matching ^[A-Za-z0-9][A-Za-z0-9_.-]*$")
            overrides[nm] = var
            j += 2
        elif a.startswith("-") and a != "-":
            return _die("unknown option; " + USAGE)
        else:
            names.append(a)
            j += 1
    if not names:
        return _die("no secret NAME given; " + USAGE)
    for nm in names:
        if not NAME_RE.match(nm):
            return _die("a secret NAME must match ^[A-Za-z0-9][A-Za-z0-9_.-]*$ (refused: %r)" % nm)
    for nm in overrides:
        if nm not in names:
            return _die("--as names %s, which is not among the NAMEs to load" % nm)

    varmap = {nm: overrides.get(nm, default_var(nm)) for nm in names}  # NAME -> VAR, computed once
    for nm in names:
        var = varmap[nm]
        if is_startup_var(var):
            return _die("%s (for secret %s) would override a variable that changes how programs start; refused; "
                        "choose another variable with --as VAR=NAME" % (var, nm))

    if home is None:
        try:
            from _owner_read import engram_home

            home = engram_home()
        except ValueError as exc:
            return _die(str(exc))

    res = secrets_check.check(home)
    if res.code != 0:
        print(secrets_check.render(res), file=sys.stderr)
        return res.code

    env = dict(os.environ)
    seen = {}
    for nm in names:
        var = varmap[nm]
        if var in seen and seen[var] != nm:
            return _die("%s and %s would both set %s" % (seen[var], nm, var))
        seen[var] = nm
        try:
            text = read_secret(home / "secrets" / nm)
        except SecretRefused as exc:
            return _die(str(exc))
        env[var] = text

    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as exc:
        return _die("cannot start %s (%s)" % (cmd[0], type(exc).__name__), 127)
    return 127  # unreachable


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
