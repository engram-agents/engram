#!/usr/bin/env python3
"""secret-env — load named secrets into the environment of ONE child, value-blind [engram#4842 item 3].

Usage:
    secret-env [--home DIR] [--as VAR=NAME ...] NAME [NAME ...] -- CMD [ARGS...]

Refuses (CMD never started) when <home>/secrets/ fails the secrets check (exit 1 refuse,
2 cannot tell). The variable for a NAME is NAME.upper() with '-' and '.' replaced by '_';
--as VAR=NAME overrides it for that NAME. The value is the file content minus ONE trailing
newline. On success the helper becomes CMD (os.execvpe) and prints nothing itself.
Nothing here ever prints a secret value.
"""

import os
import re
import sys
from pathlib import Path

_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(_DIR))

import secrets_check  # noqa: E402

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
VAR_RE = re.compile(r"^[A-Z_][A-Z0-9_]*$")
USAGE = "usage: secret-env [--home DIR] [--as VAR=NAME ...] NAME [NAME ...] -- CMD [ARGS...]"


def _die(msg, code=1):
    print("secret-env: " + msg, file=sys.stderr)
    return code


def default_var(name):
    return name.upper().replace("-", "_").replace(".", "_")


def main(argv):
    if "--" not in argv:
        return _die("missing '--' before the command; " + USAGE)
    i = argv.index("--")
    head, cmd = argv[:i], argv[i + 1:]
    if not cmd:
        return _die("no command after '--'")
    home = None
    overrides = {}  # NAME -> VAR
    names = []
    j = 0
    while j < len(head):
        a = head[j]
        if a == "--home" and j + 1 < len(head):
            home = Path(head[j + 1])
            j += 2
        elif a == "--as" and j + 1 < len(head):
            var, sep, nm = head[j + 1].partition("=")
            if not sep or not VAR_RE.match(var) or not NAME_RE.match(nm):
                return _die("--as wants VAR=NAME, VAR matching ^[A-Z_][A-Z0-9_]*$ and NAME matching ^[A-Za-z0-9][A-Za-z0-9_.-]*$")
            overrides[nm] = var
            j += 2
        elif a.startswith("-") and a != "-":
            return _die("unknown option; " + USAGE)
        else:
            names.append(a)
            j += 1
    if not names:
        return _die("no secret NAME given; " + USAGE)
    for nm in names:
        if not NAME_RE.match(nm):
            return _die("a secret NAME must match ^[A-Za-z0-9][A-Za-z0-9_.-]*$ (refused: %r)" % nm)
    for nm in overrides:
        if nm not in names:
            return _die("--as names %s, which is not among the NAMEs to load" % nm)

    if home is None:
        try:
            from _owner_read import engram_home

            home = engram_home()
        except ValueError as exc:
            return _die(str(exc))

    res = secrets_check.check(home)
    if res.code != 0:
        print(secrets_check.render(res), file=sys.stderr)
        return res.code

    env = dict(os.environ)
    seen = {}
    for nm in names:
        var = overrides.get(nm, default_var(nm))
        if var in seen and seen[var] != nm:
            return _die("%s and %s would both set %s" % (seen[var], nm, var))
        seen[var] = nm
        path = home / "secrets" / nm
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        except FileNotFoundError:
            return _die("no secret named %s" % nm)
        except OSError as exc:
            return _die("cannot open secret %s (%s)" % (nm, type(exc).__name__))
        with os.fdopen(fd, "rb") as fh:
            raw = fh.read()
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            return _die("secret %s is not valid UTF-8" % nm)
        if text.endswith("\n"):
            text = text[:-1]
        if "\x00" in text:
            return _die("secret %s contains a NUL byte" % nm)
        env[var] = text

    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as exc:
        return _die("cannot start %s (%s)" % (cmd[0], type(exc).__name__), 127)
    return 127  # unreachable


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
