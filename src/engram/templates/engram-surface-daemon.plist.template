<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.engram.surface-daemon</string>

    <!-- #2652 phase-0 unit 3: the trailing ENGRAM_HOME argv is unused by
         the script itself (ENGRAM_HOME is still resolved from
         EnvironmentVariables below); it exists solely so
         start-engram-daemon.sh's `pgrep -f`-based reap pattern
         (end-anchored on ENGRAM_HOME) can see and scope on it.
         EnvironmentVariables is an env var, invisible to `pgrep -f` (it
         matches argv/cmdline only), so without this trailing argv a
         daemon launched by this LaunchAgent was un-reapable by that
         pattern. Mirrors start-engram-daemon.sh's own launch line's argv
         shape exactly. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{ENGRAM_HOOKS_DIR}}/engram-surface-daemon.py</string>
        <string>{{ENGRAM_HOME}}</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ENGRAM_HOME</key>
        <string>{{ENGRAM_HOME}}</string>
        <key>ENGRAM_DAEMON_IDLE_TIMEOUT</key>
        <string>0</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{ENGRAM_HOME}}/surface-daemon.log</string>

    <key>StandardErrorPath</key>
    <string>{{ENGRAM_HOME}}/surface-daemon.log</string>
</dict>
</plist>
