<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.engram.viz-server</string>
    <key>ProcessType</key><string>Background</string>
    <!-- "-m viz.server" (not a direct viz/server.py script path): viz/server.py
         uses relative imports to reach its sibling modules, which only
         resolve when run as part of the viz package. WorkingDirectory
         below puts PLUGIN_ENGRAM_DIR on sys.path so viz resolves
         (engram-alpha#2555). -->
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>-m</string>
        <string>viz.server</string>
        <string>--bind</string><string>127.0.0.1</string>
        <string>--port</string><string>5001</string>
        <string>--config</string><string>{{VIZ_CONFIG}}</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>WorkingDirectory</key><string>{{PLUGIN_ENGRAM_DIR}}</string>
    <key>StandardOutPath</key><string>{{ENGRAM_HOME}}/viz-server.log</string>
    <key>StandardErrorPath</key><string>{{ENGRAM_HOME}}/viz-server.err</string>
</dict>
</plist>
