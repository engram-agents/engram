# ENGRAM forum DB backup — systemd --user oneshot unit TEMPLATE
#
# >>>TEMPLATE-ONLY (install-forum-service.sh strips this block when rendering)
#     {{FORUM_HOME}} is a placeholder. install-forum-service.sh renders it to the
#     forum's service dir (--service-dir) and installs the result as
#     engram-forum-backup.service; the script runs from the snapshot the installer
#     keeps at {{FORUM_HOME}}/app/tools/forum_backup.py, never from a checkout.
# <<<TEMPLATE-ONLY
#
# Runs forum_backup.py with defaults (snaps the live forum DB into a
# text SQL dump + copies the audit JSONL, then commits to a local git repo).
# Triggered by the companion timer: engram-forum-backup.timer
#
# Install: see the "Backup timer" section of src/forum/deploy/README.md.
# Enable:  systemctl --user enable --now engram-forum-backup.timer
# Restore: stop the forum service, then:
#          sqlite3 {{FORUM_HOME}}/forum.db \
#              < {{FORUM_HOME}}/backup/forum.sql
#
# This unit is a oneshot — it runs the backup script once per timer fire and
# exits. Failures surface via:  systemctl --user status engram-forum-backup.service
#
# Adapted from engram-forum.service.template (same --user shape, different purpose).

[Unit]
Description=ENGRAM forum DB backup (iterdump + git snapshot)
Documentation=https://github.com/engram-agents/engram/blob/main/src/forum/deploy/README.md
After=network-online.target
# #3276: a failed run posts a forum thread (see engram-forum-backup-alarm.service)
# so a broken backup is never silent again.
OnFailure=engram-forum-backup-alarm.service

[Service]
Type=oneshot
# Run with the same UMask as the forum service so backup files in the shared
# dir are group-writable (664/775) and a counterpart admin can read them.
UMask=002
# Interpreter: the FORUM's own venv, NOT system python3. The forum venv has
# sqlite_vec installed (same interpreter the live forum server runs under), so
# the backup runs with the vec0 extension present — eliminating the #1057 class
# (system python3 lacks sqlite_vec, so a vec-bearing forum.db backup died with
# "no such module: vec0"). Belt-and-suspenders with the extension-free strip
# (#1057/#1089): the tool works under any interpreter AND the unit runs under the
# right one, matching the server. The script is the installer's snapshot under
# the service dir, so it moves with each deploy rather than with whatever branch a
# checkout happens to be on.
ExecStart={{FORUM_HOME}}/.venv/bin/python \
    {{FORUM_HOME}}/app/tools/forum_backup.py \
    --db {{FORUM_HOME}}/forum.db \
    --backup-dir {{FORUM_HOME}}/backup \
    --audit {{FORUM_HOME}}/forum-audit.jsonl
# stdout+stderr go to the journal; surface with:
#   journalctl --user -u engram-forum-backup.service
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
