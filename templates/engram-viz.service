[Unit]
Description=ENGRAM Visualization Server (multi-agent)
After=network.target

[Service]
Type=simple
# Runs as agent-borges so the process can read its own DB freely.
# SupplementaryGroups=agents grants read access to peer agents'
# DBs (group-readable per the Phase 1 permission migration:
# /home/agent-{borges,mneme} are chgrp agents + g+x, and each
# .engram[*]/knowledge.db* is chgrp agents + g+r).
User=agent-borges
Group=agent-borges
SupplementaryGroups=agents

WorkingDirectory=/home/agent-borges/.engram
ExecStart=/home/linuxbrew/.linuxbrew/bin/python3 /home/agent-borges/.engram/viz_server.py --bind 127.0.0.1 --port 5001 --config /etc/engram-viz/agents.json

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
