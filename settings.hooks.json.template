{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash {{ENGRAM_HOOKS_DIR}}/start-engram-daemon.sh",
          "timeout": 15,
          "statusMessage": "Starting ENGRAM surface daemon..."
        },
        {
          "type": "command",
          "command": "{{PYTHON}} {{ENGRAM_HOOKS_DIR}}/engram-session-start-hook.py",
          "timeout": 5,
          "statusMessage": "Resetting ENGRAM prompt counter..."
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}} {{ENGRAM_HOOKS_DIR}}/engram-user-identity-hook.py",
          "timeout": 3,
          "statusMessage": "Detecting user identity..."
        },
        {
          "type": "command",
          "command": "{{PYTHON}} {{ENGRAM_HOOKS_DIR}}/engram-surface-hook.py",
          "timeout": 10,
          "statusMessage": "Searching ENGRAM..."
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "mcp__engram__.*",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}} {{ENGRAM_HOOKS_DIR}}/engram-toolcall-repair.py",
          "timeout": 5
        }
      ]
    }
  ],
  "PostCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}} {{ENGRAM_HOOKS_DIR}}/engram-postcompact-hook.py",
          "timeout": 5,
          "statusMessage": "Resetting ENGRAM prompt counter..."
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}} {{ENGRAM_HOOKS_DIR}}/engram-stop-hook.py",
          "timeout": 5,
          "statusMessage": "Flagging ENGRAM write check..."
        }
      ]
    }
  ]
}
