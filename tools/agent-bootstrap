#!/bin/bash
# =============================================================================
# agent-bootstrap — root-only one-time substrate setup for a new co-located
# AI agent on a multi-agent host.
#
# Substrate role: this script creates the kernel-isolation bits (uid + group + home
# perms + community-dir membership + a runtime-specific `~/.runtime/start.sh` adapter)
# and then runs the SAME installer a public install runs, `tools/install.sh`, AS THE
# NEWBORN (never as root): it clones engram-alpha into the newborn's home, checks out the
# newest deployable tag, and runs `tools/install.sh --install-claude-code --yes`. Claude
# Code therefore lands natively in the newborn's own home; nothing is symlinked from
# another agent's home. OAuth login (`/login`) stays a human step.
#
# Canonical source: tools/agent-bootstrap in the engram-alpha repo.
# Production path: /usr/local/sbin/agent-bootstrap (the operator copies after each
# version bump). Both the operator and `agentctl spawn` invoke the production path.
#
# Usage:
#   sudo agent-bootstrap NAME --runtime RT [--home-mode 0700]
#                             [--alpha-source PATH]
#                             [--tier essential|convenience|dev] [--multi-agent]
#                             [--forum-url URL] [--no-install]
#
#   NAME           short identifier ("borges", "newborn-20260505083012", ...).
#                  Becomes Linux user "agent-NAME" with home /home/agent-NAME.
#                  For spawn-flow placeholders, use the
#                  agent-newborn-YYYYMMDDhhmmss pattern (`agentctl spawn`
#                  computes this automatically).
#   --runtime      claude  (v0.1: claude only — see "v0.1 scope" note below)
#                  Selects which runtime adapter to drop into ~/.runtime/.
#                  v0.1 supports the claude runtime exclusively. Multi-runtime
#                  support (gemini-cli, codex) is forthcoming as a separate
#                  epic with proper per-runtime test fixtures and end-to-end
#                  validation; until then, this script rejects any --runtime
#                  value other than "claude" rather than silently producing
#                  a half-supported agent (the corruption pattern that
#                  prompted the explicit-scope decision per the
#                  spawn-implementation PR review of 2026-05-05).
#   --home-mode    home directory mode bits (default: 0700, owner-only).
#                  Use 0750 if you want the operator to read everything by default.
#   --alpha-source path to the engram-alpha checkout the newborn CLONES (git clone
#                  --no-hardlinks, as the newborn). Default: $ENGRAM_ALPHA_SOURCE if
#                  set, else /home/agents-shared/engram-alpha if it exists, else empty
#                  (then pass --alpha-source, or --no-install). The newborn's clone is
#                  checked out at the newest deployable tag (v* or deploy/*) that is an
#                  ancestor of the clone's origin/dev or origin/main; no such tag is a
#                  FAIL, never a fallback to the branch head. PATH must be a normal repo
#                  (its .git a directory): a linked worktree (.git a file) is refused in
#                  preflight. PATH is resolved once to an absolute physical path (pwd -P)
#                  before anything is created.
#   --tier         passed to install.sh (essential|convenience|dev). Absent: install.sh's
#                  own default applies.
#   --multi-agent  passed to install.sh.
#   --forum-url    passed to install.sh.
#   --sandbox-build-ref REF
#                  SANDBOX RIGS ONLY, not a release: skip the deployable-tag pick and check
#                  out exactly REF (a branch such as dev, a tag, or a commit SHA reachable in
#                  the clone), detached. Prints `SANDBOX BUILD (not a release): REF = SHA`
#                  before install and as the first line of the next-steps block, and passes
#                  --sandbox-untagged to install.sh. Only this flag turns it on (no env var
#                  or config); an unresolvable REF is a FAIL. Conflicts with --no-install.
#   --no-install   substrate only (the old two-step flow): no clone, no install.sh, no
#                  Claude Code. The operator then installs from inside the newborn shell.
#
# Reversibility:
#   sudo userdel -r agent-NAME              # removes user + home + mail spool
#   sudo groupdel agents                    # only after all agents removed
#   sudo rm -rf /home/agents-shared         # only after all agents removed
#
# Spawn-flow context:
#   `agentctl spawn` invokes this script with NAME=newborn-<timestamp>, passing
#   `--tier dev --multi-agent` (and --forum-url when given) then prints its own
#   follow-up. The operator then logs in (`/login`), runs `claude` for the naming
#   dialogue, and completes the rename via
#   `agentctl finalize-name newborn-<timestamp> <chosen>`.
# =============================================================================

set -euo pipefail

# ---------- functions (sourceable: AGENT_BOOTSTRAP_LIB_ONLY=1 stops after these) ----------

# ab_option_like_ref_msg: the one message for a --sandbox-build-ref that starts with '-'.
ab_option_like_ref_msg() {
    echo "agent-bootstrap: --sandbox-build-ref '$SANDBOX_REF' looks like an option, not a ref." >&2
}

# ab_parse_args "$@": sets NAME RUNTIME HOME_MODE ALPHA_SOURCE TIER MULTI_AGENT FORUM_URL
# NO_INSTALL. Exits 2 on a bad or missing argument. Does not need root.
ab_parse_args() {
    NAME=""
    RUNTIME=""
    HOME_MODE="0700"
    ALPHA_SOURCE=""
    TIER=""
    MULTI_AGENT=0
    FORUM_URL=""
    NO_INSTALL=0
    SANDBOX_REF=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --runtime)      RUNTIME="${2:?--runtime requires a value}"; shift 2 ;;
            --home-mode)    HOME_MODE="${2:?--home-mode requires a value}"; shift 2 ;;
            --alpha-source) ALPHA_SOURCE="${2:?--alpha-source requires a value}"; shift 2 ;;
            --tier)         TIER="${2:?--tier requires a value}"; shift 2 ;;
            --multi-agent)  MULTI_AGENT=1; shift ;;
            --forum-url)    FORUM_URL="${2:?--forum-url requires a value}"; shift 2 ;;
            --no-install)   NO_INSTALL=1; shift ;;
            --sandbox-build-ref) SANDBOX_REF="${2:?--sandbox-build-ref requires a value}"
                                 if [[ "$SANDBOX_REF" == -* ]]; then ab_option_like_ref_msg; exit 2; fi
                                 shift 2 ;;
            --help|-h)
                sed -n '3,/^# ====/p' "$0"; exit 0 ;;
            -*)
                echo "Unknown flag: $1" >&2; exit 2 ;;
            *)
                if [[ -z "$NAME" ]]; then NAME="$1"
                else echo "Unexpected arg: $1" >&2; exit 2
                fi
                shift ;;
        esac
    done

    [[ -z "$NAME"    ]] && { echo "agent name required"     >&2; exit 2; }
    [[ -z "$RUNTIME" ]] && { echo "--runtime required"      >&2; exit 2; }
    [[ "$RUNTIME" == "claude" ]] || { echo "ERROR: v0.1 supports --runtime=claude only. gemini-cli and codex support is forthcoming as a separate epic with per-runtime test fixtures; rejecting non-claude runtime rather than half-supporting (per spawn-implementation PR review 2026-05-05)." >&2; exit 2; }
    if [[ -n "$SANDBOX_REF" && "$NO_INSTALL" == "1" ]]; then
        echo "ERROR: --sandbox-build-ref selects what install.sh builds from; it cannot be combined with --no-install." >&2; exit 2
    fi
    case "$TIER" in
        ""|essential|convenience|dev) ;;
        *) echo "ERROR: invalid --tier '$TIER' (expected essential, convenience or dev)" >&2; exit 2 ;;
    esac
}

# ab_preflight_source: resolve ALPHA_SOURCE ONCE, before useradd or anything else creates state:
# `cd` + `pwd -P` gives an absolute, symlink-free string with no trailing slash. That one string
# is used for BOTH the trust entry (<src>/.git) and the `git clone` argument, so they cannot
# disagree (a trailing slash made git name <src>//.git, which the trust entry did not match;
# a relative path was resolved against root's cwd here but the newborn's home at clone time).
# Returns 2, naming the path as given, when an install is wanted and the source is empty, not a
# directory, or not a normal repo (<src>/.git a directory; a linked worktree has a .git FILE and
# git names a different path for it). With --no-install nothing is cloned, so an empty or missing
# source is allowed as before and only normalised when it resolves.
ab_preflight_source() {
    local given="$ALPHA_SOURCE" resolved
    if [[ -z "$given" ]]; then
        [[ "$NO_INSTALL" == "1" ]] && return 0
        echo "ERROR: no engram-alpha checkout to install from (--alpha-source '')." >&2
        echo "       Pass --alpha-source PATH (or set ENGRAM_ALPHA_SOURCE), or --no-install for substrate only." >&2
        return 2
    fi
    if ! resolved="$(CDPATH= cd -- "$given" 2>/dev/null && pwd -P)" || [[ -z "$resolved" ]]; then
        [[ "$NO_INSTALL" == "1" ]] && return 0
        echo "ERROR: no engram-alpha checkout to install from (--alpha-source '$given' is not a directory)." >&2
        echo "       Pass --alpha-source PATH (or set ENGRAM_ALPHA_SOURCE), or --no-install for substrate only." >&2
        return 2
    fi
    ALPHA_SOURCE="$resolved"
    if [[ "$NO_INSTALL" != "1" && ! -d "$ALPHA_SOURCE/.git" ]]; then
        echo "ERROR: --alpha-source '$given' ($ALPHA_SOURCE) must be a normal repo: its .git must be a directory." >&2
        echo "       A linked worktree (.git is a file) or a bare repo is not supported; point at the main checkout." >&2
        return 2
    fi
    return 0
}

# ab_as_newborn CMD...: run CMD as the newborn (never as root), with the newborn's HOME.
# cwd is the newborn's home: root's cwd may be unreadable to the newborn.
ab_as_newborn() {
    ( cd "$USER_HOME" && sudo -u "$USER_NAME" -H "$@" )
}

# ab_pick_deployable_tag CLONE: print the newest deployable tag, or return 1.
# The rule is install-local-marketplace.sh's (not a new one): a tag matching ^(v|deploy/)
# whose commit is an ancestor of origin/dev or origin/main. "Newest" = latest commit date;
# on a tie a v* tag wins. Runs git AS THE NEWBORN (the clone is the newborn's).
ab_pick_deployable_tag() {
    local clone="$1" tags tag ct rank
    local best="" best_ct=-1 best_rank=9 ref anc
    tags="$(ab_as_newborn git -C "$clone" tag --list 'v*' 'deploy/*')" || return 1
    while IFS= read -r tag; do
        [[ -n "$tag" ]] || continue
        anc=0
        for ref in refs/remotes/origin/dev refs/remotes/origin/main; do
            if ab_as_newborn git -C "$clone" merge-base --is-ancestor "refs/tags/${tag}^{commit}" "$ref" >/dev/null 2>&1; then
                anc=1; break
            fi
        done
        [[ $anc -eq 1 ]] || continue
        ct="$(ab_as_newborn git -C "$clone" log -1 --format=%ct "refs/tags/${tag}^{commit}")" || continue
        rank=1
        [[ "$tag" == v* ]] && rank=0
        if (( ct > best_ct || (ct == best_ct && rank < best_rank) )); then
            best="$tag"; best_ct=$ct; best_rank=$rank
        fi
    done <<<"$tags"
    [[ -n "$best" ]] || return 1
    printf '%s\n' "$best"
}

# ab_checkout_sandbox_ref CLONE: SANDBOX RIGS ONLY. Check out exactly $SANDBOX_REF (origin/<ref>,
# then a tag, then a SHA) detached, as the newborn; set and print SANDBOX_BANNER. No tag rule.
# Returns non-zero, naming the ref, if it does not resolve. Only the --sandbox-build-ref flag
# reaches here: nothing reads an environment variable for it.
ab_checkout_sandbox_ref() {
    local clone="$1" sha="" cand rc=0
    if [[ "$SANDBOX_REF" == -* ]]; then
        ab_option_like_ref_msg
        ab_left_in_place_note
        return 1
    fi
    for cand in "refs/remotes/origin/$SANDBOX_REF" "refs/tags/$SANDBOX_REF" "$SANDBOX_REF"; do
        if sha="$(ab_as_newborn git -C "$clone" rev-parse --verify --quiet "${cand}^{commit}" 2>/dev/null)" && [[ -n "$sha" ]]; then
            break
        fi
        sha=""
    done
    if [[ -z "$sha" ]]; then
        echo "agent-bootstrap: --sandbox-build-ref '$SANDBOX_REF' does not resolve in the clone of $ALPHA_SOURCE (tried origin/$SANDBOX_REF, tag $SANDBOX_REF, a commit SHA)." >&2
        ab_left_in_place_note
        return 1
    fi
    ab_as_newborn git -C "$clone" checkout --quiet --detach "$sha" || rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "agent-bootstrap: git checkout of $SANDBOX_REF ($sha) failed (exit $rc)." >&2
        ab_left_in_place_note
        return "$rc"
    fi
    CLONE_TAG=""
    SANDBOX_BANNER="SANDBOX BUILD (not a release): $SANDBOX_REF = $sha"
    echo "$SANDBOX_BANNER"
}

# Said on every failure after the user exists: spawn is not transactional.
ab_left_in_place_note() {
    echo "agent-bootstrap: the user $USER_NAME and $USER_HOME were created and are left in place (spawn is not transactional)." >&2
    echo "                 To remove them: sudo userdel -r $USER_NAME" >&2
}

# ab_clone_and_install: clone ALPHA_SOURCE into the newborn's home as the newborn, check out
# the newest deployable tag, run tools/install.sh as the newborn. Returns install.sh's exit
# code (non-zero on any failure along the way). Never passes --allow-untagged/--allow-branch.
#
# Trust for the CLONE ONLY: the source checkout belongs to another uid, so git refuses it
# ("dubious ownership"; measured on git 2.43.0: -c safe.directory=... does not help a clone).
# A throwaway GIT_CONFIG_GLOBAL file naming exactly the source's .git (never '*', never the
# parent dir) is handed to the clone command alone and removed right after it, success or
# failure. Nothing is written to the newborn's ~/.gitconfig, /etc/gitconfig or any persistent
# config; every later git command runs on the newborn's own clone and needs no trust.
ab_clone_and_install() {
    local clone="$USER_HOME/engram-alpha" rc=0 tag
    local srcgit="$ALPHA_SOURCE/.git" cfgdir cfg esc
    CLONE_TAG=""
    echo "Cloning $ALPHA_SOURCE -> $clone (as $USER_NAME)..."
    cfgdir="$(mktemp -d)" || { echo "agent-bootstrap: mktemp failed" >&2; ab_left_in_place_note; return 1; }
    # Remove the trust dir on EXIT and on INT/TERM too (a signal mid-clone must not leave it);
    # INT/TERM then exit with the conventional 128+signal. Cleared right after the explicit rm.
    trap 'rm -rf -- "$cfgdir"' EXIT
    trap 'rm -rf -- "$cfgdir"; exit 130' INT
    trap 'rm -rf -- "$cfgdir"; exit 143' TERM
    cfg="$cfgdir/gitconfig"
    chmod 0755 "$cfgdir"
    # The value is git-config quoted: an unquoted `#` or `;` starts a comment and cuts the path.
    esc="${srcgit//\\/\\\\}"; esc="${esc//\"/\\\"}"
    printf '[safe]\n\tdirectory = "%s"\n' "$esc" > "$cfg" && chmod 0644 "$cfg" || rc=$?
    if [[ $rc -eq 0 ]]; then
        ab_as_newborn env "GIT_CONFIG_GLOBAL=$cfg" git clone --quiet --no-hardlinks -- "$ALPHA_SOURCE" "$clone" || rc=$?
    fi
    rm -rf -- "$cfgdir"   # success or failure: the trust entry never outlives the clone command
    trap - EXIT INT TERM
    if [[ $rc -ne 0 ]]; then
        echo "agent-bootstrap: git clone of $ALPHA_SOURCE failed (exit $rc). See the git error above." >&2
        echo "                 If it says 'dubious ownership' even so, the scoped trust file did not take: check the git version, or pass --no-install." >&2
        ab_left_in_place_note
        return "$rc"
    fi
    SANDBOX_BANNER=""
    if [[ -n "${SANDBOX_REF:-}" ]]; then
        ab_checkout_sandbox_ref "$clone" || return $?
        if [[ ! -f "$clone/tools/install.sh" ]]; then
            echo "agent-bootstrap: --sandbox-build-ref '$SANDBOX_REF' has no tools/install.sh at that commit; pick a ref that contains it." >&2
            ab_left_in_place_note
            return 1
        fi
    else
        if ! tag="$(ab_pick_deployable_tag "$clone")"; then
            echo "agent-bootstrap: no deployable tag found in $clone: need a v* or deploy/* tag that is an ancestor of origin/dev or origin/main." >&2
            echo "                 The branch head is never installed (deploy only from a tag). Tag a merged commit in $ALPHA_SOURCE, or pass --no-install." >&2
            echo "                 Refresh the source's tags (operator action on the source, NOT done by agent-bootstrap): git -C $ALPHA_SOURCE fetch --tags origin" >&2
            echo "                 The tag must also be reachable from the source's local dev or main (the clone's origin/dev is that local dev), so advance them too: git -C $ALPHA_SOURCE checkout dev && git -C $ALPHA_SOURCE pull --ff-only. A source detached at a tag with no local dev/main hits this message." >&2
            ab_left_in_place_note
            return 1
        fi
        ab_as_newborn git -C "$clone" checkout --quiet --detach "refs/tags/$tag" || rc=$?
        if [[ $rc -ne 0 ]]; then
            echo "agent-bootstrap: git checkout of tag $tag failed (exit $rc)." >&2
            ab_left_in_place_note
            return "$rc"
        fi
        CLONE_TAG="$tag"
        echo "  checked out tag $tag"

        # A tag cut before the scripted installer existed has no tools/install.sh. Fail here, loudly,
        # instead of running a nonexistent script. No fetch happens here (the newborn has no
        # credentials, and the source checkout is the operator's to refresh).
        if [[ ! -f "$clone/tools/install.sh" ]]; then
            echo "agent-bootstrap: the newest deployable tag ($tag) predates the scripted installer: $clone/tools/install.sh does not exist at that tag." >&2
            echo "                 1. The source checkout's tags may be stale. Refresh them (operator action on the source, NOT done by agent-bootstrap): git -C $ALPHA_SOURCE fetch --tags origin" >&2
            echo "                    The tag must also be reachable from the source's local dev or main (the clone's origin/dev is that local dev), so advance them too: git -C $ALPHA_SOURCE checkout dev && git -C $ALPHA_SOURCE pull --ff-only. A source detached at a tag with no local dev/main hits this message." >&2
            echo "                 2. Otherwise a release tag containing tools/install.sh is needed (tag a merged commit that has it)." >&2
            echo "                 3. For a sandbox/test rig only (not a release): --sandbox-build-ref <ref> builds from an exact ref." >&2
            echo "                 4. Or pass --no-install for the two-step flow (substrate only, then install by hand)." >&2
            ab_left_in_place_note
            return 1
        fi
    fi

    local -a iargs=(--install-claude-code --yes)
    if [[ -n "${SANDBOX_REF:-}" ]]; then iargs+=(--sandbox-untagged); fi
    if [[ -n "$TIER" ]]; then iargs+=(--tier "$TIER"); fi
    if [[ "$MULTI_AGENT" == "1" ]]; then iargs+=(--multi-agent); fi
    if [[ -n "$FORUM_URL" ]]; then iargs+=(--forum-url "$FORUM_URL"); fi

    echo "Running tools/install.sh as $USER_NAME..."
    ab_as_newborn env -u ANTHROPIC_API_KEY -u ENGRAM_HOME "HOME=$USER_HOME" \
        bash "$clone/tools/install.sh" "${iargs[@]}" || rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "agent-bootstrap: tools/install.sh exited $rc; its FAIL line is above. Logs: $USER_HOME/.engram/install-logs/" >&2
        ab_left_in_place_note
        return "$rc"
    fi
    return 0
}

# ab_print_next_steps: the closing block. Reads NAME USER_NAME USER_HOME RUNTIME HOME_MODE
# ALPHA_SOURCE NO_INSTALL CLONE_TAG.
ab_print_next_steps() {
    if [[ "$NO_INSTALL" == "1" ]]; then
        cat <<NEXT

Agent $USER_NAME created (uid=$(id -u "$USER_NAME" 2>/dev/null || echo "?"), runtime=$RUNTIME).
Home: $USER_HOME (mode $HOME_MODE)
Joined group: agents
ENGRAM install: SKIPPED (--no-install). Alpha source for the runtime wrapper: ${ALPHA_SOURCE:-(not set — edit ~/.runtime/install.sh manually)}

Next steps:
  1. Enter the new agent's bash login shell:
       agentctl bash $NAME
       # or, if agentctl is unavailable: sudo -u $USER_NAME -i

  2. Install Claude Code inside that shell (the installer runs remote code):
       curl -fsSL https://claude.ai/install.sh | bash

  3. Materialize the ENGRAM runtime:
       bash ~/.runtime/install.sh

  4. Login to the LLM provider, then start the first session:
       claude          # then /login at the first prompt
     SessionStart hook fires engram-first-session: agent generates 3
     candidate names; you pick collaboratively.

  5. From the operator's shell, finalize the rename (single-shot, no rename later):
       sudo agentctl finalize-name $NAME <chosen-name>

To remove (before finalize-name):
  sudo userdel -r $USER_NAME
NEXT
        return 0
    fi
    if [[ -n "${SANDBOX_BANNER:-}" ]]; then printf '%s\n' "$SANDBOX_BANNER"; fi
    cat <<NEXT

Agent $USER_NAME created (uid=$(id -u "$USER_NAME" 2>/dev/null || echo "?"), runtime=$RUNTIME).
Home: $USER_HOME (mode $HOME_MODE)
Joined group: agents
ENGRAM installed by tools/install.sh from $USER_HOME/engram-alpha at tag ${CLONE_TAG:-?} (Claude Code installed natively in the newborn's own home).

Next steps:
  1. Enter the new agent's bash login shell:
       agentctl bash $NAME
       # or, if agentctl is unavailable: sudo -u $USER_NAME -i

  2. Start Claude Code and log in (interactive):
       claude          # then /login at the first prompt

  3. The naming dialogue: SessionStart hook fires engram-first-session; the
     agent generates 3 candidate names; you pick collaboratively.

  4. From the operator's shell, finalize the rename (single-shot, no rename later):
       sudo agentctl finalize-name $NAME <chosen-name>

To remove (before finalize-name):
  sudo userdel -r $USER_NAME
NEXT
}

if [[ -n "${AGENT_BOOTSTRAP_LIB_ONLY:-}" ]]; then
    return 0 2>/dev/null || exit 0
fi

# ---------- arg parse ----------
ab_parse_args "$@"
[[ $EUID -eq 0   ]] || { echo "must run as root (use sudo)" >&2; exit 2; }

USER_NAME="agent-$NAME"
USER_HOME="/home/$USER_NAME"
SHARED_ROOT="/home/agents-shared"

# Resolve --alpha-source default. Prefer an explicit env override, then a
# shared community checkout, else leave empty for the user to supply.
if [[ -z "$ALPHA_SOURCE" ]]; then
    if [[ -n "${ENGRAM_ALPHA_SOURCE:-}" && -d "$ENGRAM_ALPHA_SOURCE" ]]; then
        ALPHA_SOURCE="$ENGRAM_ALPHA_SOURCE"
    elif [[ -d "/home/agents-shared/engram-alpha" ]]; then
        ALPHA_SOURCE="/home/agents-shared/engram-alpha"
    else
        ALPHA_SOURCE=""  # rendered path will be empty; user must pass --alpha-source or set ENGRAM_ALPHA_SOURCE
    fi
fi

# ---------- preflight ----------
# Resolve the source ONCE, before anything creates state (see ab_preflight_source).
ab_preflight_source || exit $?
if id "$USER_NAME" >/dev/null 2>&1; then
    echo "ERROR: user $USER_NAME already exists. Aborting." >&2
    echo "       Run 'userdel -r $USER_NAME' first if you intend to recreate." >&2
    exit 1
fi
if ! getent group agents >/dev/null 2>&1; then
    echo "agents group missing — creating now."
    groupadd agents
fi

# ---------- 1. create the user ----------
useradd \
    --create-home \
    --groups agents \
    --shell /bin/bash \
    --comment "AI agent runtime - $RUNTIME" \
    "$USER_NAME"
chmod "$HOME_MODE" "$USER_HOME"

# ---------- 2. ~/.bashrc skeleton ----------
# CRITICAL (billing-leak guard): never export ANTHROPIC_API_KEY / GOOGLE_API_KEY
# in agent-bashrc. API keys in env silently route headless `claude -p`
# calls to API Tier 1 instead of the OAuth Max subscription pool —
# learned from a real API-key-leak incident.
cat >"$USER_HOME/.bashrc" <<'BASHRC'
# Skeletal .bashrc for AI agent runtime.
# Generated by agent-bootstrap. The operator may edit.
#
# IMPORTANT: do NOT add `export ANTHROPIC_API_KEY=...` or
# `export GOOGLE_API_KEY=...` here. Headless CLI calls will silently
# route to a metered API tier instead of the OAuth Max subscription
# pool (billing-leak guard — never let a co-located agent inherit another's API key).
[ -z "$PS1" ] && return
export PATH="$HOME/.local/bin:$PATH"
export ENGRAM_HOME="$HOME/.engram"          # explicit, no fallback
umask 027                                    # group-readable but not world
PS1='\[\e[1;33m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '
BASHRC
chown "$USER_NAME:$USER_NAME" "$USER_HOME/.bashrc"

# ---------- 3. ~/.runtime adapter (start.sh) ----------
# v0.1: claude only. Multi-runtime adapters (gemini-cli, codex) are
# forthcoming as a separate epic — see the v0.1 scope note in the file
# header. The top-level --runtime validation rejects non-claude values
# before this section runs.
mkdir -p "$USER_HOME/.runtime"
cat >"$USER_HOME/.runtime/start.sh" <<'RUN'
#!/bin/bash
# Adapter: invoke claude. All flags forwarded.
# env -u ANTHROPIC_API_KEY: defensive scrub in case API key leaked
# into env via operator-side inheritance (billing-leak guard).
exec env -u ANTHROPIC_API_KEY claude "$@"
RUN
chmod 0755 "$USER_HOME/.runtime/start.sh"

# ---------- 4. ~/.runtime/install.sh wrapper (chains to alpha) ----------
# Thin wrapper so the user inside the newborn shell can run a single
# command (`bash ~/.runtime/install.sh`) instead of memorising the alpha
# checkout location. The wrapper exec's alpha's install-local-marketplace.sh.
if [[ -n "$ALPHA_SOURCE" ]]; then
    cat >"$USER_HOME/.runtime/install.sh" <<INSTALL_WRAPPER
#!/bin/bash
# Wrapper: chain to engram-alpha's install-local-marketplace.sh.
# Substitute ALPHA_SOURCE by editing this file or via the env var.
ALPHA_SOURCE="\${ALPHA_SOURCE:-$ALPHA_SOURCE}"
if [[ ! -d "\$ALPHA_SOURCE" ]]; then
    echo "ERROR: alpha checkout not found at \$ALPHA_SOURCE" >&2
    echo "       Set ALPHA_SOURCE=/path/to/engram-alpha and re-run." >&2
    exit 1
fi
INSTALLER="tools/install-local-marketplace.sh"
[[ -f "\$ALPHA_SOURCE/\$INSTALLER" ]] || { echo "ERROR: installer not found at \$ALPHA_SOURCE/\$INSTALLER" >&2; exit 1; }
exec bash "\$ALPHA_SOURCE/\$INSTALLER" "\$@"
INSTALL_WRAPPER
    chmod 0755 "$USER_HOME/.runtime/install.sh"
fi

# ---------- 4.5. venv auto-activation in .bashrc ----------
# agent-bootstrap no longer creates a venv or runs pip: tools/install.sh (run below as the
# newborn) creates ~/.engram/venv. This block is kept because it is guarded by
# `[[ -f activate ]]` (inert until the venv exists) and makes the newborn's interactive
# shells use that venv.
cat >>"$USER_HOME/.bashrc" <<'VENV'

# Auto-activate ENGRAM venv (added by agent-bootstrap).
# The venv at ~/.engram/venv is created by tools/install.sh;
# system python3 is PEP-668-locked on modern Debian/Ubuntu.
if [[ -f "$HOME/.engram/venv/bin/activate" ]]; then
    . "$HOME/.engram/venv/bin/activate"
fi
VENV

# ---------- 5. ~/.local/bin & claude-remote (optional) ----------
mkdir -p "$USER_HOME/.local/bin"
_src=/home/agents-shared/bin/claude-remote
if [[ -f "$_src" ]]; then
    cp "$_src" "$USER_HOME/.local/bin/"
    chmod 0755 "$USER_HOME/.local/bin/claude-remote"
fi
unset _src

# ---------- 5.7. Operator ACL on ~/.engram (directory default) ----------
# The ENGRAM server creates config.json on first run (server.py bootstrap).
# Do NOT write a stub config here — pre-empting server.py's default_config
# write would cause it to skip initialisation, leaving a schema-incomplete
# file (regression observed in prior approach, issue #341).
#
# Instead, set a POSIX directory DEFAULT ACL on ~/.engram so every NEW file
# the server later creates (config.json, knowledge.db, etc.) automatically
# inherits operator rw — no group-membership hacks required.
#
# The operator is $SUDO_USER (the Linux username of the human who ran
# `sudo agent-bootstrap`).  primary_user in config.json is the agent's
# human-readable first name ("lei"), NOT the Linux username, so we cannot
# use it here.
#
# Guards:
#   • $SUDO_USER empty or "root" → skip silently (no non-root operator).
#   • setfacl not on PATH → warn clearly (acl package); do NOT fail bootstrap.
#   • Idempotent: setfacl with the same mask is a no-op on re-run.
#
# Optional re-bootstrap guard:
#   If config.json already exists (re-bootstrap on an existing install), also
#   apply a direct named-user ACL to that file — the directory default ACL
#   covers only newly-created files, so an existing file needs the direct grant.
ENGRAM_HOME="$USER_HOME/.engram"
mkdir -p "$ENGRAM_HOME"

OPERATOR="${SUDO_USER:-}"
if [[ "$OPERATOR" == "root" ]]; then
    OPERATOR=""
fi

if [[ -n "$OPERATOR" ]]; then
    if command -v setfacl >/dev/null 2>&1; then
        setfacl -d -m "u:${OPERATOR}:rw" "$ENGRAM_HOME"
        echo "  ACL set (default): u:${OPERATOR}:rw on $ENGRAM_HOME (new files inherit operator rw)"
        # Re-bootstrap guard: grant direct ACL on config.json if it already exists.
        CONFIG_JSON="$ENGRAM_HOME/config.json"
        if [[ -f "$CONFIG_JSON" ]]; then
            setfacl -m "u:${OPERATOR}:rw" "$CONFIG_JSON"
            echo "  ACL set (existing file): u:${OPERATOR}:rw on $CONFIG_JSON"
        fi
    else
        echo "  WARNING: setfacl not found — cannot grant $OPERATOR r/w ACL on $ENGRAM_HOME." >&2
        echo "           Install the 'acl' package (apt install acl) and re-run agent-bootstrap" >&2
        echo "           to enable operator viz-server access to per-agent configs." >&2
    fi
else
    echo "  ACL step skipped: SUDO_USER is empty or root (no non-root operator)."
fi

# ---------- 6. community shared dirs ----------
mkdir -p "$SHARED_ROOT/inter-agent"
mkdir -p "$SHARED_ROOT/health/$NAME"
mkdir -p "$SHARED_ROOT/audit"
chgrp -R agents "$SHARED_ROOT"
chmod 2775 "$SHARED_ROOT" "$SHARED_ROOT/inter-agent" "$SHARED_ROOT/audit"
chown "$USER_NAME:agents" "$SHARED_ROOT/health/$NAME"
chmod 0750 "$SHARED_ROOT/health/$NAME"

# ---------- 7. fix ownership of agent's home ----------
chown -R "$USER_NAME:$USER_NAME" "$USER_HOME"

# ---------- 8. run the public installer as the newborn ----------
# Last, after the home is owned by the newborn: clone + tag checkout + tools/install.sh.
# A failure leaves the user/home in place (named in the message) and is this script's exit code.
CLONE_TAG=""
if [[ "$NO_INSTALL" != "1" ]]; then
    ab_clone_and_install || exit $?
fi

# ---------- 9. friendly next-steps ----------
ab_print_next_steps
