# Package-protocol templates rendered by `cmd_init`.
_DUMP_SH_TEMPLATE = '''#!/usr/bin/env bash
# Dump the local knowledge.db to knowledge.sql for git-versioned commit.
# Author-side only — runs after authoring sessions, before `git commit knowledge.sql`.
# (Consumers do not need this script. They run scripts/build.sh after pull.)

set -euo pipefail

PKG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DB_FILE="$PKG_DIR/knowledge.db"
SQL_FILE="$PKG_DIR/knowledge.sql"

if [[ ! -f "$DB_FILE" ]]; then
    echo "ERROR: $DB_FILE not found. Run scripts/build.sh first (or seed it via engram-pkg)." >&2
    exit 1
fi

# WAL flush so .dump captures all committed writes from the live engram.
sqlite3 "$DB_FILE" "PRAGMA wal_checkpoint(TRUNCATE);" > /dev/null
sqlite3 "$DB_FILE" .dump > "$SQL_FILE"

NODE_COUNT=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM nodes;")
SQL_LINES=$(wc -l < "$SQL_FILE")
echo "Dumped $DB_FILE -> $SQL_FILE  ($NODE_COUNT nodes, $SQL_LINES lines)"
echo "Review diff with: git diff knowledge.sql"
'''

_BUILD_SH_TEMPLATE = '''#!/usr/bin/env bash
# Build the local knowledge.db from knowledge.sql.
# Run this once after `git clone` (and again whenever you `git pull` and the .sql changed).
#
# This is the consumer-side build — minimal, no toolkit dependency, just sqlite3.
# (Authoring uses the engram-pkg CLI from engram-alpha/tools/engram-pkg/.)

set -euo pipefail

PKG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SQL_FILE="$PKG_DIR/knowledge.sql"
DB_FILE="$PKG_DIR/knowledge.db"

if [[ ! -f "$SQL_FILE" ]]; then
    echo "ERROR: $SQL_FILE not found." >&2
    exit 1
fi

# Replace any existing local .db. The .sql is the source of truth; local .db
# is a build artifact and may be regenerated freely.
rm -f "$DB_FILE" "$DB_FILE-shm" "$DB_FILE-wal"
sqlite3 "$DB_FILE" < "$SQL_FILE"

NODE_COUNT=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM nodes;")
EDGE_COUNT=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM edges;")
echo "Built $DB_FILE  ($NODE_COUNT nodes, $EDGE_COUNT edges)"
'''

