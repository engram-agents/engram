#!/usr/bin/env python3
"""
engram-pkg — CLI toolkit for authoring engram-package databases.

Operates on any engram-package directory passed via --pkg or $ENGRAM_PKG.
Wraps the EngramClient (which redirects all server paths to the package
directory atomically) so you can author into the package without touching
your personal engram at ~/.engram/.

Usage:
    engram-pkg --pkg ~/engram-packages/wiki/ <subcommand> [args...]
    ENGRAM_PKG=~/engram-packages/wiki/ engram-pkg <subcommand> [args...]

Common subcommands:
    init               Bootstrap a new engram-package skeleton in an empty directory.
    add-evidence       Register a source document.
    add-observation    Extract a claim with provenance from a source.
    derive             Combine evidence into a derived claim.
    supersede          Replace an existing node with an updated version.
    list               List nodes in the package (compact triage).
    query              Search nodes by text + embedding.
    inspect            Inspect a single node + 1-hop neighbors.
    stats              Package statistics.
    dump               Run scripts/dump.sh — write knowledge.sql.
    build              Run scripts/build.sh — build knowledge.db from .sql.
    call               Generic escape hatch — invoke any engram_* tool by name with JSON args.

Why a CLI rather than MCP-tool duplication: parallel personal vs package
MCP tools share shape and selection signal; mid-flow it's easy to fire the
wrong one. The conscious shell command makes the namespace shift visible
and matches the tool surface other agents (e.g., Mneme) will use.
"""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent.parent  # engram-alpha/

# Canonical ENGRAM node types — kept here as a static list (mirrors the server's
# type vocabulary). Used as argparse `choices` for --node-type so a typo errors
# loudly with the valid list, instead of silently returning empty results.
# When server adds a new node type, add it here too.
NODE_TYPES = (
    "axiom",
    "conjecture",
    "contradiction",
    "cornerstone",
    "definition",
    "derivation",
    "evidence",
    "feeling_report",
    "goal",
    "goal_tension",
    "lesson",
    "observation_factual",
    "observation_predictive",
    "person",
    "prediction",
    "question",
    "task",
    "theory",
)


def resolve_pkg(args):
    pkg = args.pkg or os.environ.get("ENGRAM_PKG")
    if not pkg:
        sys.exit("ERROR: --pkg required (or set $ENGRAM_PKG). Point at an engram-package directory.")
    pkg_path = Path(pkg).expanduser().resolve()
    if not pkg_path.is_dir():
        sys.exit(f"ERROR: {pkg_path} is not a directory.")
    return pkg_path


# 5-second slack absorbs filesystem mtime jitter (touch-modify within the same
# second, build script mtime updates near-simultaneously, etc.). Anything past
# 5s of sql-newer-than-db is a real authoring gap.
_STALE_SLACK_SECS = 5


def _check_stale_build(pkg_path, auto_build=False):
    """Detect knowledge.sql newer than knowledge.db.

    Direction matters: db-newer-than-sql is the normal mid-authoring state
    (CLI write commands hit .db; `dump` catches .sql up). The reverse is the
    one that produces silent stale reads — typically after a fresh git pull
    or a hand-edit of knowledge.sql without `engram-pkg build`.
    """
    db = pkg_path / "knowledge.db"
    sql = pkg_path / "knowledge.sql"
    if not (db.exists() and sql.exists()):
        return
    if sql.stat().st_mtime <= db.stat().st_mtime + _STALE_SLACK_SECS:
        return
    if auto_build:
        script = pkg_path / "scripts" / "build.sh"
        if script.exists():
            sys.stderr.write(
                "NOTE: knowledge.sql newer than knowledge.db — auto-building...\n"
            )
            rc = subprocess.call(["bash", str(script)])
            if rc != 0:
                sys.exit(f"ERROR: auto-build failed (rc={rc}). Run `engram-pkg build` manually to see errors.")
        else:
            # Hard-exit instead of degrading to a stale read. The user
            # explicitly passed --auto-build because they did NOT want
            # to read stale data; warn-and-continue would silently
            # contradict that intent.
            sys.exit(
                f"ERROR: --auto-build requested but {script} not found. "
                f"Run `engram-pkg build` manually, or remove --auto-build "
                f"to fall back to warn-only mode."
            )
        return
    sys.stderr.write(
        f"WARNING: knowledge.sql is newer than knowledge.db — read commands "
        f"may return stale data. Run `engram-pkg build` to refresh, or pass "
        f"--auto-build to do it automatically.\n"
    )


def get_client(pkg_path):
    sys.path.insert(0, str(REPO_ROOT))
    from engram_client import EngramClient  # noqa: E402
    return EngramClient(db_dir=str(pkg_path), server_module_path=str(REPO_ROOT))


def report(result):
    """Pretty-print a tool result; exit non-zero on error."""
    if isinstance(result, dict) and "error" in result:
        sys.exit(f"ERROR: {result['error']}")
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


