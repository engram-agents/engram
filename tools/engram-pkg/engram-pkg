engram-pkg --pkg . query "your search"
engram-pkg --pkg . inspect <node_id>
```

## Authoring workflow

```bash
export ENGRAM_PKG=$(pwd)
engram-pkg add-observation --url ... --title ... --quoted-text ... ...
engram-pkg dump                      # knowledge.db -> knowledge.sql
git add knowledge.sql && git commit  # commit only versioned artifacts
```

The package follows the engram-package protocol — see the engram-pkg CLI README for the full contract.
'''


def cmd_init(args):
    """Bootstrap a fresh engram-package skeleton in an empty directory.

    Tolerates a pre-existing `.git` directory (so `mkdir my-pkg && cd my-pkg
    && git init && engram-pkg init .` works as a natural flow). All other
    pre-existing content blocks init to avoid clobbering author work.
    """
    pkg_path = Path(args.path).expanduser().resolve()
    if pkg_path.exists():
        # Filter out .git from the non-empty check — initializing inside an
        # already-`git init`-ed directory is a common author flow.
        existing = [p for p in pkg_path.iterdir() if p.name != ".git"]
        if existing:
            sys.exit(
                f"ERROR: {pkg_path} is not empty (found: "
                f"{', '.join(p.name for p in existing[:5])}"
                f"{'...' if len(existing) > 5 else ''}). "
                f"`engram-pkg init` refuses to overwrite existing files. "
                f"A pre-existing `.git/` is OK; anything else blocks init."
            )
    pkg_path.mkdir(parents=True, exist_ok=True)
    scripts_dir = pkg_path / "scripts"
    scripts_dir.mkdir(exist_ok=True)

    files_written = []

    dump_path = scripts_dir / "dump.sh"
    dump_path.write_text(_DUMP_SH_TEMPLATE)
    dump_path.chmod(0o755)
    files_written.append(("scripts/dump.sh", dump_path))

    build_path = scripts_dir / "build.sh"
    build_path.write_text(_BUILD_SH_TEMPLATE)
    build_path.chmod(0o755)
    files_written.append(("scripts/build.sh", build_path))

    gitignore_path = pkg_path / ".gitignore"
    gitignore_path.write_text(_GITIGNORE_TEMPLATE)
    files_written.append((".gitignore", gitignore_path))

    pkg_name = args.name or pkg_path.name
    readme_path = pkg_path / "README.md"
    readme_path.write_text(_README_TEMPLATE.format(pkg_name=pkg_name))
    files_written.append(("README.md", readme_path))

    # Bootstrap the schema by triggering the EngramClient once. This creates
    # knowledge.db with the full ENGRAM schema (otherwise build.sh against an
    # empty knowledge.sql produces a schema-less .db that can't be queried).
    # We call engram_stats as a no-op trigger; any read does the same job.
    client = get_client(pkg_path)
    client.call("engram_stats")

    # Now dump the schema (no nodes) to knowledge.sql so a fresh
    # `git clone && bash scripts/build.sh` produces a working .db.
    dump_script = pkg_path / "scripts" / "dump.sh"
    rc = subprocess.call(["bash", str(dump_script)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc != 0:
        sys.exit(f"ERROR: scripts/dump.sh failed during init (rc={rc}). The skeleton was created but knowledge.sql is empty.")
    files_written.append(("knowledge.sql", pkg_path / "knowledge.sql"))

    print(f"Initialized engram-package at {pkg_path}")
    for label, _ in files_written:
        print(f"  + {label}")
    print()
    print("Next steps:")
    print(f"  cd {pkg_path}")
    print(f"  git init && git add . && git commit -m 'init: engram-package skeleton'")
    print(f"  export ENGRAM_PKG={pkg_path}")
    print(f"  engram-pkg add-evidence --url ... --title ...")
    return 0


# Path prefixes that almost certainly indicate a machine-local URL, not
# something a different consumer can resolve. Order doesn't matter; any
# match triggers the warning.
_LOCAL_URL_INDICATORS = (
    "file:///home/", "file:///Users/", "file:///root/",
    "file:///tmp/", "file:///var/",
)


def _warn_if_local_url(url: str) -> None:
    """Emit a stderr warning when url looks machine-local (won't port to
    other consumers of the package). Non-blocking — the URL is still accepted.
    """
    if not url:
        return
    if not any(url.startswith(prefix) for prefix in _LOCAL_URL_INDICATORS):
        return
    sys.stderr.write(
        f"WARNING: URL '{url}' looks like a machine-local absolute path. "
        f"Other consumers of this package will not be able to resolve it. "
        f"Consider a stable URL instead: GitHub raw "
        f"(https://raw.githubusercontent.com/...), a project-relative path, "
        f"or arxiv/DOI for published sources.\n"
    )


def cmd_add_evidence(args):
    _warn_if_local_url(args.url)
    client = get_client(resolve_pkg(args))
    return report(client.call("engram_add_evidence", {
        "url": args.url, "title": args.title,
        "domain": args.domain or "", "source_date": args.source_date or "",
    }))


def cmd_add_observation(args):
    client = get_client(resolve_pkg(args))
    payload = {
        "quoted_text": args.quoted_text,
        "interpretation": args.interpretation,
        "claim": args.claim,
        "quote_type": args.quote_type,
    }
    if args.evidence_id:
        payload["evidence_id"] = args.evidence_id
    elif args.url:
        _warn_if_local_url(args.url)
        payload["url"] = args.url
        payload["title"] = args.title or ""
        if args.source_date:
            payload["source_date"] = args.source_date
    else:
        sys.exit("ERROR: provide --evidence-id OR --url --title.")
    if args.source_class:
        payload["source_class"] = args.source_class
    return report(client.call("engram_add_observation", payload))


def cmd_derive(args):
    client = get_client(resolve_pkg(args))
    return report(client.call("engram_derive", {
        "claim": args.claim,
        "supporting_ids": args.supporting_ids,
        "logical_chain": args.logical_chain,
        "reasoning_type": args.reasoning_type,
    }))


def cmd_supersede(args):
    """Wire two existing nodes via supersede relation.

    engram_supersede is RELATIONAL ONLY — it does not create the
    replacement node. Workflow:
      1. Create the new node via add-observation / derive / etc.
      2. engram-pkg supersede --old-node-id <old> --new-node-id <new>
         [--reason <short rationale>]
    """
    client = get_client(resolve_pkg(args))
    payload = {
        "old_node_id": args.old_node_id,
        "new_node_id": args.new_node_id,
    }
    if args.reason:
        payload["supersede_reason"] = args.reason
    return report(client.call("engram_supersede", payload))


def cmd_list(args):
    pkg_path = resolve_pkg(args)
    _check_stale_build(pkg_path, auto_build=args.auto_build)
    client = get_client(pkg_path)
    payload = {}
    if args.node_type:
        payload["node_type"] = args.node_type
    if args.limit:
        payload["limit"] = args.limit
    return report(client.call("engram_list", payload))


def cmd_query(args):
    pkg_path = resolve_pkg(args)
    _check_stale_build(pkg_path, auto_build=args.auto_build)
    client = get_client(pkg_path)
    return report(client.call("engram_query", {"query": args.query, "top_k": args.top_k}))


def cmd_inspect(args):
    pkg_path = resolve_pkg(args)
    _check_stale_build(pkg_path, auto_build=args.auto_build)
    client = get_client(pkg_path)
    return report(client.call("engram_inspect", {"node_id": args.node_id}))


def cmd_stats(args):
    pkg_path = resolve_pkg(args)
    _check_stale_build(pkg_path, auto_build=args.auto_build)
    client = get_client(pkg_path)
    return report(client.call("engram_stats"))


def cmd_dump(args):
    pkg_path = resolve_pkg(args)
    script = pkg_path / "scripts" / "dump.sh"
    if not script.exists():
        sys.exit(f"ERROR: {script} not found. (Is this an engram-package directory?)")
    return subprocess.call(["bash", str(script)])


def cmd_build(args):
    pkg_path = resolve_pkg(args)
    script = pkg_path / "scripts" / "build.sh"
    if not script.exists():
        sys.exit(f"ERROR: {script} not found. (Is this an engram-package directory?)")
    return subprocess.call(["bash", str(script)])


def cmd_call(args):
    """Generic escape hatch — invoke any engram_* tool with JSON-encoded args.

    Two input paths for the params dict:
      --json '<inline JSON>'         — quick one-liners; subject to shell quoting.
      --json-file <path>             — read JSON from a file; sidesteps shell
                                       quoting entirely (recommended for any
                                       payload with backticks, apostrophes,
                                       or multi-line prose).

    Mutually exclusive. If neither is provided, payload is empty (some tools
    accept no args, e.g. engram_reflect).
    """
    if args.json and args.json_file:
        sys.exit("ERROR: --json and --json-file are mutually exclusive.")

    if args.json_file:
        path = Path(args.json_file).expanduser()
        if not path.is_file():
            sys.exit(f"ERROR: --json-file {path} not found.")
        try:
            payload = json.loads(path.read_text())
        except json.JSONDecodeError as e:
            sys.exit(f"ERROR: --json-file {path} contains invalid JSON: {e}")
    elif args.json:
        try:
            payload = json.loads(args.json)
        except json.JSONDecodeError as e:
            sys.exit(f"ERROR: --json invalid: {e}")
    else:
        payload = {}

    if not isinstance(payload, dict):
        sys.exit(f"ERROR: payload must be a JSON object (dict), got {type(payload).__name__}.")

    client = get_client(resolve_pkg(args))
    return report(client.call(args.tool_name, payload))


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(prog="engram-pkg", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--pkg", help="Path to engram-package dir. Defaults to $ENGRAM_PKG.")
    p.add_argument(
        "--auto-build",
        action="store_true",
        help="If knowledge.sql is newer than knowledge.db (e.g., after `git pull`), "
             "auto-run scripts/build.sh before reading. Default: warn-only.",
    )
    sp = p.add_subparsers(dest="cmd", required=True)

    i = sp.add_parser("init", help="Bootstrap a new engram-package skeleton.")
    i.add_argument("path", help="Path to the package directory (will be created if missing; must be empty).")
    i.add_argument("--name", help="Package name for README header (defaults to directory basename).")
    i.set_defaults(func=cmd_init)

    e = sp.add_parser("add-evidence", help="Register a source document.")
    e.add_argument("--url", required=True)
    e.add_argument("--title", required=True)
    e.add_argument("--domain")
    e.add_argument("--source-date")
    e.set_defaults(func=cmd_add_evidence)

    o = sp.add_parser("add-observation", help="Extract a claim with provenance from a source.")
    o.add_argument("--quoted-text", required=True)
    o.add_argument("--interpretation", required=True)
    o.add_argument("--claim", required=True)
    o.add_argument("--quote-type", required=True,
                   choices=["hard_data", "official_statement", "attributed_analysis",
                            "unnamed_source", "editorial"])
    o.add_argument("--evidence-id", help="Use this OR --url+--title.")
    o.add_argument("--url")
    o.add_argument("--title")
    o.add_argument("--source-date")
    o.add_argument("--source-class", choices=["external", "introspective", "user_stated"])
    o.set_defaults(func=cmd_add_observation)

    d = sp.add_parser("derive", help="Combine evidence into a derived claim.")
    d.add_argument("--claim", required=True)
    d.add_argument("--supporting-ids", required=True, help="Comma-separated node IDs.")
    d.add_argument("--logical-chain", required=True)
    d.add_argument("--reasoning-type", required=True,
                   help="One of the engram_derive reasoning types.")
    d.set_defaults(func=cmd_derive)

    s = sp.add_parser(
        "supersede",
        help="Wire an existing replacement node as the successor of an old node (relational only).",
    )
    s.add_argument("--old-node-id", required=True, help="ID of the node being superseded.")
    s.add_argument(
        "--new-node-id",
        required=True,
        help="ID of the replacement node — must already exist (create via add-observation, derive, etc. first).",
    )
    s.add_argument("--reason", help="Optional short rationale for why this revision exists.")
    s.set_defaults(func=cmd_supersede)

    l = sp.add_parser("list", help="List nodes in compact triage format.")
    l.add_argument(
        "--node-type",
        choices=NODE_TYPES,
        help="Filter to a single node type. Without this flag, all types are listed. "
             "Typo-protected — argparse rejects unknown types with the valid list.",
    )
    l.add_argument("--limit", type=int)
    l.set_defaults(func=cmd_list)

    q = sp.add_parser("query", help="Search nodes by text + embedding.")
    q.add_argument("query", help="Search query.")
    q.add_argument("--top-k", type=int, default=10)
    q.set_defaults(func=cmd_query)

    i = sp.add_parser("inspect", help="Inspect a single node + 1-hop neighbors.")
    i.add_argument("node_id")
    i.set_defaults(func=cmd_inspect)

    sp.add_parser("stats", help="Package statistics.").set_defaults(func=cmd_stats)
    sp.add_parser("dump", help="Run scripts/dump.sh — write knowledge.sql.").set_defaults(func=cmd_dump)
    sp.add_parser("build", help="Run scripts/build.sh — build knowledge.db from .sql.").set_defaults(func=cmd_build)

    c = sp.add_parser("call", help="Generic escape hatch — invoke any engram_* tool by JSON.")
    c.add_argument("tool_name", help="Full tool name (e.g. engram_reflect).")
    c.add_argument("--json", help="JSON-encoded arguments dict (inline; subject to shell quoting).")
    c.add_argument("--json-file", help="Path to a JSON file containing the arguments dict (recommended for payloads with backticks, apostrophes, or multi-line prose).")
    c.set_defaults(func=cmd_call)

    return p


def main():
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main() or 0)
