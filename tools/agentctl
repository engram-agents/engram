#!/bin/bash
# =============================================================================
# agentctl — an operator's day-to-day admin tool for co-located AI agents
#
# DRAFT v0 — 2026-05-02. NOT YET INSTALLED.  Lives under active-work/ until
# The operator reviews.  After review move to ~/.local/bin/agentctl.
#
# Scope of v0:
#   health   session   bash
# Added v0.1 (broker — share/unshare/share-status):
#   share    unshare    share-status
# Added v0.3 (spawn flow — shared-host newborn lifecycle, v0.1 minimum):
#   spawn    finalize-name
#
# os-harness-check: linux-only  (bash 4.3+ namerefs/mapfile/case-mod are
#   intentional here and MUST NOT be "portability-fixed" — see the macOS note
#   directly below. The macOS path is tools/agentctl-mac, which IS scanned.)
#
# macOS: this tool assumes a Linux host with several agents (per-agent "agent-<name>"
# users, sudo user-switch, ACL sharing) and does not run there. For a Mac
# host running exactly one agent, see the sibling tools/agentctl-mac — a
# lightweight `session`-only wrapper that reuses this script's tested
# alias-expansion/platform-detection verbs (__expand-session-args,
# __detect-platform-as-self) without any of the multi-user machinery.
#
# Usage:
#   agentctl health                      # health table for all agents
#   agentctl session <agent> [--platform <claude|codex>] [--no-share] [--cd <dir>]
#                            [--as-self] [...]
#                                        # interactive session as agent. Claude executes
#                                        # directly; Codex uses the agent's managed
#                                        # app-server and one named tmux TUI.
#                                        # Platform auto-detected from baked profile
#                                        # or binary heuristic. --local is deprecated.
#                                        # --as-self: skip the sudo/user-switch
#                                        #   entirely — for use INSIDE a systemd
#                                        #   unit (or any shell) that is already
#                                        #   running as the target agent's own
#                                        #   Linux user (e.g. `User=agent-%i`,
#                                        #   where sudo is neither available nor
#                                        #   needed). Verifies `id -un` matches
#                                        #   the target user; loud error + exit 7
#                                        #   on mismatch. Forces --no-share (ACL
#                                        #   auto-share needs sudo).
#                                        # Single-dash flag grammar (alias namespace):
#                                        #   -xyz  is a BUNDLE of single-char aliases,
#                                        #         expanded in char order: -x -y -z.
#                                        #   Any unrecognized char → loud error, exit 6.
#                                        #   No single-dash arg ever passes through raw.
#                                        #   Bare - (stdin) passes as a non-flag arg.
#                                        # Recognized aliases:
#                                        #   -c  claude:--continue  codex:resume managed daemon's latest thread
#                                        #       (Codex resume cannot combine with -d/bypass permissions)
#                                        #   -d  claude:--dangerously-skip-permissions
#                                        #       codex:--dangerously-bypass-approvals-and-sandbox
#                                        #   -r  claude:--remote-control <agent>
#                                        #       codex: silently ignored (remote control unavailable)
#                                        # Double-dash flags and non-flag args pass through verbatim.
#   agentctl attach <agent> [-r]         # attach your terminal to the agent's sole
#                                        # tmux session (agent-<name>). Codex's TUI
#                                        # there is connected to its managed daemon.
#                                        # Detach: Ctrl-b d. -r = read-only observe.
#   agentctl bash <agent>                # plain bash shell as agent (no CLI)
#   sudo agentctl share <agent> <path> [--mode rw|ro] [--ttl <duration>]
#                                        # grant agent ACL access to operator-side path;
#                                        # parent dirs get --x traversal, target gets
#                                        # rwX (or rX for --mode ro), default ACL on
#                                        # dirs so new files inherit. Audited.
#   sudo agentctl unshare <agent> <path> # revoke share (recursive ACL removal)
#   agentctl share-status [<agent>]      # list active shares
#   sudo agentctl spawn [--runtime claude]  (v0.1: claude only)
#                       [--alpha-source PATH] [--bootstrap-path PATH]
#                       [--forum-url URL]
#                                        # birth a newborn-tagged agent
#                                        # (agent-newborn-YYYYMMDDhhmmss)
#                                        # via /usr/local/sbin/agent-bootstrap.
#                                        # Prints next-step instructions.
#                                        # --forum-url leaves a one-line hint
#                                        # (~/.engram/forum-url.hint) that the
#                                        # first-session offers as the default
#                                        # answer to its forum question.
#                                        # Multi-runtime (gemini-cli, codex) is
#                                        # forthcoming as a separate epic.
#   sudo agentctl finalize-name <newborn-id> <chosen>
#                                        # single-shot rename a newborn-tagged
#                                        # agent to its chosen name. Refuses
#                                        # anything not matching agent-newborn-*
#                                        # (this is first-session-only, NOT a
#                                        # general rename — names are immutable
#                                        # post-finalize — names are immutable).
#   agentctl oom-status [<seat> ...]     # read-only: print the OOM protection the
#                                        # unit ASKED for and the oom_score_adj each
#                                        # live process actually READS. No seat ->
#                                        # every seat. Exit 0 OK, 1 a problem
#                                        # (ACCEPTED-NOT-APPLIED / UNPROTECTED),
#                                        # 2 usage error (unknown seat) or a seat
#                                        # that could not be reported, 3 UNKNOWN
#                                        # (could not tell). Across several seats
#                                        # a definite problem outranks an unknown.
#
# Exit codes of the four root verbs (spawn, finalize-name, share, unshare):
#   Exit 8  the action HAPPENED but its audit-log line (or, for unshare, its state
#           record) could not be written. Do not repeat the action: look at the state
#           directory, then record the line by hand. No other exit in this file uses 8.
#           Every refusal BEFORE the action (the state-directory gate, a bad argument,
#           a failed read-back) is a different code: 1 for a failed gate, 2 for a usage
#           error, 3 for a missing VIZ_OPERATOR (spawn, finalize-name). Exit 3 is NOT
#           "the action happened".
#   share --ttl needs 'at', a running atd (where systemctl exists) and a time of the form
#           <number><unit>, unit minutes|hours|days|weeks (2hours, 3days; not 2h). The
#           removal job is queued FIRST; if it cannot be, nothing is granted. A swapped-in
#           link at the shared path itself is refused by a read-back; a link swapped in at
#           a parent directory is not closed.
# =============================================================================

set -euo pipefail

SHARED_ROOT="/home/agents-shared"

# Root-only state (engram-alpha#4405): the audit log and the share state live here,
# never under $SHARED_ROOT, which every agent account can write. A LITERAL, not
# `${AGENTCTL_STATE:-...}` and not read from the environment or a config file:
# a value root honours from the environment is the same hole. Holds `share-log`
# and `share-state/<agent>.json`. Tests rewrite the literal in a COPY of this file.
readonly AGENTCTL_STATE="/var/lib/agentctl"

# Exit code of spawn, finalize-name, share and unshare when the action HAPPENED and its
# audit-log write failed (a refusal before the action is never this code). A value no
# other `exit` in this file uses: 3 is _require_viz_operator's refusal, which comes BEFORE
# any action (a static cell pins that no literal exit carries this value). Stated in the
# help header and in audit()'s error text (engram-alpha#4405 follow-up).
readonly EXIT_ACTION_UNLOGGED=8

# The tool a queued `at` job runs, a LITERAL for the same reason: `$0` is whatever path
# the operator typed (a relative or agent-writable one runs later, as root, from
# wherever `at` lands). The operator installs agentctl here (root:root, 0755). Tests
# rewrite the literal in a COPY of this file (engram-alpha#4409).
readonly AGENTCTL_TOOL="/usr/local/bin/agentctl"

# Viz/operator account that needs read access to agent ~/.engram dirs for the
# viz dashboard (knowledge.db dropdown) and write access to config.json for
# the viz config tab.
#
# NO DEFAULT (engram-alpha#2720, Lei's ruling): a hardcoded local account name
# ("spt") in shipped code was a functional leak of one host's personal setting
# into every other install. Every install must set this explicitly:
#   - persistently: put `VIZ_OPERATOR=<name>` in $AGENTCTL_CONFIG (parsed
#     below if present — plain KEY=VALUE lines, one per line; see the
#     security note on _read_viz_operator_from_config below for why this
#     file is PARSED, never sourced);
#   - one-off: VIZ_OPERATOR=<name> sudo agentctl <subcommand> ...
# cmd_finalize_name is the command that actually consumes VIZ_OPERATOR (its
# Step 7 grants the operator an ACL on the newborn's ~/.engram*). cmd_spawn
# does NOT read VIZ_OPERATOR itself -- its own operator-facing step is an
# unrelated `chgrp agents` for shared-group traversal -- but it preflights
# anyway (per Lei's ruling) so a newborn is never created without a viable
# path to being finalized later. Both (and the fleet-repair tool,
# tools/grant_viz_operator_acl.py) refuse loudly via _require_viz_operator
# when this is empty, before any useradd/usermod/setfacl mutation. Every
# other subcommand (health, session, attach, bash, share, ...) does not
# consume VIZ_OPERATOR and keeps working regardless of whether it's set.
AGENTCTL_CONFIG="$SHARED_ROOT/agentctl.conf"

# _read_viz_operator_from_config: restricted, NON-EXECUTING read of a
# `VIZ_OPERATOR=<value>` line from $AGENTCTL_CONFIG.
#
# $SHARED_ROOT ("/home/agents-shared") is mode 2775 (setgid, NOT sticky; a sticky
# shared root is not part of #4405 and needs a survey), group "agents" --
# writable by every agent account on the fleet, NOT root-only. This file
# must therefore never be `source`d (full shell evaluation of arbitrary
# syntax): any unprivileged agent account could plant
# `/home/agents-shared/agentctl.conf` with a command in it, which would then
# execute with the privilege of whoever next runs agentctl with
# VIZ_OPERATOR unset -- including root, since agentctl is frequently run via
# sudo. This is an unauthenticated root-code-execution vector, live-
# demonstrated by a reviewer-fairy against the prior `source`-based
# implementation on engram-alpha#2734/PR #2734.
#
# Only plain KEY=VALUE line parsing is performed here -- no `source`, no
# `eval`, no variable expansion, no command substitution: whatever text
# follows `VIZ_OPERATOR=` on the first matching line is taken as a literal
# string, nothing more. Mirrors
# src/engram/tools/grant_viz_operator_acl.py's
# `_read_viz_operator_from_config` (same file, same contract) so both
# consumers of $AGENTCTL_CONFIG agree on what's a legal line: blank lines
# and `#`-prefixed comments are skipped, and a single layer of matching
# single/double quotes around the value is stripped. Prints the value of
# the FIRST matching VIZ_OPERATOR= line (nothing printed if the file has no
# such line, or if the matched value is empty after stripping); always
# returns 0 -- callers decide what an empty result means (here: fall
# through to _require_viz_operator's "unset" refusal).
#
# Usage: _read_viz_operator_from_config <config_path>
_read_viz_operator_from_config() {
    local config_path="$1"
    local line key value first last
    [[ -f "$config_path" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" == \#* ]] && continue
        [[ "$line" != *"="* ]] && continue
        key="${line%%=*}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ "$key" != "VIZ_OPERATOR" ]] && continue
        value="${line#*=}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if [[ ${#value} -ge 2 ]]; then
            first="${value:0:1}"
            last="${value: -1}"
            if [[ "$first" == "$last" && ( "$first" == '"' || "$first" == "'" ) ]]; then
                value="${value:1:-1}"
            fi
        fi
        [[ -n "$value" ]] && printf '%s\n' "$value"
        return 0
    done < "$config_path"
    return 0
}

# _viz_operator_conf_provenance_ok: PURE ownership/permission check over an
# EXPLICIT (uid, mode) pair -- not over any real file. Returns 0 (ok) iff
# uid == 0 (root-owned) AND mode grants no group or other write bit
# (mode & 0022 == 0).
#
# engram-alpha#2720/PR #2734, colleague-review residual gap: parsing
# $AGENTCTL_CONFIG as plain KEY=VALUE (not `source`) closed the
# code-execution vector above, but VIZ_OPERATOR's VALUE was still trusted
# as AUTHORIZATION (it becomes the setfacl ACL grantee) with no check on
# who controls the file it came from. $SHARED_ROOT is group-writable by
# every agent account, so any agent could still plant this file and choose
# who gets ACL read access to every seat's health snapshots.
#
# Deliberately does NOT use a bash file-test operator like `[ -O "$file" ]`
# (or, in the Python fleet-repair tool, `os.stat().st_uid == os.getuid()`):
# agentctl itself typically runs as root (via sudo), so either check would
# be trivially satisfied by the CALLER's identity, not the file's actual
# owner -- an attacker-planted file passes right through. Comparing against
# uid 0 explicitly, rather than the caller's own uid, is the fix. This
# mirrors the OpenSSH StrictModes pattern (refuse a config/key file that
# isn't owned by the expected principal and isn't group/other-writable).
#
# Usage: _viz_operator_conf_provenance_ok <uid> <octal_mode>
_viz_operator_conf_provenance_ok() {
    local uid="$1" mode="$2"
    [[ "$uid" =~ ^[0-9]+$ ]] || return 1
    [[ "$mode" =~ ^[0-7]+$ ]] || return 1
    (( uid == 0 )) || return 1
    (( (8#$mode) & 8#022 )) && return 1
    return 0
}

# _viz_operator_config_value_if_provenance_ok: the provenance DECISION + read,
# taking the file's uid/mode as EXPLICIT arguments rather than stat-ing the
# file itself. Separating this from the real stat call is what lets the test
# suite exercise "a root-owned, non-writable-shaped config's value is
# correctly read through" and "a root-owned-but-group-writable config is
# rejected" without needing to literally chown a test fixture to root
# (impossible in an unprivileged test sandbox) -- mirrors this repo's
# established pure/side-effecting split (e.g.
# grant_viz_operator_acl.py's plan_for_seat/apply_seat_plan).
#
# On provenance failure: emits a specific WARNING to stderr naming exactly
# why the file was rejected (distinct from "file doesn't exist", which is
# silent -- see _resolve_viz_operator_from_config below) and prints nothing
# on stdout. On provenance success: delegates to _read_viz_operator_from_config
# for the actual value extraction. Always returns 0 -- callers decide what an
# empty result means (fall through to _require_viz_operator's "unset"
# refusal).
#
# Usage: _viz_operator_config_value_if_provenance_ok <config_path> <uid> <mode>
_viz_operator_config_value_if_provenance_ok() {
    local config_path="$1" uid="$2" mode="$3"
    if _viz_operator_conf_provenance_ok "$uid" "$mode"; then
        _read_viz_operator_from_config "$config_path"
    else
        echo "WARNING: $config_path exists but failed its ownership/permission check." >&2
        echo "         It must be owned by root (uid 0) and not writable by group or" >&2
        echo "         other -- otherwise any agent account on this shared-writable" >&2
        echo "         host could plant it and choose who gets ACL read access to" >&2
        echo "         every seat's ENGRAM data (VIZ_OPERATOR's value is trusted as" >&2
        echo "         AUTHORIZATION, not just as text)." >&2
        echo "         Refusing to trust its contents for this invocation; treating" >&2
        echo "         VIZ_OPERATOR as if the file were absent." >&2
        echo "         Fix: sudo chown root:root $config_path && sudo chmod go-w $config_path" >&2
    fi
    return 0
}

# _resolve_viz_operator_from_config: the real top-level entry point -- stats
# the actual file and delegates the accept/reject decision to the function
# above. Prints the resolved value (or nothing) on stdout. Prints NOTHING
# (not even a warning) when the file doesn't exist at all, or when its
# metadata can't be read -- that is the plain "unset" case, deliberately
# distinct from "exists but rejected" (which warns, via the function above).
# Always returns 0.
#
# Usage: _resolve_viz_operator_from_config <config_path>
_resolve_viz_operator_from_config() {
    local config_path="$1"
    [[ -f "$config_path" ]] || return 0
    local stat_out uid mode
    stat_out="$(stat -c '%u %a' "$config_path" 2>/dev/null)" || return 0
    read -r uid mode <<< "$stat_out"
    _viz_operator_config_value_if_provenance_ok "$config_path" "$uid" "$mode"
}

if [[ -z "${VIZ_OPERATOR:-}" && -f "$AGENTCTL_CONFIG" ]]; then
    VIZ_OPERATOR="$(_resolve_viz_operator_from_config "$AGENTCTL_CONFIG")"
fi
VIZ_OPERATOR="${VIZ_OPERATOR:-}"
SUBCMD="${1:-help}"
[[ $# -gt 0 ]] && shift

# _require_viz_operator: preflight gate for VIZ_OPERATOR-consuming commands.
# Refuses loudly, before any useradd/usermod/setfacl mutation, when
# VIZ_OPERATOR is unset or empty — no default (engram-alpha#2720: "remove
# that spt default, fail loud if that parameter is missing, and guide user
# set it"). Names the variable, explains its purpose, and shows both the
# persistent (config file) and one-off (env var) fix. Does NOT gate
# unrelated subcommands — only cmd_finalize_name (which actually consumes
# VIZ_OPERATOR) and cmd_spawn (which preflights it early so a newborn is
# never created without a viable finalize-name path) invoke this.
#
# Usage: _require_viz_operator <calling-subcommand-name>
_require_viz_operator() {
    local caller="$1"
    [[ -n "${VIZ_OPERATOR:-}" ]] && return 0
    echo "ERROR: VIZ_OPERATOR is not set." >&2
    echo "       VIZ_OPERATOR names the human operator account that runs the" >&2
    echo "       viz dashboard and needs read-only access to every seat's" >&2
    echo "       ENGRAM data (health snapshots, knowledge.db) plus read-write" >&2
    echo "       on each seat's config.json. '$caller' will not proceed" >&2
    echo "       without it — there is no default." >&2
    echo "" >&2
    echo "       Set it persistently for this host:" >&2
    echo "         echo 'VIZ_OPERATOR=<operator-username>' | sudo tee -a $AGENTCTL_CONFIG" >&2
    echo "" >&2
    echo "       Or set it for a single invocation:" >&2
    echo "         VIZ_OPERATOR=<operator-username> sudo $0 $caller ..." >&2
    exit 3
}

# _viz_operator_charset_ok: charset gate for VIZ_OPERATOR immediately before
# it is embedded in a setfacl ACL-entry string (e.g. "u:${VIZ_OPERATOR}:rX").
# setfacl parses its entry-list argument as COMMA-separated ACL entries, so
# an unvalidated value containing a comma could inject an additional,
# unintended ACL entry -- e.g. VIZ_OPERATOR="spt,u:evil:rwx" would grant
# "evil" rwx too, not merely fail to match "spt" (engram-alpha#2734
# suggestion 2). Mirrors the POSIX-username charset check already enforced
# in hooks/claude/engram-session-start-hook.py's _apply_pending_viz_acl
# (identical regex, same purpose, a different consumer of the same
# VIZ_OPERATOR value) so all three consumers agree on what's a legal
# operator name.
#
# Usage: _viz_operator_charset_ok <value>   (returns 0 = ok, 1 = invalid)
_viz_operator_charset_ok() {
    [[ "$1" =~ ^[a-z_][a-z0-9_-]*$ ]]
}

# ---------- helpers ----------
list_agents() {
    # Returns names (without "agent-" prefix) of all users in the agents group.
    getent group agents 2>/dev/null \
        | awk -F: '{print $4}' \
        | tr ',' '\n' \
        | grep -E '^agent-' \
        | sed 's/^agent-//' \
        | sort
}

resolve_user() {
    local name="$1"
    local user="agent-$name"
    if ! id "$user" >/dev/null 2>&1; then
        echo "ERROR: agent '$name' not found (no Linux user '$user')" >&2
        exit 1
    fi
    echo "$user"
}

# _normalize_chosen_name: shared helper for chosen-name normalization + validation.
# Lowercases the input, re-validates ^[a-z][a-z0-9_-]*$, emits Note on stdout if
# the name was changed, and returns 1 (calling exit 1) on validation failure.
#
# Usage: _normalize_chosen_name <varname> <chosen_input>
#   <varname>      name of the caller's variable to update with the normalized name
#   <chosen_input> the raw user-supplied chosen name
#
# On success: sets <varname> in caller's scope to the lowercased name; prints a
#   Note line to stdout if the input was case-normalized (no output if unchanged).
# On failure: prints the error block to stderr and calls exit 1.
#
# Both cmd_finalize_name and cmd__validate_chosen_name call this helper so the
# test suite (via __validate-chosen-name) exercises the same code path as the
# production rename.
_normalize_chosen_name() {
    local -n _ncn_ref="$1"   # nameref to caller's variable (bash 4.3+)
    local _ncn_input="$2"
    local _ncn_lower="${_ncn_input,,}"   # bash lowercase (uses _ prefix to avoid shadowing caller vars)

    if [[ ! "$_ncn_lower" =~ ^[a-z][a-z0-9_-]*$ ]]; then
        echo "ERROR: cannot derive a valid Linux username from '$_ncn_input'." >&2
        echo "       The Linux username (agent-<name>) must be lowercase letters, digits," >&2
        echo "       underscore, or hyphen, and start with a letter." >&2
        echo "       This is separate from your identity name — pick a name that yields" >&2
        echo "       a valid username, or pass an explicit lowercase username." >&2
        exit 1
    fi

    if [[ "$_ncn_input" != "$_ncn_lower" ]]; then
        echo "Note: Linux username will be 'agent-$_ncn_lower' (POSIX usernames are lowercase). Your identity name '$_ncn_input' is set in ENGRAM and is unaffected by this."
    fi

    _ncn_ref="$_ncn_lower"
}

# ---------- subcommands ----------
cmd_health() {
    printf '%-12s %-7s %-22s %-10s\n' AGENT UID LAST_SLEEP HEALTHFILE
    printf '%-12s %-7s %-22s %-10s\n' '-----' '---' '----------' '----------'
    while read -r name; do
        [[ -z "$name" ]] && continue
        local user="agent-$name"
        local uid
        uid=$(id -u "$user" 2>/dev/null || echo "?")
        local hf="$SHARED_ROOT/health/$name/last-sleep.json"
        local last_sleep="(none)"
        if [[ -r "$hf" ]]; then
            last_sleep=$(python3 -c "
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    print(d.get('completed_at',d.get('timestamp','?')))
except Exception as e:
    print(f'(parse-err: {e})')
" "$hf" 2>/dev/null) || last_sleep="(unreadable)"
        fi
        printf '%-12s %-7s %-22s %-10s\n' "$name" "$uid" "$last_sleep" "$([ -r "$hf" ] && echo OK || echo MISSING)"
    done < <(list_agents)
}

# ---------- oom-status ----------
# Read-only report of OOM protection for one or more agent seats.
#
# Why this exists (engram-alpha#4436): systemd ACCEPTING an OOMScoreAdjust
# property is not evidence that it took effect. An unprivileged
# `systemd-run --user -p OOMScoreAdjust=-200` accepts the property, runs the
# process at 100, and still reports `result success`. The only thing that
# settles "what took effect" is /proc/<pid>/oom_score_adj read inside the live
# process, so this verb prints the requested value and the effective value side
# by side and never infers one from the other.
#
# Process ENUMERATION is by USER, never by cgroup: a seat's processes live in
# the unit's cgroup after a boot start, in a login session scope after a human
# relaunch, or in a tmux-spawn scope on some paths. Selecting by cgroup is what
# makes a healthy seat report "no processes found". The VERDICT, however, is
# computed over SESSION processes only: the uid also owns unrelated services
# (engramd-owner, dbus) whose oom_score_adj the seat's drop-in can never make
# negative, so counting them made OK unreachable. A process is SESSION iff its
# cgroup equals the unit's ControlGroup, or it is a .scope under the seat's own
# user slice (user-<uid>.slice/...), except the user manager's own init.scope
# and a default-named `systemd-run --user --scope` transient (run-<hex>.scope).
# Everything else is CONTEXT: printed, never counted.
#
# Exit codes ARE the verdict: 0 OK, 1 a problem (OUTSIDE-UNIT,
# ACCEPTED-NOT-APPLIED or UNPROTECTED), 2 a usage error (unknown seat) or a seat
# that could not be reported, 3 UNKNOWN. UNKNOWN has its own code so a script
# cannot collapse "could not tell" into "fine". Across several seats a DEFINITE
# outcome outranks a softer one (1 > 2 > 3 > 0, see the roll-up comment in
# cmd_oom_status).

# How many process rows one seat prints. The verdict is computed over every
# SESSION process found (context processes never enter it); when rows are
# omitted the report says how many, so a truncated display never reads as the
# whole population.
readonly OOM_STATUS_DISPLAY_CAP=50

# The process tree to inspect. A test seam only: defaults to the real /proc and
# is set by nothing outside the test suite.
_oom_proc_root() {
    printf '%s' "${AGENTCTL_OOM_PROC_ROOT:-/proc}"
}

# Print one file's contents; return 1 if it cannot be read. Callers put this in
# an `if`, so `set -e` never aborts the report when a pid vanishes mid-scan.
_oom_read_file() {
    local f="$1"
    [[ -r "$f" ]] || return 1
    cat "$f" 2>/dev/null || return 1
}

# Last two components of a cgroup line ("0::/system.slice/x.service" ->
# "system.slice/x.service"): narrow enough for the table, while keeping the
# part that says who started the process.
_oom_cgroup_short() {
    local cg="${1#0::}"
    cg="${cg%/}"
    local last="${cg##*/}"
    local head="${cg%/*}"
    if [[ -n "$last" && "$head" != "$cg" && -n "${head##*/}" ]]; then
        last="${head##*/}/$last"
    fi
    printf '%s' "$last"
}

# The unified cgroup path a process lives in ("0::/system.slice/x.service" ->
# "/system.slice/x.service"). Returns 1 when the file holds no unified line:
# without one the process cannot be placed, and the verdict says UNKNOWN
# rather than guessing.
_oom_cgroup_path() {
    local line
    while IFS= read -r line; do
        [[ "$line" == 0::* ]] || continue
        printf '%s' "${line#0::}"
        return 0
    done <<< "$1"
    return 1
}

# True when a cgroup path is a transient .scope anywhere under the seat's own
# user slice (user-<uid>.slice/...). Both launch paths the verb exists for are
# covered: a tmux-spawn scope nested under user@<uid>.service
# (user@<uid>.service/app.slice/app-tmux.slice/tmux-spawn-*.scope) and a logind
# login-session scope directly under the user slice
# (user-<uid>.slice/session-N.scope). Each seat has its own uid, hence its own
# slice, so the uid-bounded match cannot leak across seats.
#
# The `.scope`-versus-`.service` split is the rule, not a detail: systemd names
# an EXTERNALLY-CREATED process group `.scope` (tmux-spawn, login session,
# systemd-run), while `.service` names a MANAGED daemon (engramd-owner,
# dbus) that the seat does not run as part of its session. Counting the
# daemons is what made OK unreachable and every seat read
# ACCEPTED-NOT-APPLIED (#4436).
_oom_is_session_scope() {
    local path="$1" uid="$2" name
    [[ "$path" == *.scope ]] || return 1
    [[ "$path" == *"/user-${uid}.slice/"* ]] || return 1
    name="${path##*/}"
    # init.scope IS the user manager itself, not a transient process group
    # created for the seat: a drop-in on the seat unit cannot reach it, and
    # counting it made every seat read OUTSIDE-UNIT on a real host (measured on
    # uid 1008: user@1008.service/init.scope at oom_score_adj 100, holding
    # systemd and sd-pam). Measured, not assumed.
    [[ "$name" != "init.scope" ]] || return 1
    # A `systemd-run --user --scope` one-shot is not the seat's session either.
    # systemd's default transient name is run-<32 hex>.scope, under
    # user@<uid>.service/app.slice/ where the widened rule would otherwise call
    # it SESSION and flip a protected seat to OUTSIDE-UNIT. Measured on uid
    # 1008: `systemd-run --user --scope --quiet sleep 3` produced
    #   /sys/fs/cgroup/user.slice/user-1008.slice/user@1008.service/app.slice/
    #     run-r30af8eafd81248d5a8731c3db2d1e815.scope
    #
    # Stated bound: a transient started with an explicit --unit=<name> becomes
    # <name>.scope, which this exclusion does NOT catch; it will still count as
    # session. Excluding arbitrary names as well would be worse than this
    # stated hole.
    [[ "$name" != run-* ]]
}

# MemoryMax is finite when systemd reports an integer; its unset value is the
# literal string "infinity".
_oom_memory_is_finite() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

# True when a validated decimal score string ("-200", "0", "09") is negative.
# LEXICAL on purpose: `(( 09 >= 0 ))` parses 09 as invalid octal and errors, so
# no externally supplied number ever goes through $(( )) in this verb.
_oom_is_negative() {
    [[ "$1" == -* && "$1" != "-0" ]]
}

# State letter from /proc/<pid>/stat ("R", "S", "Z", ...). Returns 1 when the
# file cannot be read (the process vanished mid-scan). The comm field is
# parenthesised and may itself contain ") ", so strip through the LAST ") ".
_oom_proc_state() {
    local line
    line=$(_oom_read_file "$1/stat") || return 1
    local rest="${line##*) }"
    printf '%s' "${rest%% *}"
}

# Print the seat names for oom-status and return 0 when the group LOOKUP
# succeeded, 1 when it failed (getent absent, or the group cannot be read).
# An existing group with no agent-* members is SUCCESS with no output: that is
# an empty universe, not an unknown one. list_agents itself is untouched and
# still serves the other verbs; this wrapper exists only to keep the status,
# which list_agents' pipeline discards.
_oom_known_seats() {
    local group_line
    if ! group_line=$(getent group agents 2>/dev/null); then
        return 1
    fi
    printf '%s\n' "$group_line" \
        | awk -F: '{print $4}' \
        | tr ',' '\n' \
        | grep -E '^agent-' \
        | sed 's/^agent-//' \
        | sort || true
    return 0
}

# Usage: _oom_seat_report <seat>
# Prints the seat block and returns the verdict's exit code (0, 1 or 3; 2 for
# a seat whose Linux user has vanished since validation).
_oom_seat_report() {
    local seat="$1"
    local user="agent-$seat"
    local unit="agent-session@${seat}.service"

    local uid
    uid=$(id -u "$user" 2>/dev/null) || {
        echo "ERROR: agent seat '$seat' has no Linux user '$user'" >&2
        return 2
    }

    # --- requested (the unit property) and the memory bound ---
    local load="unknown" active="unknown" req="" mmax="" unit_cg=""
    local facts_ok=0
    local systemctl_out=""
    if systemctl_out=$(systemctl show "$unit" \
            -p LoadState -p ActiveState -p OOMScoreAdjust -p MemoryMax \
            -p ControlGroup 2>/dev/null); then
        facts_ok=1
        local key value
        while IFS='=' read -r key value; do
            case "$key" in
                LoadState)      load="$value" ;;
                ActiveState)    active="$value" ;;
                OOMScoreAdjust) req="$value" ;;
                MemoryMax)      mmax="$value" ;;
                ControlGroup)   unit_cg="$value" ;;
            esac
        done <<< "$systemctl_out"
    fi

    printf '=== %s (%s, uid %s) ===\n' "$seat" "$user" "$uid"

    if (( facts_ok == 0 )); then
        printf 'requested: %s  [%s]\n' "unavailable" "systemctl query failed"
        printf 'memory:    %s  [%s]\n' "unavailable" "systemctl query failed"
    else
        local req_display req_note
        if [[ "$load" == "not-found" ]]; then
            req_display="n/a"
            req_note="unit not found"
        elif [[ "$active" == "inactive" ]]; then
            # A template instance systemd has never started still answers with
            # the property's default; that default is not a configured policy.
            req_display="$req"
            req_note="unit inactive: property default, not a running policy"
        else
            req_display="$req"
            req_note="unit $active"
        fi
        printf 'requested: %s  [%s]\n' "$req_display" "$req_note"
        if _oom_memory_is_finite "$mmax"; then
            printf 'memory:    MemoryMax=%s  [bounded]\n' "$mmax"
        else
            printf 'memory:    MemoryMax=%s  [no bound]\n' "$mmax"
        fi
    fi
    # Printed ALWAYS: the placement question ("would this drop-in reach the
    # seat's processes?") must be answerable from this report alone.
    if (( facts_ok == 0 )); then
        printf 'unit cgroup: unknown  [systemctl query failed]\n'
    elif [[ -n "$unit_cg" ]]; then
        printf 'unit cgroup: %s\n' "$unit_cg"
    else
        printf 'unit cgroup: (not reported by systemd)\n'
    fi

    # --- effective (live processes, selected by user, never by cgroup) ---
    local root
    root="$(_oom_proc_root)"
    local -a pids=()
    local pid_count=0
    local d owner pid
    for d in "$root"/[0-9]*; do
        [[ -d "$d" ]] || continue
        owner=$(stat -c %u "$d" 2>/dev/null) || continue
        [[ "$owner" == "$uid" ]] || continue
        pid="${d##*/}"
        pids+=("$pid")
        pid_count=$((pid_count + 1))
    done
    if (( pid_count > 1 )); then
        local sorted
        sorted=$(printf '%s\n' "${pids[@]}" | sort -n)
        pids=()
        pid_count=0
        while IFS= read -r pid; do
            [[ -n "$pid" ]] || continue
            pids+=("$pid")
            pid_count=$((pid_count + 1))
        done <<< "$sorted"
    fi

    printf '%-8s %-16s %-14s %s\n' 'PID' 'COMM' 'OOM_SCORE_ADJ' 'CGROUP'
    printf '%-8s %-16s %-14s %s\n' '--------' '----------------' '-------------' '------'

    local total=0 shown=0 unknown_proc=0 unknown_pid=""
    local session_total=0 session_outside=0 context_total=0 cgroup_unknown=0
    local any_session_nonneg=0
    local -a session_cgs=()
    local comm cg_raw cg_path cg_short score score_display pstate role
    local seen_cg cg_seen
    for pid in "${pids[@]+"${pids[@]}"}"; do
        # A zombie (Z) or dead (X) process has no memory and cannot be
        # OOM-killed: it is not part of the protection surface. Its
        # oom_score_adj still reads 0, so counting it would flip a fully
        # protected seat to ACCEPTED-NOT-APPLIED. Skip it the same way a
        # vanished process is skipped below.
        if pstate=$(_oom_proc_state "$root/$pid"); then
            case "$pstate" in
                Z|X) continue ;;
            esac
        fi
        if comm=$(_oom_read_file "$root/$pid/comm"); then
            # comm is up to 15 bytes of arbitrary text; a raw newline, tab or
            # CR would break the row. It is printed as an argument, so this is
            # layout hygiene, not a format-string concern.
            comm="${comm//$'\n'/ }"
            comm="${comm//$'\t'/ }"
            comm="${comm//$'\r'/ }"
        else
            comm="?"
        fi
        cg_path=""
        cg_short="?"
        if cg_raw=$(_oom_read_file "$root/$pid/cgroup"); then
            cg_short="$(_oom_cgroup_short "${cg_raw%%$'\n'*}")"
            cg_path=$(_oom_cgroup_path "$cg_raw") || cg_path=""
        fi
        # Classify BEFORE the score read: only a SESSION process's unreadable
        # score is "could not tell". A context process is context either way,
        # and a context score of 100 (engramd-owner) says nothing about the
        # seat's policy.
        role="context"
        if [[ -z "$cg_path" ]]; then
            role="unknown"
        elif [[ -n "$unit_cg" && "$cg_path" == "$unit_cg" ]]; then
            role="session"
        elif _oom_is_session_scope "$cg_path" "$uid"; then
            role="session"
        fi
        if score=$(_oom_read_file "$root/$pid/oom_score_adj") \
                && [[ "$score" =~ ^-?[0-9]+$ ]]; then
            score_display="$score"
        else
            if [[ ! -e "$root/$pid/oom_score_adj" ]]; then
                # The process exited between enumeration and this read (its
                # proc entry is gone). It is no longer a live process, so it
                # is not evidence of "could not tell": skip it. Without this,
                # any transient process exiting mid-scan made a healthy seat
                # flake to UNKNOWN (measured with 30 ms-lived processes). A
                # file that EXISTS but cannot be read, or reads as garbage,
                # still sets UNKNOWN below -- that is the real "unreadable".
                continue
            fi
            score_display="?"
        fi
        total=$((total + 1))
        case "$role" in
            session)
                session_total=$((session_total + 1))
                if [[ -n "$unit_cg" && "$cg_path" == "$unit_cg" ]]; then
                    :
                else
                    session_outside=$((session_outside + 1))
                fi
                if [[ "$score_display" == "?" ]]; then
                    unknown_proc=1
                    if [[ -z "$unknown_pid" ]]; then
                        unknown_pid="$pid"
                    fi
                elif ! _oom_is_negative "$score_display"; then
                    any_session_nonneg=1
                fi
                # Distinct cgroups only: the placement question is answered by
                # the set of session cgroups, and listing every pid would leak
                # pids the display cap deliberately hides.
                cg_seen=0
                for seen_cg in "${session_cgs[@]+"${session_cgs[@]}"}"; do
                    if [[ "$seen_cg" == "$cg_path" ]]; then
                        cg_seen=1
                        break
                    fi
                done
                if (( cg_seen == 0 )); then
                    session_cgs+=("$cg_path")
                fi
                ;;
            unknown)
                # A cgroup we cannot read could be the unit's or a session
                # scope: the placement is undeterminable, so the verdict is
                # UNKNOWN rather than a guess.
                cgroup_unknown=1
                if [[ "$score_display" == "?" && -z "$unknown_pid" ]]; then
                    unknown_pid="$pid"
                fi
                ;;
            *)
                context_total=$((context_total + 1))
                ;;
        esac
        if (( shown < OOM_STATUS_DISPLAY_CAP )); then
            printf '%-8s %-16.16s %-14s %s\n' "$pid" "$comm" "$score_display" "$cg_short"
            shown=$((shown + 1))
        fi
    done

    if (( total > shown )); then
        printf '... (%d more process(es) not shown; verdict computed over session processes among all %d)\n' \
            "$((total - shown))" "$total"
    fi

    # The placement evidence: UNIT_CG above, and the full cgroup of every
    # SESSION process here. Context processes are summarized, not listed.
    printf 'session: %d process(es), %d outside the unit cgroup\n' \
        "$session_total" "$session_outside"
    local scg
    for scg in "${session_cgs[@]+"${session_cgs[@]}"}"; do
        printf '  session cgroup: %s\n' "$scg"
    done
    printf 'context: %d process(es) owned by uid %s, never counted in the verdict\n' \
        "$context_total" "$uid"

    # --- verdict ---
    local req_known=0 req_negative=0
    if [[ "$req" =~ ^-?[0-9]+$ ]]; then
        req_known=1
        if _oom_is_negative "$req"; then
            req_negative=1
        fi
    fi

    # --- verdict: SESSION processes only, in the contract's order ---
    local state code reason
    if (( total == 0 )); then
        state="UNKNOWN"; code=3
        reason="no live process found for $user"
    elif (( facts_ok == 0 )); then
        state="UNKNOWN"; code=3
        reason="could not query systemd unit $unit"
    elif (( session_total == 0 )) && (( cgroup_unknown == 0 )); then
        state="UNKNOWN"; code=3
        reason="no session process found for $user: all $total live process(es) owned by the uid are context (.service units, init.scope, or scopes outside user-$uid.slice)"
    elif (( cgroup_unknown != 0 )); then
        state="UNKNOWN"; code=3
        reason="the cgroup of at least one live process owned by $user could not be read, so session placement could not be determined"
    elif (( unknown_proc != 0 )); then
        state="UNKNOWN"; code=3
        reason="at least one session process's /proc/<pid>/oom_score_adj was unreadable or unparseable (first: pid $unknown_pid)"
    elif (( req_known == 0 )); then
        state="UNKNOWN"; code=3
        reason="systemd reported no parseable OOMScoreAdjust for $unit"
    elif (( session_outside != 0 )); then
        # OUTSIDE-UNIT outranks the policy verdicts: when the session did not
        # launch through the unit, "the drop-in was not applied" is the wrong
        # diagnosis -- the drop-in cannot reach these processes at all.
        state="OUTSIDE-UNIT"; code=1
        reason="$session_outside of $session_total session process(es) live outside unit cgroup ${unit_cg:-<unknown>}; relaunch the seat through its unit so the drop-in applies"
    elif (( any_session_nonneg == 0 )) && _oom_memory_is_finite "$mmax"; then
        state="OK"; code=0
        reason="all $session_total live process(es) (session-scoped) read a negative oom_score_adj and MemoryMax=$mmax is finite"
        if (( req_negative == 0 )); then
            # OK is decided on the EFFECTIVE state, so a non-negative requested
            # value does not block it. Say so explicitly: protection that did
            # not come from the policy will not survive a relaunch, and pushing
            # the reader to install a drop-in that does not reach these
            # processes is the placement error this verb exists to expose.
            if [[ "$load" == "not-found" ]]; then
                reason="$reason; note: the unit was not found, so this protection did not come from its policy and will not survive a relaunch from it"
            else
                reason="$reason; note: requested OOMScoreAdjust=$req is not negative, so this protection did not come from the unit policy and will not survive a relaunch from it"
            fi
        fi
    elif (( req_negative != 0 )) && (( any_session_nonneg != 0 )); then
        state="ACCEPTED-NOT-APPLIED"; code=1
        reason="requested OOMScoreAdjust=$req is negative but at least one session process reads >= 0"
    elif (( req_negative != 0 )); then
        # The table has no row for "requested negative, applied, but no finite
        # memory bound". Reported as UNPROTECTED: the seat lacks a memory bound,
        # and claiming OK would contradict the OK row's finite-MemoryMax clause.
        state="UNPROTECTED"; code=1
        reason="every session process reads a negative oom_score_adj but MemoryMax=$mmax is not finite"
    else
        state="UNPROTECTED"; code=1
        if [[ "$load" == "not-found" ]]; then
            # The display above says n/a: never cite systemd's synthesized 0.
            reason="unit $unit was not found, so no OOM policy is configured"
        elif [[ "$active" == "inactive" ]]; then
            reason="unit $unit is inactive; its OOMScoreAdjust is only a property default, not a running policy"
        elif (( any_session_nonneg == 0 )) && ! _oom_memory_is_finite "$mmax"; then
            # Every session process is in fact protected; the MISSING BOUND is
            # why the seat is not OK. Name that rather than the request value.
            reason="every session process reads a negative oom_score_adj but MemoryMax=$mmax is not finite"
        else
            reason="requested OOMScoreAdjust=$req is not negative"
        fi
    fi

    printf 'verdict: %s (%s)\n' "$state" "$reason"
    printf '\n'
    return "$code"
}

# Usage: agentctl oom-status [<seat> ...]
cmd_oom_status() {
    local -a seats=()
    local seat_count=0

    # Resolve the seat universe ONCE: it is the validation set and, for a
    # no-argument run, also the request. The LOOKUP STATUS matters: an existing
    # group with no agent-* members is an empty universe (0 is fine), while a
    # failed lookup means nothing could be determined (3, never 0).
    # list_agents discards getent's status inside its pipeline -- acceptable
    # for the other verbs, a false "all fine" here.
    local known_out
    if ! known_out=$(_oom_known_seats); then
        echo "oom-status: could not look up the 'agents' group (getent failed); no seat state could be determined" >&2
        return 3
    fi

    local -a known=()
    local known_count=0
    local k
    while IFS= read -r k; do
        [[ -n "$k" ]] || continue
        known+=("$k")
        known_count=$((known_count + 1))
    done <<< "$known_out"

    if (( $# > 0 )); then
        seats=("$@")
        seat_count=$#
    else
        for k in "${known[@]+"${known[@]}"}"; do
            seats+=("$k")
            seat_count=$((seat_count + 1))
        done
    fi

    if (( seat_count == 0 )); then
        echo "oom-status: no agent seats found (the 'agents' group exists but has no agent-* members)" >&2
        return 0
    fi

    # Validate the whole request BEFORE printing anything: a bad name is a
    # usage error (exit 2) naming it, never a silent skip.
    local s found
    for s in "${seats[@]+"${seats[@]}"}"; do
        found=0
        for k in "${known[@]+"${known[@]}"}"; do
            if [[ "$k" == "$s" ]]; then
                found=1
                break
            fi
        done
        if (( found == 0 )); then
            echo "ERROR: unknown seat '$s' (not a member of the 'agents' group)" >&2
            if (( known_count > 0 )); then
                echo "Known seats: ${known[*]}" >&2
            fi
            echo "Usage: agentctl oom-status [<seat> ...]" >&2
            return 2
        fi
        if ! id -u "agent-$s" >/dev/null 2>&1; then
            echo "ERROR: unknown seat '$s' (no Linux user 'agent-$s')" >&2
            return 2
        fi
    done

    # --- roll-up: NOT the numeric max ---
    # Rank, highest first: 1 (a definite problem: some seat is UNPROTECTED or
    # ACCEPTED-NOT-APPLIED), 2 (a seat could not be reported at all), 3 (a
    # seat's state could not be determined), 0 (every seat OK).
    #
    # Arithmetic max would be the intuitive default and it is wrong here: a run
    # with seven definitely-unprotected seats plus one unknown would return 3,
    # telling a script "could not tell" about a run that holds seven
    # certainties -- the very collapse the per-seat UNKNOWN code exists to
    # prevent, reintroduced at the roll-up. A definite outcome outranks a
    # softer one; 0 stays the floor so OK seats never mask an unknown.
    local overall=0 saw_definite=0 saw_unreported=0 saw_unknown=0 code
    for s in "${seats[@]+"${seats[@]}"}"; do
        if _oom_seat_report "$s"; then
            code=0
        else
            code=$?
        fi
        case "$code" in
            1) saw_definite=1 ;;
            2) saw_unreported=1 ;;
            3) saw_unknown=1 ;;
        esac
    done
    if (( saw_definite != 0 )); then
        overall=1
    elif (( saw_unreported != 0 )); then
        overall=2
    elif (( saw_unknown != 0 )); then
        overall=3
    fi
    return "$overall"
}

# ---------- session helpers ----------

# _session_platform: detect which platform binary to use for this agent.
# Deterministic ladder, first hit wins:
#   1. Explicit override (non-empty $1)
#   2. Baked profile at ~/.engram/marketplace/plugins/engram/platform.json
#   3. Binary heuristic: codex present + claude absent → codex
#   4. Default: claude
# No sudo inside this function when as_self=1 — caller passes $user for the
# sudo cmds in the normal (sudo-switch) path; under --as-self the invoking
# shell already IS $user (verified by _as_self_check before this is called),
# so steps 2-3 run directly with no user-switch at all.
# Signature: _session_platform <override> <user> [<as_self=0>]
_session_platform() {
    local override="$1"
    local user="$2"
    local as_self="${3:-0}"

    # 1. Explicit override
    if [[ -n "$override" ]]; then
        case "$override" in
            claude|codex) echo "$override"; return 0 ;;
            *) echo "ERROR: --platform must be claude or codex (got '$override')" >&2; return 2 ;;
        esac
    fi

    # 2. Baked profile (no jq dependency — grep+cut only)
    local raw
    if [[ "$as_self" -eq 1 ]]; then
        raw=$(cat ~/.engram/marketplace/plugins/engram/platform.json 2>/dev/null) || true
    else
        raw=$(sudo -u "$user" -i bash -c \
            'cat ~/.engram/marketplace/plugins/engram/platform.json' 2>/dev/null) || true
    fi
    if [[ -n "$raw" ]] && echo "$raw" | grep -q '"platform"'; then
        local val
        val=$(echo "$raw" \
            | grep -o '"platform"[[:space:]]*:[[:space:]]*"[^"]*"' \
            | head -1 \
            | sed 's/.*:[[:space:]]*"\([^"]*\)".*/\1/')
        if [[ "$val" == "codex" ]]; then
            echo "codex"; return 0
        elif [[ -n "$val" ]]; then
            echo "claude"; return 0
        fi
    fi

    # 3. Binary heuristic: codex present AND claude absent → codex
    local has_codex=0 has_claude=0
    if [[ "$as_self" -eq 1 ]]; then
        command -v codex >/dev/null 2>&1 && has_codex=1
        command -v claude >/dev/null 2>&1 && has_claude=1
    else
        sudo -u "$user" -i bash -c 'command -v codex' >/dev/null 2>&1 && has_codex=1
        sudo -u "$user" -i bash -c 'command -v claude' >/dev/null 2>&1 && has_claude=1
    fi
    if [[ $has_codex -eq 1 && $has_claude -eq 0 ]]; then
        echo "codex"; return 0
    fi

    # 4. Default
    echo "claude"
}

# _as_self_check: verify the invoking OS user already IS the target agent's
# Linux user. Used by cmd_session's --as-self flag, which skips the sudo/
# user-switch entirely (for use inside a systemd unit with User=agent-<name>,
# where sudo is neither available nor needed inside the unit).
# On match: no output, return 0.
# On mismatch: loud error to stderr naming both users, return 1 (cmd_session
# maps this to exit 7 — a distinct code from the alias-grammar's 3/4/5/6).
# Pure function: no sudo, no filesystem writes — safe to unit-test directly
# via the internal __as-self-check verb (no real agent user required).
_as_self_check() {
    local target_user="$1"
    local current_user; current_user="$(id -un)"
    if [[ "$current_user" != "$target_user" ]]; then
        echo "ERROR: --as-self requires the invoking user to already be '$target_user' (no sudo/user-switch is performed)." >&2
        echo "       Current user: '$current_user'." >&2
        echo "       (--as-self assumes the caller is already the target agent, e.g. a" >&2
        echo "       systemd unit with User=agent-<name> where sudo is unavailable)" >&2
        return 1
    fi
    return 0
}

# _parse_session_flags: pure function (no sudo, no resolve_user, no
# filesystem) that parses cmd_session's OWN flags — --platform, --no-share,
# --cd, --local, --as-self. This is a separate namespace from the platform-
# alias grammar (-c/-d/-r — see _expand_session_args); anything not matched
# here (including single-dash aliases and double-dash platform flags) is
# collected verbatim into the extra/passthrough array, unexamined, so the
# two layers compose without either duplicating the other's logic.
#
# Signature: _parse_session_flags <platform_var> <no_share_var> <as_self_var> <cd_var> <charge_file_var> <extra_var> -- <args...>
#   Sets the caller's 6 variables via namerefs (bash 4.3+), mirroring the
#   _normalize_chosen_name nameref-out pattern used elsewhere in this file.
# Returns 2 (usage error) on a malformed --platform/--cd (missing argument),
# matching cmd_session's pre-existing exit-2 convention for flag-arg errors.
# cmd_session calls this instead of an inline while-loop so the parsing logic
# has exactly one implementation, reused by both the production path and the
# internal __parse-session-flags test verb.
_parse_session_flags() {
    local -n _psf_platform="$1"
    local -n _psf_no_share="$2"
    local -n _psf_as_self="$3"
    local -n _psf_cd="$4"
    local -n _psf_charge_file="$5"
    local -n _psf_extra="$6"
    shift 6
    [[ "${1:-}" == "--" ]] && shift

    _psf_platform=""
    _psf_no_share=0
    _psf_as_self=0
    _psf_cd=""
    _psf_charge_file=""
    _psf_extra=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --platform)
                [[ -z "${2:-}" ]] && { echo "ERROR: --platform requires an argument (claude|codex)" >&2; return 2; }
                _psf_platform="$2"; shift 2 ;;
            --platform=*) _psf_platform="${1#--platform=}"; shift ;;
            --local)
                echo "(--local is deprecated: agentctl selects the platform-managed session topology)" >&2
                shift ;;
            --no-share) _psf_no_share=1; shift ;;
            --as-self) _psf_as_self=1; shift ;;
            --cd)
                [[ -z "${2:-}" ]] && { echo "ERROR: --cd requires a directory argument" >&2; return 2; }
                _psf_cd="$2"; shift 2 ;;
            --cd=*) _psf_cd="${1#--cd=}"; shift ;;
            --charge-file)
                [[ -z "${2:-}" ]] && { echo "ERROR: --charge-file requires a file argument" >&2; return 2; }
                _psf_charge_file="$2"; shift 2 ;;
            --charge-file=*) _psf_charge_file="${1#--charge-file=}"; shift ;;
            *) _psf_extra+=("$1"); shift ;;
        esac
    done
    return 0
}

# _expand_session_args: pure function (no sudo, no filesystem).
# Expands short aliases to their full equivalents for the given platform.
# Signature: _expand_session_args <platform> <agent_name> <args...>
# Outputs one word per line (callers use `mapfile` to collect).
# Returns exit 4 on unknown platform (this is the unit-test seam for
# platform validation; cmd_session also validates via _session_platform).
# Returns exit 5 if any arg is empty or contains a newline — the one-word-
# per-line protocol cannot carry either (empty args are silently stripped by
# command substitution; newline-args would split into multiple words on the
# read side). Rejection is loud and early.
# Returns exit 6 if any single-dash arg contains an unrecognized alias char.
#   Error names the offending char and the original arg on stderr.
#
# Flag namespace:
#   Single-dash args (-xyz): the agentctl alias namespace — BUNDLE of single-
#   char alias flags, expanded in char order.  Any constituent char that is not
#   a recognized alias (c/d/r) causes loud failure (exit 6).  NO single-dash
#   arg ever passes through raw, including chars that look like platform flags
#   (e.g. -n, -e).  Bare - (the stdin convention) is treated as a non-flag arg
#   and passes through verbatim.
#   Double-dash args (--anything): platform pass-through verbatim.
#   Non-flag args: pass through verbatim.
#
# Emission discipline: ALL words are emitted with `printf '%s\n'`, NEVER with
# `echo`. bash's echo consumes flags like -n/-e/-E as its own options and emits
# nothing or a bare newline — silent data corruption for args that happen to
# look like echo flags. printf '%s\n' is flag-agnostic; the format string is
# always literal. This is the same class of silent-corruption hazard as the
# -d/--debug collision that motivated the alias layer in the first place.
#
# Expansion rules (single-char aliases):
#   -c  claude → append --continue                         (deduped)
#       codex  → base command becomes "codex resume --last" (deduped; cannot
#                be combined with the bypass-permissions flag)
#   -d  claude → --dangerously-skip-permissions            (deduped)
#       codex  → --dangerously-bypass-approvals-and-sandbox (deduped)
#   -r  claude → --remote-control <agent_name>  (two words, deduped)
#       codex  → silently ignored (remote control unavailable)
# Bundles are split first, then each char is expanded by the rules above.
# Dedup across a bundle works identically to dedup across separate flags.
#
# NOTE: aliases MUST be expanded here and never passed through raw.
# claude itself parses -d as --debug (silent behavior change); that is the
# reason these aliases live in agentctl rather than the caller.
_codex_remote_resume_bypass_error() {
    printf '%s\n' "ERROR: Codex remote resume forbids permission override." >&2
    printf '%s\n' "       Requested bypass was NOT applied; no session was resumed." >&2
    printf '%s\n' "       Use -c, then inspect /permissions (or /status) for the actual policy." >&2
    printf '%s\n' "       A new full-access thread uses -d without -c." >&2
}

# Return success only when a Codex argv contains both an explicit `resume`
# subcommand and the exact bypass flag.  Codex permits global options before
# its subcommand, so this walks its documented global-option grammar rather
# than assuming argv[0] is the subcommand.  It deliberately stops on an
# unknown option or positional argument: guessing there would risk treating a
# prompt as a resume request.
_codex_remote_resume_bypass_requested() {
    local saw_bypass=0
    local consume_value=0
    local consuming_images=0
    local arg

    while [[ $# -gt 0 ]]; do
        arg="$1"
        shift

        if [[ $consume_value -eq 1 ]]; then
            consume_value=0
            continue
        fi

        # --image accepts one or more values.  A bare `resume` immediately
        # after it is an image value, not a subcommand; a following option
        # ends that value list and resumes normal global-option parsing.
        if [[ $consuming_images -eq 1 ]]; then
            if [[ "$arg" != -* || "$arg" == "-" ]]; then
                continue
            fi
            consuming_images=0
        fi

        case "$arg" in
            --)
                return 1
                ;;
            resume)
                # After the subcommand, the bypass is a flag unless an
                # explicit separator makes it prompt text.
                if [[ $saw_bypass -eq 1 ]]; then
                    return 0
                fi
                for arg in "$@"; do
                    [[ "$arg" == "--" ]] && return 1
                    [[ "$arg" == "--dangerously-bypass-approvals-and-sandbox" ]] && return 0
                done
                return 1
                ;;
            --dangerously-bypass-approvals-and-sandbox)
                saw_bypass=1
                ;;
            --config|--enable|--disable|--remote|--remote-auth-token-env|--model|--local-provider|--profile|--sandbox|--cd|--add-dir|--ask-for-approval|-c|-m|-p|-s|-C|-a)
                consume_value=1
                ;;
            --image|-i)
                consuming_images=1
                ;;
            --config=*|--enable=*|--disable=*|--remote=*|--remote-auth-token-env=*|--model=*|--local-provider=*|--profile=*|--sandbox=*|--cd=*|--add-dir=*|--ask-for-approval=*|--image=*|-c?*|-i?*|-m?*|-p?*|-s?*|-C?*|-a?*)
                : # Attached or equals-form global option value.
                ;;
            --strict-config|--oss|--approve-for-me|--dangerously-bypass-hook-trust|--worktree|--search|--no-alt-screen|--no-daemon)
                : # Value-free global option.
                ;;
            -h|--help|-V|--version)
                return 1
                ;;
            *)
                return 1
                ;;
        esac
    done
    return 1
}

_expand_session_args() {
    local platform="$1"
    local agent_name="$2"
    shift 2

    # Validate platform — unknown values are a caller error.
    case "$platform" in
        claude|codex) ;;
        *) printf '%s\n' "ERROR: unknown platform '$platform' (expected claude or codex)" >&2; return 4 ;;
    esac

    # Reject empty args and newline-containing args before any expansion.
    # The one-word-per-line protocol cannot carry them: command substitution
    # strips trailing newlines (--resume "" becomes --resume silently), and a
    # newline in an arg would split into multiple words on the mapfile side.
    for arg in "$@"; do
        if [[ -z "$arg" ]]; then
            printf '%s\n' "session args may not be empty or contain newlines (got: <empty>)" >&2
            return 5
        fi
        if [[ "$arg" == *$'\n'* ]]; then
            # Represent the arg with \n visible for diagnostics.
            local repr; repr="${arg//$'\n'/\\n}"
            printf '%s\n' "session args may not be empty or contain newlines (got: $repr)" >&2
            return 5
        fi
    done

    local base_cmd="$platform"
    local use_resume=0   # codex -c subcommand transform flag
    local extra_args=()
    local has_bad_alias=0 # set to 1 on unrecognized single-char alias (exit 6)

    # First pass: collect flags, detect -c (anywhere, including inside bundles)
    # for codex subcommand transform.  We scan args once to determine if -c is
    # present before emitting the base command words.  Bundle expansion applies
    # here too: -rc, -cr, etc. all count as containing -c.
    local saw_c=0
    for arg in "$@"; do
        # Bare - is not a bundle; skip.
        [[ "$arg" == "-" ]] && continue
        # Single-dash bundle: scan each char.
        if [[ "$arg" =~ ^-[^-].* ]]; then
            local chars="${arg#-}"
            local i=0
            while [[ $i -lt ${#chars} ]]; do
                local ch="${chars:$i:1}"
                [[ "$ch" == "c" ]] && saw_c=1
                (( i++ )) || true
            done
        elif [[ "$arg" == "-c" ]]; then
            # Legacy single-char form — already matched by the bundle branch above,
            # but explicit for clarity (single char is a bundle of length 1).
            saw_c=1
        fi
    done

    if [[ "$platform" == "codex" && $saw_c -eq 1 ]]; then
        use_resume=1
    fi

    # Second pass: expand aliases.
    # Single-dash args are treated as BUNDLES: -xyz splits into -x -y -z, each
    # expanded in char order.  Any char not in the recognized alias set (c/d/r)
    # causes loud failure (exit 6) naming the char and the original arg.
    # Bare - passes through as a non-flag arg.
    # Double-dash and non-flag args pass through verbatim.
    local skip_c_done=0   # dedupe -c for claude (emit --continue only once)
    local seen_d=0         # dedupe -d across both platforms (emit flag once)
    local seen_r=0         # dedupe -r on claude (emit --remote-control <agent> only once)

    _expand_one_alias() {
        # Expand a single alias char for the current platform/agent.
        # Modifies outer-scope variables: extra_args, has_bad_alias,
        # skip_c_done, seen_d, seen_r.  Takes: char, original_arg.
        local ch="$1" orig_arg="$2"
        case "$ch" in
            c)
                if [[ "$platform" == "claude" ]]; then
                    if [[ $skip_c_done -eq 0 ]]; then
                        extra_args+=("--continue")
                        skip_c_done=1
                    fi
                elif [[ "$platform" == "codex" ]]; then
                    : # absorbed into subcommand transform; no per-occurrence output
                fi
                ;;
            d)
                if [[ $seen_d -eq 0 ]]; then
                    if [[ "$platform" == "claude" ]]; then
                        extra_args+=("--dangerously-skip-permissions")
                    else
                        extra_args+=("--dangerously-bypass-approvals-and-sandbox")
                    fi
                    seen_d=1
                fi
                ;;
            r)
                if [[ "$platform" == "claude" ]]; then
                    if [[ $seen_r -eq 0 ]]; then
                        extra_args+=("--remote-control")
                        extra_args+=("$agent_name")
                        seen_r=1
                    fi
                else
                    : # Codex has no agentctl remote-control equivalent; consume -r for compatibility.
                fi
                ;;
            *)
                printf '%s\n' "ERROR: unrecognized alias '-$ch' in arg '$orig_arg' (recognized: c d r)" >&2
                has_bad_alias=1
                ;;
        esac
    }

    for arg in "$@"; do
        if [[ "$arg" == "-" ]]; then
            # Bare - is the stdin convention: pass through as a non-flag arg.
            extra_args+=("$arg")
        elif [[ "$arg" =~ ^-[^-] ]]; then
            # Single-dash bundle: split into chars and expand each in order.
            local chars="${arg#-}"
            local i=0
            while [[ $i -lt ${#chars} ]]; do
                local ch="${chars:$i:1}"
                _expand_one_alias "$ch" "$arg"
                (( i++ )) || true
            done
        else
            # Double-dash flag or non-flag arg: pass through verbatim.
            extra_args+=("$arg")
        fi
    done

    if [[ $has_bad_alias -eq 1 ]]; then
        return 6
    fi

    # Codex remote resume rejects permission overrides before it reaches the
    # managed thread. Refuse before emitting any command, rather than silently
    # dropping -d or claiming to know the saved thread's policy.
    if [[ "$platform" == "codex" ]]; then
        local codex_resume_args=()
        if [[ $use_resume -eq 1 ]]; then
            codex_resume_args=("resume" "--last")
        fi
        local extra_arg
        for extra_arg in "${extra_args[@]+"${extra_args[@]}"}"; do
            codex_resume_args+=("$extra_arg")
        done
        if _codex_remote_resume_bypass_requested "${codex_resume_args[@]+"${codex_resume_args[@]}"}"; then
            _codex_remote_resume_bypass_error
            return 7
        fi
    fi

    # Emit base command words, then expanded args.
    # printf '%s\n' is used throughout (not echo) — see emission discipline above.
    if [[ "$platform" == "codex" && $use_resume -eq 1 ]]; then
        printf '%s\n' "codex"
        printf '%s\n' "resume"
        printf '%s\n' "--last"
    else
        printf '%s\n' "$base_cmd"
    fi
    # ${arr[@]+"${arr[@]}"} rather than a bare "${extra_args[@]}": under
    # `set -u`, bash versions before 4.4 treat an EMPTY array as an unset
    # variable and raise "unbound variable" here (e.g. `session <agent>`
    # with no -c/-d/-r aliases at all -- extra_args stays empty). This
    # never surfaces on the bash 5.x this tool normally runs under, but does
    # on macOS's frozen bash 3.2 (tools/agentctl-mac invokes this verb
    # directly) -- the guarded form is a no-op on newer bash and portable
    # everywhere.
    for a in "${extra_args[@]+"${extra_args[@]}"}"; do
        printf '%s\n' "$a"
    done
}

# _codex_daemon_socket: ensure the current user's *managed* Codex daemon is
# running, then prove that its control socket is usable. `daemon start` is the
# vendor's idempotent start operation; this wrapper never invokes restart,
# stop, kill, or signal. A stale socket is deliberately fatal: falling back to
# `codex` locally would create an unrelated app-server/thread and strand the
# wake watcher on the old endpoint.
_codex_daemon_socket() {
    local start_output version_output socket_path
    if ! start_output="$(codex app-server daemon start 2>&1)"; then
        echo "ERROR: could not ensure the managed Codex app-server daemon is running." >&2
        [[ -n "$start_output" ]] && printf '       %s\n' "$start_output" >&2
        echo "       Run 'codex app-server daemon version' as this agent for details; do not start a local Codex fallback." >&2
        return 1
    fi

    if ! version_output="$(codex app-server daemon version 2>&1)"; then
        echo "ERROR: managed Codex app-server is unreachable after daemon start." >&2
        [[ -n "$version_output" ]] && printf '       %s\n' "$version_output" >&2
        echo "       The control socket may be stale. Inspect it with 'codex app-server daemon version'; do not launch a local TUI." >&2
        return 1
    fi

    socket_path="$(python3 -c '
import json, sys
try:
    value = json.loads(sys.stdin.read()).get("socketPath")
except Exception:
    value = None
if isinstance(value, str) and value:
    print(value)
else:
    raise SystemExit(1)
' <<<"$version_output")" || {
        echo "ERROR: managed Codex app-server reported no usable socketPath." >&2
        echo "       Output: $version_output" >&2
        return 1
    }
    if [[ ! -S "$socket_path" ]]; then
        echo "ERROR: managed Codex app-server reported '$socket_path', but it is not a Unix socket." >&2
        echo "       Refusing to launch a separate local Codex TUI." >&2
        return 1
    fi
    printf '%s\n' "$socket_path"
}

# _codex_managed_session: run as the target agent user. There is exactly one
# human-facing Codex TUI per agent: tmux `agent-<name>`, connected remotely to
# that user's daemon control socket. This is also the topology consumed by the
# autonomous wake bridge. If the tmux session already exists, attach instead of
# creating another TUI; arguments are rejected because applying a new resume or
# prompt to an already-live UI would be ambiguous and silently lossy.
_codex_managed_session() {
    local name="${1:-}"; shift || true
    [[ -n "$name" ]] || { echo "Usage: agentctl __codex-managed-session <agent> [--cwd <dir>] -- [codex args...]" >&2; return 2; }

    local cwd="$HOME"
    if [[ "${1:-}" == "--cwd" ]]; then
        [[ -n "${2:-}" ]] || { echo "ERROR: --cwd requires a directory" >&2; return 2; }
        cwd="$2"; shift 2
    fi
    [[ "${1:-}" == "--" ]] || { echo "ERROR: internal Codex session arguments require -- separator" >&2; return 2; }
    shift
    [[ -d "$cwd" ]] || { echo "ERROR: Codex session cwd '$cwd' is not a directory" >&2; return 1; }
    if _codex_remote_resume_bypass_requested "$@"; then
        _codex_remote_resume_bypass_error
        return 2
    fi
    local requested_arg
    for requested_arg in "$@"; do
        case "$requested_arg" in
            --remote|--remote=*)
                echo "ERROR: explicit --remote is not allowed for managed Codex sessions." >&2
                echo "       agentctl uses this agent's verified daemon socket; use 'agentctl attach $name' instead." >&2
                return 2
                ;;
        esac
    done

    local socket_path
    socket_path="$(_codex_daemon_socket)" || return 1
    local tmux_session="agent-${name}"

    # The boot runner already owns the intended tmux pane. Replace that pane's
    # shell with the remote TUI rather than attaching tmux to itself.
    if [[ -n "${TMUX:-}" ]] && [[ "$(tmux display-message -p '#S' 2>/dev/null || true)" == "$tmux_session" ]]; then
        # Keep terminal-wheel scrolling on the TUI's output instead of
        # forwarding wheel events to Codex's input-history navigation.
        tmux set-option -t "$tmux_session" mouse on
        # `--cwd` must apply here too: unlike the new-session path below,
        # tmux cannot set it for an already-existing pane. The boot runner
        # passes --cd explicitly, so execing without this cd would launch the
        # remote TUI in the systemd unit's cwd rather than the requested
        # project directory.
        cd "$cwd" || {
            echo "ERROR: Codex session cwd '$cwd' is not accessible." >&2
            return 1
        }
        exec codex --remote "unix://${socket_path}" "$@"
    fi

    if tmux has-session -t "$tmux_session" 2>/dev/null; then
        if [[ $# -gt 0 ]]; then
            echo "ERROR: managed Codex TUI '$tmux_session' is already running; cannot apply new session/resume arguments." >&2
            echo "       Use 'agentctl attach $name' to interact with the existing thread (or 'agentctl attach $name -r' to observe)." >&2
            return 1
        fi
        tmux set-option -t "$tmux_session" mouse on
        exec tmux attach -t "$tmux_session"
    fi

    # tmux accepts a shell command rather than an argv vector on all supported
    # versions, and runs it with its default-shell, which tmux takes from the first
    # suitable of $SHELL in the environment that started the server, the passwd
    # login shell, or /bin/sh (bash for every agent account's login shell here;
    # what a given server inherited is not measured). Each word,
    # prompts included, is POSIX single-quoted with _shq so word boundaries stay
    # exact under ANY POSIX shell. printf %q is not enough: a %q word holding a
    # control character plus a quote is $'...', which dash reads as $ plus a plain
    # quoted string. Because the string starts with exec, the consequence under
    # dash would be silently WRONG WORDS handed to codex (prompts included); were
    # exec ever dropped, the rest of such a word would run as code.
    local remote_command="exec"
    local word quoted_word
    for word in codex --remote "unix://${socket_path}" "$@"; do
        quoted_word=" $(_shq "$word")"
        remote_command+="$quoted_word"
    done
    tmux new-session -d -s "$tmux_session" -c "$cwd" "$remote_command"
    if ! tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo "ERROR: failed to create managed Codex tmux session '$tmux_session'." >&2
        echo "       Daemon remains untouched; inspect tmux and attach only after it exists." >&2
        return 1
    fi
    tmux set-option -t "$tmux_session" mouse on
    exec tmux attach -t "$tmux_session"
}

# Shared launch prologue (#3451): run in the TARGET user's shell by every
# Claude launch branch of cmd_session, before `cd`/`exec`. Same semantics as
# deploy/autostart/agent-session-launch.sh (source ~/.engram/boot-env with
# set -a/+a), so a manual `agentctl session` restart gives the seat the same
# environment as a booted one. umask 022 matches the autostart status quo (the
# `sudo -i` login shell inherits 0002). boot-env ABSENT is the normal state for
# most seats: a true optional, silent. Present-but-unreadable is loud (one
# stderr line) and not fatal. The HOST-COMMON file (default
# /home/agents-shared/autostart/boot-env.common, /Users/Shared/autostart/ when
# /Users/Shared exists; override AGENT_BOOT_ENV_COMMON) is sourced just BEFORE
# the per-agent boot-env with the same absent/unreadable/error policy, so the
# per-agent value wins. No `${}` or `$()` in the text: `sudo -i` backslash-
# escapes braces and parens, which would break them. Printed by `agentctl __session-prologue` so the
# tests run the exact text the launch branches use.
# ONE line on purpose: `sudo -i <cmd>` backslash-escapes a newline in the command
# string, which the login shell reads as a line continuation (joining lines).
session_prologue_text() {
    cat <<'PROLOGUE'
umask 022; _ec="$AGENT_BOOT_ENV_COMMON"; if [ -z "$_ec" ]; then if [ -d /Users/Shared ]; then _ec=/Users/Shared/autostart/boot-env.common; else _ec=/home/agents-shared/autostart/boot-env.common; fi; fi; if [ -e "$_ec" ]; then if [ -r "$_ec" ]; then set -a; . "$_ec"; set +a; else echo "agentctl: WARNING: host-common boot-env $_ec exists but is not readable; launching without it" >&2; fi; fi; unset _ec; if [ -e "$HOME/.engram/boot-env" ]; then if [ -r "$HOME/.engram/boot-env" ]; then set -a; . "$HOME/.engram/boot-env"; set +a; else echo "agentctl: WARNING: $HOME/.engram/boot-env exists but is not readable; launching without it" >&2; fi; fi
PROLOGUE
}

cmd__session_prologue() { session_prologue_text; }

# Internal verb (#4435), not in user-facing help: exec a Claude launch inside
# its own transient user scope, `agent-claude-<seat>.scope`, created with
# OOMPolicy=continue. Why: on 2026-11-07 the kernel OOM-killed ONE process in a
# session's cgroup and systemd's default OOMPolicy=stop then stopped the WHOLE
# unit. A scope created with OOMPolicy=continue survives an OOM kill of one of
# its processes. OOMPolicy is creation-time only (`systemctl set-property`
# refuses it), so the launch itself must create the scope.
#
# Why a verb and not a function in the prologue: the prologue text is run
# through `sudo -u <user> -i bash -c` at four launch sites, and `sudo -i`
# backslash-escapes braces and parens and joins lines, so the prologue must stay
# free of `${}` / `$()` / newlines. Every launch site instead execs
# `<abs agentctl> __scope-exec <seat> <cmd> [args...]`, where the outer shell
# inserted the path and seat with printf %q.
#
# Usage: agentctl __scope-exec <seat> <cmd> [args...]
#   1. no `systemd-run` on PATH: on macOS exec <cmd> silently; on Linux one
#      WARNING (`systemd-run not found on PATH`), then exec <cmd> unconfined.
#   2. invalid seat name: one WARNING line, exec <cmd> unconfined.
#   3. XDG_RUNTIME_DIR unset: use <base>/<uid> when it is a directory, else one
#      WARNING line and exec unconfined. ENGRAM_RUNTIME_BASE (default /run/user)
#      exists ONLY so tests can point at a temp dir; it is not an operator knob.
#   4. ONE probe: `systemctl --user show -p ActiveState --value <unit>.scope`;
#      a non-zero exit -> one WARNING carrying the first line of its stderr.
#      Exit 0 but no line is exactly a systemd ActiveState word -> one WARNING
#      `user manager probe unreadable: <first line>`, exec unconfined.
#   5. probe says active/activating/reloading/deactivating -> name collision.
#      Exactly ONE more systemctl call, on the collision branch only (no retry,
#      no loop): `systemctl --user show -p ControlGroup --value <unit>.scope`
#      (stderr discarded). If it exits 0 and its last non-empty line starts with
#      `/`, read <cgroup root><that path>/cgroup.procs (ENGRAM_CGROUP_ROOT,
#      default /sys/fs/cgroup, exists ONLY so tests can point at a temp dir; it
#      is not an operator knob) and, for each pid, /proc/<pid>/comm (a pid that is
#      unreadable or gone is skipped). If any comm is exactly `claude`: ONE ERROR
#      line on stderr, `exit 3`, exec nothing, never call systemd-run (a live
#      claude already owns the scope; starting a second session would be wrong).
#      Otherwise (no claude among the pids; the ControlGroup call failing; an
#      empty or non-`/` value; an unreadable cgroup.procs) keep the one WARNING
#      and exec unconfined.
#   6. otherwise exec systemd-run --user --scope ... -p OOMPolicy=continue.
# Exit status is the child's own (everything is exec). Never prompts, never
# sleeps. The probe's stdout and stderr share one pipe (single call, no temp
# file): on failure stdout is empty so the first line IS stderr's first line; on
# success the state is the LAST line that is exactly one of systemd's ActiveState
# words (active reloading inactive failed activating deactivating maintenance
# refreshing), so stray stderr lines such as `Warning: ...` on either side of it
# cannot be mistaken for the state.
#
# STATED BOUNDS, not claims of protection:
#   - An unreadable cgroup (or cgroup.procs) is treated as "no claude": the
#     leftover-orphans case stays warn-and-launch.
#   - comm matches a native install (comm `claude`; the exe basename is a version
#     number, so never test that). A node-run claude whose comm is not `claude` is
#     not detected (unmeasured).
#   - Probe-then-exec has a race. If
# systemd-run itself then fails to create the scope (for example another
# process took the name in between), the launch FAILS with systemd-run's own
# error; it does not fall back to an unconfined launch. That is accepted: a
# second probe would only narrow the race, never close it.
_scope_exec_warn() {
    printf '[agentctl] WARNING: session NOT in a protected scope (%s); launching unconfined.\n' "$1" >&2
}

cmd__scope_exec() {
    # Refusal, not a fallback: every `__` verb is dispatched with no
    # require_root, and this one execs an arbitrary command, so under
    # `sudo agentctl __scope-exec ...` it would be a root primitive. It never
    # legitimately runs as root: each launch site runs it as the target agent
    # user (sudo -u <user> -i, or as-self). Must stay the FIRST statement. The
    # guard reads the shell's own $EUID, which no environment variable or PATH
    # entry can shadow (unlike `id -u`, a PATH lookup). The test runs it under
    # a real user namespace (`unshare -r`).
    if [[ "$EUID" -eq 0 ]]; then
        echo "[agentctl] ERROR: __scope-exec refuses to run as root (it execs an arbitrary command)" >&2
        exit 2
    fi
    local seat="${1-}"
    shift || true
    if [[ $# -lt 1 ]]; then
        echo "Usage: agentctl __scope-exec <seat> <cmd> [args...]" >&2
        exit 2
    fi
    if ! command -v systemd-run >/dev/null 2>&1; then
        # Expected on macOS (no systemd): silent. On Linux a missing systemd-run
        # means something is broken (e.g. PATH), so say so like every other
        # fallback rather than dropping the protection without a word.
        if [[ "$(uname -s 2>/dev/null)" == Linux ]]; then
            _scope_exec_warn "systemd-run not found on PATH"
        fi
        exec "$@"
    fi
    if [[ ! "$seat" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]]; then
        # Control characters would split the one-line warning.
        _scope_exec_warn "invalid seat name '${seat//[^[:print:]]/?}'"
        exec "$@"
    fi
    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        local rdir
        rdir="${ENGRAM_RUNTIME_BASE:-/run/user}/$UID"  # $UID, like the guard: no PATH lookup
        if [[ -d "$rdir" ]]; then
            export XDG_RUNTIME_DIR="$rdir"
        else
            _scope_exec_warn "XDG_RUNTIME_DIR unset and $rdir missing"
            exec "$@"
        fi
    fi
    local unit="agent-claude-$seat" probe probe_rc=0 state
    probe="$(systemctl --user show -p ActiveState --value "$unit.scope" 2>&1)" || probe_rc=$?
    if [[ "$probe_rc" -ne 0 ]]; then
        _scope_exec_warn "user manager unreachable: ${probe%%$'\n'*}"
        exec "$@"
    fi
    local line
    state=""
    while IFS= read -r line; do
        case "$line" in
            active|reloading|inactive|failed|activating|deactivating|maintenance|refreshing)
                state="$line" ;;
        esac
    done <<<"$probe"
    if [[ -z "$state" ]]; then
        _scope_exec_warn "user manager probe unreadable: ${probe%%$'\n'*}"
        exec "$@"
    fi
    case "$state" in
        active|activating|reloading|deactivating)
            local cg cg_rc=0 cg_line cgl procs pid comm
            cg="$(systemctl --user show -p ControlGroup --value "$unit.scope" 2>/dev/null)" || cg_rc=$?
            cg_line=""
            while IFS= read -r cgl; do
                [[ -n "$cgl" ]] && cg_line="$cgl"
            done <<<"$cg"
            if [[ "$cg_rc" -eq 0 && "$cg_line" == /* ]]; then
                procs="${ENGRAM_CGROUP_ROOT:-/sys/fs/cgroup}$cg_line/cgroup.procs"
                if [[ -r "$procs" ]]; then
                    while IFS= read -r pid || [[ -n "$pid" ]]; do
                        [[ "$pid" =~ ^[0-9]+$ ]] || continue
                        comm=""
                        { IFS= read -r comm < "/proc/$pid/comm"; } 2>/dev/null || continue
                        if [[ "$comm" == claude ]]; then
                            echo "[agentctl] ERROR: claude is already running in $unit.scope (pid $pid); not starting a second session. Attach with 'agentctl attach $seat' or stop it with 'agentctl __scope-stop $seat'." >&2
                            exit 3
                        fi
                    done < "$procs"
                fi
            fi
            _scope_exec_warn "$unit.scope already $state"
            exec "$@"
            ;;
    esac
    exec systemd-run --user --scope --quiet --collect --unit="$unit" \
        -p OOMPolicy=continue -- "$@"
}

# Internal verb (#4435): stop the seat's `agent-claude-<seat>.scope`. Called by
# agent-session@.service's ExecStop, so `systemctl stop|restart
# agent-session@<seat>` still ends the session. Before #4435 claude lived in the
# unit's own cgroup (or a tmux scope) and died with it; __scope-exec moves it
# into its own user scope, which a unit stop no longer reaches, so a claude that
# did not exit on the pty hangup would survive and the next start would collide.
# Runs as the agent (User=agent-%i); refuses root and invalid seat names.
# Absent or inactive scope -> exit 0 (nothing to stop). The unit prefixes the
# line with `-`, so a failure here never fails the unit's own stop.
cmd__scope_stop() {
    if [[ "$EUID" -eq 0 ]]; then
        echo "[agentctl] ERROR: __scope-stop refuses to run as root" >&2
        exit 2
    fi
    local seat="${1-}"
    if [[ ! "$seat" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]]; then
        echo "[agentctl] ERROR: __scope-stop: invalid seat name '${seat//[^[:print:]]/?}'" >&2
        exit 2
    fi
    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        local rdir="${ENGRAM_RUNTIME_BASE:-/run/user}/$UID"
        if [[ ! -d "$rdir" ]]; then
            echo "[agentctl] WARNING: __scope-stop: XDG_RUNTIME_DIR unset and $rdir missing; nothing to stop" >&2
            exit 0
        fi
        export XDG_RUNTIME_DIR="$rdir"
    fi
    local unit="agent-claude-$seat.scope" probe line state=""
    probe="$(systemctl --user show -p ActiveState --value "$unit" 2>&1)" || {
        echo "[agentctl] WARNING: __scope-stop: user manager unreachable: ${probe%%$'\n'*}" >&2
        exit 1
    }
    while IFS= read -r line; do
        case "$line" in
            active|reloading|inactive|failed|activating|deactivating|maintenance|refreshing)
                state="$line" ;;
        esac
    done <<<"$probe"
    if [[ -z "$state" ]]; then
        echo "[agentctl] WARNING: __scope-stop: user manager probe unreadable: ${probe%%$'\n'*}; stopping anyway" >&2
    fi
    case "$state" in
        inactive|failed) exit 0 ;;
    esac
    exec systemctl --user stop "$unit"
}

# POSIX single-quoting, never printf %q: at runs the job with /bin/sh, and tmux runs a
# launch string with its default-shell; a %q word with a control character plus a quote is
# $'...', which dash reads as $ plus a plain quoted string. Used by cmd_share (the at job) and
# _codex_managed_session (the tmux launch). agentctl requires bash 4.3+ (header
# os-harness-check). Under macOS bash 3.2 this function itself failed 10 of 54 hostile-name
# runs (PR 4410 read), unreachable here because of that floor; bash 4.3 to 5.1 is NOT tested.
_shq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# Octal ANSI-C quoting for words that go through `sudo -i bash -c STRING` (#4416): prints $' +
# EVERY byte of the word as \ooo (exactly 3 octal digits) + '. `sudo -i` backslash-escapes all
# but [A-Za-z0-9_$-] and the login shell re-parses the words; printf %q and _shq lose words
# holding $ (or a newline), this form survives under bash and dash as that outer shell. The
# $'..' form is a bash extension: allowed only where the inner consumer is bash -c. Bytes, not
# characters: LC_ALL=C. (Documented sudo escaping applied by hand, not a run of real sudo.)
_oct_quote() { local s="$1" out="" i c o; local LC_ALL=C; for ((i=0;i<${#s};i++)); do c="${s:i:1}"; printf -v o '\\%03o' "'$c"; out+="$o"; done; printf "\$'%s'" "$out"; }

cmd_session() {
    local name="${1:-}"; shift || true
    [[ -z "$name" ]] && {
        echo "Usage: agentctl session <agent> [--platform <claude|codex>] [--no-share] [--cd <dir>] [--as-self] [--charge-file <file>] [...]" >&2
        echo >&2
        echo "  Claude executes directly. Codex ensures its managed app-server, then" >&2
        echo "  creates or attaches its one tmux TUI (agent-<name>) over that daemon." >&2
        echo "  Platform auto-detected from baked profile, then binary heuristic." >&2
        echo >&2
        echo "  --platform <claude|codex>  override auto-detected platform" >&2
        echo "  --no-share                 skip auto-share of cwd (agent runs from its own home)" >&2
        echo "  --cd <dir>                 use <dir> as project folder instead of caller's cwd" >&2
        echo "  --local                    (deprecated — no-op; agentctl selects the platform topology)" >&2
        echo "  --as-self                  skip the sudo/user-switch entirely; requires the" >&2
        echo "                             invoking user to already be the target agent (e.g." >&2
        echo "                             a systemd unit with User=agent-<name>, where sudo" >&2
        echo "                             is neither available nor needed). Loud error + exit 7" >&2
        echo "                             on user mismatch. Forces --no-share (ACL auto-share" >&2
        echo "                             needs sudo, unavailable under --as-self). An" >&2
        echo "                             explicit --cd IS honored (cd needs no sudo); only" >&2
        echo "                             the ACL auto-share is skipped." >&2
        echo "  --charge-file <file>       read <file> and append its content as the final" >&2
        echo "                             positional arg (the platform CLI's initial prompt)." >&2
        echo "                             Bypasses the alias-expansion transport, which cannot" >&2
        echo "                             carry multi-line text — THE way to pass a multi-line" >&2
        echo "                             boot charge (inline multi-line args are rejected)." >&2
        echo >&2
        echo "  Flag grammar:" >&2
        echo "    Single-dash: agentctl alias namespace.  -xyz is a bundle: -x -y -z" >&2
        echo "      expanded in char order.  Any unrecognized char → loud error, exit 6." >&2
        echo "      NO single-dash arg ever passes through (including -n, -e, etc.)." >&2
        echo "      Bare - (stdin) is a non-flag arg and passes through verbatim." >&2
        echo "    Double-dash: platform pass-through verbatim." >&2
        echo "    Non-flag args: pass through verbatim." >&2
        echo >&2
        echo "  Recognized single-char aliases:" >&2
        echo "    -c   claude: --continue" >&2
        echo "         codex:  resumes --last through the managed daemon; cannot combine with -d" >&2
        echo "    -d   claude: --dangerously-skip-permissions" >&2
        echo "         codex:  --dangerously-bypass-approvals-and-sandbox (new thread only; do not combine with -c)" >&2
        echo "    -r   claude: --remote-control <agent>" >&2
        echo "         codex:  ignored (no remote-control equivalent; use agentctl attach <agent>)" >&2
        exit 2
    }
    local user; user=$(resolve_user "$name")
    local platform_override=""
    local no_share=0
    local as_self=0
    local cd_override=""
    local charge_file=""
    local extra=()
    _parse_session_flags platform_override no_share as_self cd_override charge_file extra -- "$@" || exit $?

    # --charge-file: validate early (before any heavy lifting) so a bad path
    # fails loudly at launch time, not after platform detection. The CONTENT
    # is read late (just before exec) and appended directly to the platform
    # argv — it deliberately NEVER passes through _expand_session_args, whose
    # one-word-per-line transport cannot carry multi-line text (the guard
    # there rejects newline args; found live at the 2026-07-25 08:15
    # rehearsal, where the multi-line boot charge killed every agent launch).
    if [[ -n "$charge_file" ]]; then
        if [[ ! -r "$charge_file" ]]; then
            echo "ERROR: --charge-file '$charge_file' is not readable" >&2
            exit 1
        fi
    fi

    # Validate --platform early if provided (before any heavy lifting).
    if [[ -n "$platform_override" ]]; then
        case "$platform_override" in
            claude|codex) ;;
            *) echo "ERROR: --platform must be claude or codex (got '$platform_override')" >&2; exit 2 ;;
        esac
    fi

    # --as-self: skip the sudo/user-switch entirely. Requires the invoking
    # user to already BE the target agent (systemd unit with User=agent-<name>,
    # where sudo is neither available nor needed inside the unit). Loud error
    # + distinct exit code (7) on mismatch — never silently fall back to sudo.
    if [[ "$as_self" -eq 1 ]]; then
        _as_self_check "$user" || exit 7
        # ACL auto-share (below) shells out to `sudo agentctl share ...`; under
        # --as-self there is no sudo, so force the --no-share path rather than
        # attempt (and fail) an auto-share. Judgment call: --as-self implies
        # --no-share rather than requiring the caller to also pass --no-share.
        no_share=1
    fi

    # Project-dir propagation + auto-share. Design rationale (2026-05-03): the directory
    # where you type `agentctl session` becomes the agent's project folder by default.
    # We auto-grant rwX ACL so the agent can write inside it, then pass cwd as the
    # project dir to launchers. Claude organizes session JSONL by cwd
    # (~/.claude/projects/<encoded-cwd>/), so this also keeps --continue/--resume
    # scoped to the right project.
    #
    # Refused for: system paths, the operator home root, dotfile dirs (secrets), other
    # agents' homes. The agent's own home gets cwd propagation but no share
    # (already accessible). --no-share opts out entirely.
    local orig_cwd
    if [[ -n "$cd_override" ]]; then
        # Resolve to absolute path; fail loudly if the dir doesn't exist.
        orig_cwd=$(readlink -f "$cd_override" 2>/dev/null) || {
            echo "ERROR: --cd target '$cd_override' does not resolve" >&2; exit 1
        }
        [[ -d "$orig_cwd" ]] || { echo "ERROR: --cd target '$cd_override' is not a directory" >&2; exit 1; }
    else
        orig_cwd="$(pwd)"
    fi
    local cwd_arg=()
    if [[ $no_share -eq 1 ]]; then
        # An EXPLICIT --cd is still honored under --no-share/--as-self: cd-ing
        # needs no sudo and no ACL grant — only the auto-share is skipped.
        # (Previously --cd was silently ignored here, so --as-self boot
        # sessions always started in the systemd unit's cwd, i.e. /.)
        if [[ -n "$cd_override" ]]; then
            cwd_arg=("$orig_cwd")
            echo "(--no-share: honoring explicit --cd $orig_cwd; no ACL auto-share)" >&2
        else
            echo "(--no-share: agent runs from \$HOME; --continue/--resume may not see expected sessions)" >&2
        fi
    else
        case "$orig_cwd" in
            "/home/$user"|"/home/$user"/* )
                cwd_arg=("$orig_cwd")
                ;;
            /home/agent-*)
                echo "(cwd $orig_cwd is another agent's home; not auto-sharing — running from \$HOME)" >&2
                ;;
            "$HOME"|"$HOME"/.??*)
                echo "(cwd $orig_cwd is your home root or a dotfile dir; not auto-sharing — cd into a project subdirectory or use --no-share)" >&2
                ;;
            /|/etc*|/usr*|/var*|/sys*|/proc*|/dev*|/boot*|/root*|/opt*)
                echo "(refusing to auto-share system path $orig_cwd; running from \$HOME)" >&2
                ;;
            *)
                # Passive ACL check: skip share if agent already has w-permission via
                # the agents-group ACL. getfacl is readable by anyone with rX traversal,
                # no sudo needed.
                if getfacl -p -- "$orig_cwd" 2>/dev/null \
                   | grep -qE "^group:$user:.*[wW]" 2>/dev/null; then
                    cwd_arg=("$orig_cwd")
                else
                    echo "Granting $user rwX ACL on $orig_cwd (sudo may prompt for password)..."
                    local self="${BASH_SOURCE[0]:-$0}"
                    if sudo "$self" share "$name" "$orig_cwd" --mode rw; then
                        cwd_arg=("$orig_cwd")
                    else
                        echo "Auto-share failed; running from \$HOME — --continue/--resume may not see expected sessions." >&2
                    fi
                fi
                ;;
        esac
    fi

    # Detect platform and expand aliases.
    local platform
    platform=$(_session_platform "$platform_override" "$user" "$as_self") || {
        echo "ERROR: platform detection failed" >&2; exit 2
    }

    # Capture expansion via command substitution so the exit code propagates.
    # NOTE: process-substitution (`mapfile < <(cmd)`) always exits 0 — the
    # sub-shell's exit code is discarded, so an alias-expansion error would
    # print its message but continue into a bare session. Command substitution
    # (`var=$(cmd)`) DOES propagate the exit code; split into two steps to
    # preserve the one-word-per-line contract.
    local expanded_raw
    expanded_raw=$(_expand_session_args "$platform" "$name" "${extra[@]}") || {
        # _expand_session_args already printed the error to stderr.
        exit 2
    }
    local expanded=()
    [[ -n "$expanded_raw" ]] && mapfile -t expanded <<< "$expanded_raw"
    [[ ${#expanded[@]} -eq 0 ]] && { echo "ERROR: empty expansion from _expand_session_args" >&2; exit 2; }

    # expanded[0] is the binary (or "codex" for the resume subcommand transform);
    # expanded[1..] are the args (including subcommand words for codex resume).
    # Tail args = everything after the binary word.
    local binary="${expanded[0]:-$platform}"
    local tail_args=("${expanded[@]:1}")

    # --charge-file content rides OUTSIDE the expansion transport (see the
    # early validation above): read here, append as the final positional (the
    # platform CLI's initial prompt), byte-for-byte except trailing newlines
    # (stripped by command substitution — harmless for a prompt).
    if [[ -n "$charge_file" ]]; then
        local charge_content
        charge_content="$(cat "$charge_file")" || {
            echo "ERROR: failed to read --charge-file '$charge_file'" >&2
            exit 1
        }
        if [[ -z "$charge_content" ]]; then
            echo "ERROR: --charge-file '$charge_file' is empty" >&2
            exit 1
        fi
        tail_args+=("$charge_content")
    fi

    # Codex always enters the managed daemon + tmux topology. This branch must
    # stay before the direct launcher below: a local `codex` exec creates a
    # separate TUI/app-server and breaks same-thread wake delivery.
    if [[ "$platform" == "codex" ]]; then
        local self
        self="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
        local managed_args=(__codex-managed-session "$name")
        if [[ ${#cwd_arg[@]} -gt 0 ]]; then
            managed_args+=(--cwd "${cwd_arg[0]}")
        fi
        managed_args+=(-- "${tail_args[@]}")
        if [[ "$as_self" -eq 1 ]]; then
            exec "$self" "${managed_args[@]}"
        fi
        exec sudo -u "$user" -i "$self" "${managed_args[@]}"
    fi

    # Launch Claude directly. Codex returned above through its daemon-managed
    # tmux topology, so it cannot accidentally make a second local app server.
    # Under --as-self, the invoking shell already IS $user (verified above) —
    # no sudo/user-switch, just `exec` the platform binary in place. Same
    # argv construction (binary + tail_args) as the sudo path; only the
    # exec mechanism differs.
    local prologue
    prologue="$(session_prologue_text)"
    # #4435: every launch below execs through `agentctl __scope-exec <seat>`
    # (own scope, OOMPolicy=continue). The two words are inserted by THIS shell
    # with _oct_quote, so the string handed to `sudo -i bash -c` carries no
    # `{ } ( )` of its own (sudo -i escapes braces and parens).
    local agentctl_abs scope_words
    agentctl_abs="$(readlink -f "${BASH_SOURCE[0]:-$0}")" && [[ -f "$agentctl_abs" && -x "$agentctl_abs" ]] || {
        echo "ERROR: cannot resolve agentctl's own path to an executable file (needed for the scope launch)" >&2
        exit 1
    }
    # Built once, used by every launch below. Safe in both branches: as-self it is one argv word
    # to `exec bash -c` (no rejoin); under sudo -i the words are rejoined and re-parsed, and the
    # octal form survives that. The inner consumer is bash -c, so the $'..' form (a bash
    # extension) is allowed here (#4416).
    scope_words="$(_oct_quote "$agentctl_abs") __scope-exec $(_oct_quote "$name")"
    if [[ "$as_self" -eq 1 ]]; then
        # This shell already IS the target user, so no sudo -- but the launch
        # goes through the SAME form as the sudo branches below (bash -c,
        # prologue first): a fresh bash child, without agentctl's
        # `set -euo pipefail` and without its variable namespace (binary,
        # user, tail_args, cwd_arg). A boot-env line that references an unset
        # variable or returns non-zero therefore cannot abort the launch, and
        # the sourced file cannot clobber agentctl's locals. The execution
        # context (not only the text) is identical to the sudo branches.
        # Behaviour change worth knowing: binary/adapter SELECTION below
        # (`command -v "$binary"`, `-x "$HOME/.runtime/start.sh"`) uses the
        # pre-prologue PATH and HOME of the invoking shell, while the child
        # re-resolves `exec "$binary"` after boot-env ran. That matches the
        # sudo branches, where the check runs in `sudo -i bash -c` and the
        # exec comes after the prologue.
        if command -v "$binary" >/dev/null 2>&1; then
            if [[ ${#cwd_arg[@]} -gt 0 ]]; then
                exec bash -c \
                    "$prologue; cd $(printf '%q' "${cwd_arg[0]}") && exec $scope_words \"$binary\" \"\$@\"" \
                    -- "${tail_args[@]}"
            else
                exec bash -c \
                    "$prologue; exec $scope_words \"$binary\" \"\$@\"" \
                    -- "${tail_args[@]}"
            fi
        elif [[ -x "$HOME/.runtime/start.sh" ]]; then
            if [[ ${#cwd_arg[@]} -gt 0 ]]; then
                exec bash -c \
                    "$prologue; cd $(printf '%q' "${cwd_arg[0]}") && exec $scope_words ~/.runtime/start.sh \"\$@\"" \
                    -- "${tail_args[@]}"
            else
                exec bash -c \
                    "$prologue; exec $scope_words "'~/.runtime/start.sh "$@"' \
                    -- "${tail_args[@]}"
            fi
        else
            echo "ERROR: no $binary on PATH for $user (as-self) and no ~/.runtime/start.sh adapter" >&2
            exit 1
        fi
    elif sudo -u "$user" -i bash -c "command -v \"$binary\"" >/dev/null 2>&1; then
        if [[ ${#cwd_arg[@]} -gt 0 ]]; then
            # inner consumer is bash -c: the octal $'..' cd word is a bash extension; that is why it is allowed here (#4416)
            sudo -u "$user" -i bash -c \
                "$prologue; cd $(_oct_quote "${cwd_arg[0]}") && exec $scope_words \"$binary\" \"\$@\"" \
                -- "${tail_args[@]}"
        else
            sudo -u "$user" -i bash -c \
                "$prologue; exec $scope_words \"$binary\" \"\$@\"" \
                -- "${tail_args[@]}"
        fi
    elif sudo -u "$user" -i bash -c 'test -x "$HOME/.runtime/start.sh"' 2>/dev/null; then
        # Fallback: ~/.runtime/start.sh adapter. Pass tail args only (not the
        # base binary word — the adapter knows what to launch).
        if [[ ${#cwd_arg[@]} -gt 0 ]]; then
            # inner consumer is bash -c: the octal $'..' cd word is a bash extension; that is why it is allowed here (#4416)
            sudo -u "$user" -i bash -c \
                "$prologue; cd $(_oct_quote "${cwd_arg[0]}") && exec $scope_words ~/.runtime/start.sh \"\$@\"" \
                -- "${tail_args[@]}"
        else
            sudo -u "$user" -i bash -c \
                "$prologue; exec $scope_words "'~/.runtime/start.sh "$@"' \
                -- "${tail_args[@]}"
        fi
    else
        echo "ERROR: no $binary on PATH for $user and no ~/.runtime/start.sh adapter" >&2
        exit 1
    fi
}

cmd_bash() {
    local name="${1:-}"
    [[ -z "$name" ]] && { echo "Usage: agentctl bash <agent>" >&2; exit 2; }
    local user; user=$(resolve_user "$name")
    sudo -u "$user" -i
}

# attach: connect the operator's terminal to the agent's tmux session
# (boot-time auto-start sessions live in tmux named agent-<name>). The tmux
# socket is per-user, so the client must run AS the agent user — hence sudo.
# Detaching (Ctrl-b d, or closing the terminal) leaves the session running;
# only exiting the CLI inside ends it.
cmd_attach() {
    local name="${1:-}"; shift || true
    [[ -z "$name" ]] && { echo "Usage: agentctl attach <agent> [-r]" >&2; exit 2; }
    local ro=()
    if [[ "${1:-}" == "-r" ]]; then ro=(-r); shift; fi
    [[ $# -gt 0 ]] && { echo "ERROR: unknown extra args: $*" >&2; exit 2; }
    local user; user=$(resolve_user "$name")
    local tmux_session="agent-${name}"
    if ! sudo -u "$user" tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo "ERROR: no tmux session '$tmux_session' for $user." >&2
        echo "       Running sessions: " >&2
        sudo -u "$user" tmux ls 2>&1 | sed 's/^/         /' >&2 || true
        echo "       (Boot-time sessions appear after the agent-sessions timer fires," >&2
        echo "        or start one: sudo systemctl restart agent-session@${name}.service)" >&2
        exit 1
    fi
    exec sudo -u "$user" tmux attach -t "$tmux_session" "${ro[@]}"
}


# ---------- v0.3 spawn flow: spawn / finalize-name ----------
#
# Per active-work/spawn-implementation-2026-05-05.md (alpha repo) and
# Newborn-tag pattern: every freshly-spawned agent gets a placeholder uid
# agent-newborn-YYYYMMDDhhmmss until it picks its real name in first session.
# finalize-name then does the substrate rename in one shot — no general-purpose
# rename is provided (names are immutable post-finalize).

# ---- spawn --forum-url hint (#3563) ----
# agentctl runs as ROOT. Nothing derived from the URL is ever sourced, eval'd
# or executed here; it is only compared, measured and written as one line of
# data. The full URL validation happens later, in the seat, by set_forum_url.py.

# _forum_hint_url_problem <url>: prints the reason and returns 1 when the value
# is not an acceptable hint; returns 0 silently when it is. Deliberately only a
# minimal shape check: 1..2048 bytes, http:// or https://, no whitespace or
# control characters, no '@' (credentials never go in a hint), and none of the
# shell metacharacters  ` $ \ " ' ; & | < > ( ) { }
_forum_hint_url_problem() {
    local LC_ALL=C
    local url="$1"
    if [[ ${#url} -lt 1 || ${#url} -gt 2048 ]]; then
        echo "must be 1..2048 bytes long"; return 1
    fi
    case "$url" in
        http://?*|https://?*) ;;
        *) echo "must start with http:// or https://"; return 1 ;;
    esac
    case "$url" in
        *[[:space:][:cntrl:]]*) echo "must not contain whitespace or control characters"; return 1 ;;
    esac
    if [[ "$url" == *"@"* ]]; then
        echo "must not contain '@' (credentials never go in a hint)"; return 1
    fi
    local meta='`$\"'"'"';&|<>(){}'
    local i
    for ((i = 0; i < ${#meta}; i++)); do
        if [[ "$url" == *"${meta:i:1}"* ]]; then
            echo "must not contain the shell metacharacter '${meta:i:1}'"; return 1
        fi
    done
    return 0
}

# _write_forum_hint <home> <user> <group> <url>
# Leaves <home>/.engram/forum-url.hint: exactly one line (the URL), mode 0600, owned by
# <user>. EVERY write runs AS <user> (`sudo -u`), never as root: root only measures
# (a link, a directory, an owner, an existing name). Never overwrites and never follows
# a symlink: it refuses when .engram is not a real directory owned by <user>, or when
# the target path already exists in any form; the file is written under a temp name in
# the same directory, then PUBLISHED with a link(2)-style `ln temp final`, which fails
# when `final` exists (mv -n is not atomic against a racing create). Returns 0 on
# success; on any refusal or failure it prints a WARN naming the manual step and returns
# 1. The caller treats that as non-fatal: the newborn exists and is usable without a
# hint. The group argument is accepted for the caller's signature and unused: a file the
# newborn creates carries the newborn's own primary group.
_write_forum_hint() {
    local home="$1" newborn_user="$2" group="$3" url="$4"
    local dir="$home/.engram"
    local target="$dir/forum-url.hint"
    local tmp="" why=""
    local manual="to leave a hint by hand, write the URL as one line to $target as $newborn_user"

    if ! why="$(_forum_hint_url_problem "$url")"; then
        echo "WARN: forum-url.hint not written: URL $why; $manual" >&2
        return 1
    fi
    # The checks below read as root; the writes after them run as the newborn, so a
    # name the newborn swaps between a check and a write is the newborn's own tree and
    # nothing root writes can follow it. (This used to rest on "the account has no
    # running process yet", an assumption that stops holding the moment one starts;
    # the newborn identity makes it unnecessary.)
    if [[ -L "$home" || -L "$dir" || ! -d "$dir" ]]; then
        echo "WARN: forum-url.hint not written: $dir is not a real directory (symlink or missing); $manual" >&2
        return 1
    fi
    if [[ "$(stat -c %U "$dir" 2>/dev/null)" != "$newborn_user" ]]; then
        echo "WARN: forum-url.hint not written: $dir is not owned by $newborn_user; $manual" >&2
        return 1
    fi
    if [[ -e "$target" || -L "$target" ]]; then
        echo "WARN: forum-url.hint not written: $target already exists (a hint is never overwritten); $manual" >&2
        return 1
    fi

    tmp="$(sudo -u "$newborn_user" mktemp "$dir/.forum-url.hint.XXXXXX" 2>/dev/null)" || {
        echo "WARN: forum-url.hint not written: cannot create a temp file in $dir; $manual" >&2
        return 1
    }
    if ! { printf '%s\n' "$url" | sudo -u "$newborn_user" tee -- "$tmp" >/dev/null \
           && sudo -u "$newborn_user" chmod 0600 "$tmp"; } 2>/dev/null; then
        sudo -u "$newborn_user" rm -f -- "$tmp"
        echo "WARN: forum-url.hint not written: could not write the temp file in $dir; $manual" >&2
        return 1
    fi
    if ! sudo -u "$newborn_user" ln -- "$tmp" "$target" 2>/dev/null; then
        sudo -u "$newborn_user" rm -f -- "$tmp"
        echo "WARN: forum-url.hint not written: $target appeared first or cannot be linked (never overwritten); $manual" >&2
        return 1
    fi
    sudo -u "$newborn_user" rm -f -- "$tmp"
    return 0
}

cmd_spawn() {
    require_root "spawn"
    _state_dir_init || exit 1
    _require_viz_operator "spawn"

    local runtime="claude"
    local alpha_source=""
    local bootstrap_path="/usr/local/sbin/agent-bootstrap"
    local forum_url="" forum_url_given=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --forum-url|--forum-url=*)
                if [[ $forum_url_given -eq 1 ]]; then
                    echo "ERROR: --forum-url given more than once" >&2; exit 2
                fi
                forum_url_given=1
                if [[ "$1" == --forum-url=* ]]; then
                    forum_url="${1#--forum-url=}"; shift
                else
                    if [[ $# -lt 2 ]]; then
                        echo "ERROR: --forum-url requires a value" >&2; exit 2
                    fi
                    forum_url="$2"; shift 2
                fi
                ;;
            --runtime)          runtime="$2"; shift 2 ;;
            --runtime=*)        runtime="${1#--runtime=}"; shift ;;
            --alpha-source)     alpha_source="$2"; shift 2 ;;
            --alpha-source=*)   alpha_source="${1#--alpha-source=}"; shift ;;
            --bootstrap-path)   bootstrap_path="$2"; shift 2 ;;
            --bootstrap-path=*) bootstrap_path="${1#--bootstrap-path=}"; shift ;;
            *) echo "ERROR: unknown flag '$1'" >&2; exit 2 ;;
        esac
    done

    # Early, minimal shape check of the hint URL, BEFORE any side effect (the
    # user is created further down). Not the full validation: set_forum_url.py
    # does that when the seat writes the key.
    if [[ $forum_url_given -eq 1 ]]; then
        local forum_url_why
        if ! forum_url_why="$(_forum_hint_url_problem "$forum_url")"; then
            echo "ERROR: --forum-url $forum_url_why" >&2
            exit 2
        fi
    fi

    if [[ ! -x "$bootstrap_path" ]]; then
        echo "ERROR: agent-bootstrap not found at $bootstrap_path" >&2
        echo "       Install it from engram-alpha:" >&2
        echo "         sudo cp <engram-alpha-checkout>/tools/agent-bootstrap \\" >&2
        echo "             $bootstrap_path && sudo chmod 0755 $bootstrap_path" >&2
        exit 1
    fi

    # v0.1: claude only. Multi-runtime support (gemini-cli, codex) is
    # forthcoming as a separate epic with proper per-runtime test
    # fixtures and end-to-end validation. Until then, agentctl spawn
    # rejects non-claude runtime rather than half-supporting (the
    # silent-corruption pattern that prompted this scope decision per
    # the spawn-implementation PR review of 2026-05-05).
    if [[ "$runtime" != "claude" ]]; then
        echo "ERROR: agentctl spawn v0.1 supports --runtime=claude only." >&2
        echo "       Multi-runtime (gemini-cli, codex) is forthcoming as a separate epic." >&2
        echo "       See ask-lei.md for the v0.2 multi-runtime ticket; until then, --runtime=claude only." >&2
        exit 2
    fi

    # Newborn placeholder name: agent-newborn-YYYYMMDDhhmmss (UTC).
    # Fits in the 32-char Linux username limit (28 chars used).
    local newborn_tag; newborn_tag="newborn-$(date -u +%Y%m%d%H%M%S)"
    local user_name="agent-$newborn_tag"

    if id "$user_name" >/dev/null 2>&1; then
        echo "ERROR: user $user_name already exists (newborn-timestamp clash?)" >&2
        echo "       This is extremely unlikely; verify with 'id $user_name' and retry." >&2
        exit 1
    fi

    echo "== agentctl spawn =="
    echo "  Newborn name:   $user_name"
    echo "  Runtime:        $runtime"
    echo "  Bootstrap:      $bootstrap_path"
    if [[ -n "$alpha_source" ]]; then
        echo "  Alpha source:   $alpha_source (overridden)"
    else
        echo "  Alpha source:   (auto-detected by agent-bootstrap)"
    fi
    echo

    # Multi-tenant defaults: agentctl spawn always creates an agent
    # destined for a host shared with other agents (that's the whole point of agentctl).
    # Override agent-bootstrap's solo-safe defaults:
    #   --home-mode 0750: group-traversable so the operator + peer agents in
    #                     `agents` can `cd` into the new home.
    # The post-bootstrap chgrp below sets the home's group to `agents`
    # so the 0750 group-bit actually grants traversal to the other
    # agents (otherwise the group is the per-user group, no peer access).
    # Matches the historical pattern for agent-borges + agent-mneme.
    local bootstrap_args=("$newborn_tag" "--runtime" "$runtime" "--home-mode" "0750")
    [[ -n "$alpha_source" ]] && bootstrap_args+=("--alpha-source" "$alpha_source")
    # agent-bootstrap now runs tools/install.sh as the newborn (#4097). agentctl spawn had no
    # tier of its own, so it names one: `dev` (the shared hosts' working tier).
    # --forum-url is passed only when the operator gave one (agentctl has no other source of a
    # host forum URL).
    bootstrap_args+=("--tier" "dev")
    [[ $forum_url_given -eq 1 ]] && bootstrap_args+=("--forum-url" "$forum_url")

    # Delegate substrate setup. agent-bootstrap prints its own next-steps
    # block; we add a spawn-specific finalize-name reminder below.
    "$bootstrap_path" "${bootstrap_args[@]}"

    # Re-group the new home to `agents` so peers (and the operator) in the
    # `agents` group can traverse via the 0750 group-bit above. The
    # bootstrap's final chown sets the home's group to the per-user
    # group; this undoes that for the top-level home only (inner
    # files stay per-user-group as bootstrap configured).
    chgrp agents "/home/agent-$newborn_tag" 2>/dev/null || \
        echo "WARN: chgrp agents /home/agent-$newborn_tag failed; the operator may not be able to traverse the new home." >&2

    # Leave the forum-url hint (only when --forum-url was passed). Non-fatal:
    # a failure is a WARN with the manual step, never a failed spawn.
    local forum_hint="no"
    if [[ $forum_url_given -eq 1 ]]; then
        local newborn_group
        newborn_group="$(id -gn "$user_name" 2>/dev/null)" || newborn_group="$user_name"
        if _write_forum_hint "/home/agent-$newborn_tag" "$user_name" "$newborn_group" "$forum_url"; then
            forum_hint="yes"
        fi
    fi

    # Without --forum-url the audit line is exactly what it always was. With it,
    # the line records THAT a hint was left (yes|no), never the URL.
    local audit_extras="runtime=$runtime"
    [[ $forum_url_given -eq 1 ]] && audit_extras+=" forum_hint=$forum_hint"
    audit "spawn" "$newborn_tag" "newborn" "$audit_extras" || exit "$EXIT_ACTION_UNLOGGED"

    cat <<NEXT

== Spawn complete ==
The newborn is at $user_name. To complete the birth:

  1. Enter the newborn's bash login shell:
       agentctl bash $newborn_tag

  2. Start Claude Code and log in (Claude Code and ENGRAM were installed
     during spawn, in the newborn's own home):
       claude                 # then /login at the first prompt

  3. The naming dialogue: the SessionStart hook fires engram-first-session;
     the agent generates 3 candidate names; you pick collaboratively.

  4. From the operator's shell (NOT inside the newborn shell), finalize the rename:
       sudo agentctl finalize-name $newborn_tag <chosen-name>

To abandon a newborn before finalize-name (simple cleanup):
  sudo userdel -r $user_name
NEXT
    if [[ "$forum_hint" == "yes" ]]; then
        echo "A forum URL hint was left at /home/agent-$newborn_tag/.engram/forum-url.hint; the first-session will offer it as the default answer (the user still confirms)."
    fi
}

cmd_finalize_name() {
    require_root "finalize-name"
    _state_dir_init || exit 1
    _shared_dir_sticky_check "$SHARED_ROOT/health" || exit 1
    _require_viz_operator "finalize-name"

    local newborn_tag="${1:-}"; shift || true
    local chosen="${1:-}"; shift || true
    [[ -z "$newborn_tag" || -z "$chosen" ]] && {
        echo "Usage: sudo agentctl finalize-name <newborn-id> <chosen-name>" >&2
        echo "  Example: sudo agentctl finalize-name newborn-20260505083012 ada" >&2
        exit 2
    }

    # Refuse anything that isn't the newborn-tag pattern. This command is
    # first-session-only — names are immutable post-finalize.
    if [[ ! "$newborn_tag" =~ ^newborn-[0-9]{14}$ ]]; then
        echo "ERROR: '$newborn_tag' doesn't match the newborn-YYYYMMDDhhmmss pattern." >&2
        echo "       finalize-name is for the spawn flow only — it refuses general renames." >&2
        echo "       Names are immutable after first session." >&2
        exit 1
    fi

    # Normalize + validate the chosen name via the shared helper.
    # The agent's identity/display name (in ENGRAM, CLAUDE.md) is separate
    # and set during the naming dialogue — finalize-name only does the uid/path
    # rename, so POSIX lowercase is enforced on the username, not the identity.
    # _normalize_chosen_name updates $chosen in-place and prints a Note to stdout
    # if the name was case-normalized; exits 1 on invalid input.
    local chosen_input="$chosen"
    _normalize_chosen_name chosen "$chosen_input"

    local newborn_user="agent-$newborn_tag"
    local chosen_user="agent-$chosen"
    local newborn_home="/home/$newborn_user"
    local chosen_home="/home/$chosen_user"

    # Validate identities
    if ! id "$newborn_user" >/dev/null 2>&1; then
        echo "ERROR: newborn $newborn_user does not exist" >&2
        exit 1
    fi
    if id "$chosen_user" >/dev/null 2>&1; then
        echo "ERROR: chosen name '$chosen_user' is already taken" >&2
        exit 1
    fi

    # Refuse a planted health entry BEFORE any account change; the same check
    # runs again right before the rename.
    if [[ -L "$SHARED_ROOT/health/$newborn_tag" || -d "$SHARED_ROOT/health/$newborn_tag" ]]; then
        _health_rename_check "$SHARED_ROOT/health/$newborn_tag" "$SHARED_ROOT/health/$chosen" || exit 1
    fi

    echo "== agentctl finalize-name =="
    echo "  Newborn:  $newborn_user → $chosen_user"
    echo "  Home:     $newborn_home → $chosen_home"
    echo

    # Terminate any user-level systemd sessions, lingering background
    # processes, and ENGRAM daemons for the newborn. usermod -d -m
    # refuses to rename a user that has any process running under
    # that uid. The newborn's first claude session typically leaves
    # behind a user-level systemd (pid table shows `systemd --user`
    # + sd-pam) plus engram-surface-daemon — both must be cleared
    # before the rename can proceed. Best-effort, non-fatal if none
    # of these exist (fresh-from-spawn newborns may have nothing
    # running yet).
    echo "Step 1.5: terminating any running processes for $newborn_user..."
    loginctl disable-linger "$newborn_user" 2>/dev/null || true
    loginctl terminate-user "$newborn_user" 2>/dev/null || true
    sleep 1
    pkill -KILL -u "$newborn_user" 2>/dev/null || true
    sleep 1
    if pgrep -u "$newborn_user" >/dev/null 2>&1; then
        echo "WARN: some processes still running for $newborn_user after kill attempt; usermod may fail." >&2
        ps -fu "$newborn_user" >&2 || true
    fi

    # Substrate rename: usermod + groupmod + home dir move.
    echo "Step 2: usermod -l + -d -m + groupmod -n..."
    usermod -l "$chosen_user" -d "$chosen_home" -m "$newborn_user"
    groupmod -n "$chosen_user" "$newborn_user" 2>/dev/null || true

    # Claude Code project-dir rename. Claude stores session JSONLs at
    # ~/.claude/projects/<encoded-cwd>/<session-id>.jsonl where encoded-cwd
    # replaces / with -. After usermod, the home dir moved but the project
    # subfolder still encodes the OLD newborn path — so `claude --continue`
    # from the chosen home would look for -home-<chosen> and not find the
    # pre-finalize sessions. Rename subfolders that match the old prefix
    # so first-session continuity survives the rename.
    # JSONL contents themselves are left intact (historical record of the
    # newborn-phase work — accurate as it happened).
    echo "Step 2b: renaming ~/.claude/projects/ encoded-cwd subfolders..."
    local claude_projects="$chosen_home/.claude/projects"
    if [[ -d "$claude_projects" ]]; then
        local old_encoded="-home-${newborn_user}"
        local new_encoded="-home-${chosen_user}"
        for d in "$claude_projects"/*; do
            [[ -d "$d" ]] || continue
            local base; base=$(basename "$d")
            if [[ "$base" == "$old_encoded"* ]]; then
                local suffix="${base#$old_encoded}"
                local new_base="${new_encoded}${suffix}"
                # As the newborn, not root: the names under ~/.claude/projects are
                # the newborn's to create, replace or link (#4405).
                sudo -u "$chosen_user" mv "$d" "$claude_projects/$new_base"
                echo "  $base → $new_base"
            fi
        done
    fi

    # Post-rename path rewrite across all active-config files. After
    # usermod -d -m, multiple files in $chosen_home still reference
    # /home/<newborn>/... — they were written at install/first-session
    # time with the (then-correct) newborn path. Each layer fails its
    # own way:
    #   - .claude.json projects key → `claude --continue` returns "no
    #     sessions" (lookup by NEW cwd misses).
    #   - .claude.json mcpServers paths → ENOENT spawning MCP server,
    #     `/mcp` says "Failed to reconnect: ENOENT".
    #   - .claude/settings.json hook commands → UserPromptSubmit and
    #     other hooks print "/bin/sh: <newborn-path>: not found" on
    #     every prompt.
    #   - .claude/settings.local.json → additional settings.
    #   - .claude/CLAUDE.md → agent identity file path refs.
    #   - .codex/config.toml → ENOENT on codex startup (issue #825).
    #   - .engram/seed-manifest.json, .codex/rules/default.rules, etc.
    # History/record files (.jsonl, .log, .sql, graph_snapshot.md,
    # *-complete.json) are INTENTIONALLY left untouched — they are a
    # factual record of the newborn phase and must stay intact.
    # Binary files (knowledge.db, .pyc, images) are skipped — rewriting
    # binary content corrupts it.
    # Fix: exhaustively walk $chosen_home and text-substitute old_prefix
    # → new_prefix in every file that is NOT a record/binary, using an
    # empirically-derived skip-set (inline below — agentctl is a single
    # vendored file; the rewrite logic lives here, not in a sibling module).
    echo "Step 2c: rewriting stale newborn paths in all config/runtime files (exhaustive walk)..."
    # Substitute the user-name part (not just /home/<name>) so both
    # absolute-path form (/home/agent-newborn-XXX) AND encoded-cwd form
    # (-home-agent-newborn-XXX, inside .claude/projects/ encodings + bash
    # allowlist entries in settings.local.json) get rewritten.
    local old_path="$newborn_user"
    local new_path="$chosen_user"
    if sudo -u "$chosen_user" python3 - "$chosen_home" "$old_path" "$new_path" <<'PYTHON'
# === BEGIN finalize_name_rewrite (single source; tests/test_finalize_name_rewrite.py extracts between these sentinels) ===
import json
import os
import shutil
import sys
from pathlib import Path

# Reconfigure stdout to replace unencodable characters instead of raising.
# Covers the ✓ glyph in progress lines (and any future glyphs) when stdout
# is bound to an ASCII codec (e.g. LC_ALL=C with PEP 538 coercion disabled).
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(errors="replace")

# ---------------------------------------------------------------------------
# Skip-list constants  (empirically derived — do NOT loosen without a new sweep)
# ---------------------------------------------------------------------------

# Directory components: stop os.walk from descending into these.
# Rationale: binaries, bytecache, VCS, package caches, historical transcripts,
# periodic backup snapshots — descending is expensive and produces no rewrites
# we actually want.
_PRUNE_DIRS = frozenset({
    "venv",
    "__pycache__",
    ".git",
    "node_modules",
    "file-history",
    "sessions",
    "cron-backups",
})

# File extensions to skip entirely.
# .pyc       — compiled bytecode (binary, variable-length fields)
# .jsonl     — session/history transcripts (factual record of the newborn phase)
# .log       — log files (factual record)
# .sql       — e.g. knowledge.sql; the ENGRAM graph DUMP.  It regenerates from
#              knowledge.db on the next nap/checkpoint, AND may contain node
#              text that legitimately references the newborn home as accurate
#              history — must not be rewritten.
# .bak       — existing backups (don't rewrite our own safety copies)
_SKIP_EXTENSIONS = frozenset({
    ".pyc",
    ".jsonl",
    ".log",
    ".sql",
    ".bak",
})

# Exact filenames to skip (base name only, no directory component).
# graph_snapshot.md      — regenerable summary snapshot
# history.jsonl          — handled by extension, but listed explicitly for clarity
# knowledge.db           — SQLite binary
# knowledge.db-wal       — WAL journal (binary)
# knowledge.db-shm       — shared-memory file (binary)
_SKIP_NAMES = frozenset({
    "graph_snapshot.md",
    "history.jsonl",
    "knowledge.db",
    "knowledge.db-wal",
    "knowledge.db-shm",
})

# Suffix patterns for endswith checks.
# *-complete.json — e.g. finalize-name-complete.json: the rename AUDIT record.
#   Rewriting agent-newborn-<ts>→<chosen> inside it would make it falsely read
#   "from=<chosen> to=<chosen>", corrupting the record of what the rename did.
# *.bak-prefinalize — our own pre-write backup copies (never rewrite the safety
#   copy). Note: Path.suffix on "foo.bak-prefinalize" is ".bak-prefinalize",
#   not ".bak" — so these are caught by this endswith check, not the _SKIP_EXTENSIONS
#   ".bak" entry (which catches plain ".bak" files only).
_SKIP_SUFFIXES = (
    "-complete.json",
    ".bak-prefinalize",
)

_BINARY_PROBE_BYTES = 8192  # how many bytes to read for NUL-byte detection


def _is_binary(path):
    """Return True if the file appears to be binary (NUL byte in first 8KB)."""
    try:
        with path.open("rb") as fh:
            chunk = fh.read(_BINARY_PROBE_BYTES)
        return b"\x00" in chunk
    except OSError:
        return True  # unreadable → treat as binary, skip safely


def _should_skip(path):
    """Return (skip, reason) for a candidate file.

    Reasons are human-readable labels for the skip-count report.
    'record'  — a factual record/log/dump/audit file (must stay intact)
    'binary'  — binary file (rewriting would corrupt it)
    '(rewrite)' — not skipped; caller should rewrite
    """
    name = path.name
    suffix = path.suffix.lower()

    # Exact-name check first (fastest)
    if name in _SKIP_NAMES:
        return True, "record"

    # Suffix-pattern check
    for pat in _SKIP_SUFFIXES:
        if name.endswith(pat):
            return True, "record"

    # Extension check
    if suffix in _SKIP_EXTENSIONS:
        return True, "record"

    # Binary probe (belt-and-suspenders; catches knowledge.db, .pyc stragglers,
    # images, etc. even if they somehow aren't under a pruned dir)
    if _is_binary(path):
        return True, "binary"

    return False, "(rewrite)"


def _try_toml_validate(text, path):
    """Attempt TOML validation; return True if valid or tomllib unavailable."""
    try:
        import tomllib  # stdlib Python 3.11+
    except ImportError:
        return True  # graceful skip — no third-party dep added
    try:
        tomllib.loads(text)
        return True
    except tomllib.TOMLDecodeError as e:
        print(
            f"  ERROR: rewrite would invalidate TOML in {path}: {e}",
            file=sys.stderr,
        )
        print(
            f"         pre-write copy at {path}.bak-prefinalize left intact",
            file=sys.stderr,
        )
        return False


def rewrite_tree(home, old_prefix, new_prefix):
    """Walk *home* and rewrite every text config file that contains *old_prefix*.

    Parameters
    ----------
    home        Absolute path of the agent's home directory (string or Path).
    old_prefix  The old newborn username token, e.g. ``agent-newborn-20260604123456``.
                Matches BOTH ``/home/agent-newborn-<ts>`` (absolute-path form) and
                ``-home-agent-newborn-<ts>`` (encoded-cwd form in
                ``.claude/projects/``), because the substring covers both.
    new_prefix  The chosen username token, e.g. ``agent-ada``.

    Returns
    -------
    dict with keys ``touched`` (int), ``total`` (int), ``skipped_record`` (int).

    Raises
    ------
    SystemExit(1)  if a JSON or TOML file fails to validate after rewrite
                   (the ``.bak-prefinalize`` pre-write copy is left intact;
                   the file itself is NOT overwritten on validation failure).
    """
    home_path = Path(home)
    total = 0
    touched = 0
    skipped_record = 0
    skipped_utf8 = 0

    for dirpath, dirs, files in os.walk(home_path):
        # Prune directories in-place so os.walk doesn't descend into them.
        dirs[:] = [d for d in dirs if d not in _PRUNE_DIRS]

        for fname in files:
            p = Path(dirpath) / fname

            skip, reason = _should_skip(p)
            if skip:
                if reason == "record":
                    skipped_record += 1
                # binary skips are not counted in skipped_record (different category)
                continue

            # Read as strict UTF-8; skip on decode error (invalid-UTF-8 file
            # with no NUL bytes would pass _is_binary but silently corrupt on
            # rewrite via U+FFFD substitution — skip it instead).
            # Also skip on OSError (permissions, dangling symlink, etc.)
            try:
                text = p.read_text(encoding="utf-8", errors="strict")
            except UnicodeDecodeError:
                skipped_utf8 += 1
                continue
            except OSError:
                continue

            count = text.count(old_prefix)
            if count == 0:
                continue

            # Backup before any write (pre-write copy; original stays in .bak-prefinalize)
            bak = Path(str(p) + ".bak-prefinalize")
            shutil.copy2(p, bak)

            new_text = text.replace(old_prefix, new_prefix)

            # Validate JSON files post-rewrite (before overwriting)
            if p.suffix.lower() == ".json":
                try:
                    json.loads(new_text)
                except json.JSONDecodeError as e:
                    print(
                        f"  ERROR: rewrite would invalidate JSON in {p}: {e}",
                        file=sys.stderr,
                    )
                    print(
                        f"         pre-write copy at {bak} left intact",
                        file=sys.stderr,
                    )
                    sys.exit(1)

            # Validate TOML files post-rewrite (best-effort; py3.11+ stdlib)
            if p.suffix.lower() == ".toml":
                if not _try_toml_validate(new_text, p):
                    sys.exit(1)

            p.write_text(new_text, encoding="utf-8")
            total += count
            touched += 1
            print(f"  ✓ {p.name}: {count} occurrences rewritten")

    return {"touched": touched, "total": total, "skipped_record": skipped_record, "skipped_utf8": skipped_utf8}


