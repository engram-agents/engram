# ---------- v0.1 broker: share / unshare / share-status ----------
#
# Mechanism: POSIX ACLs (setfacl/getfacl). Compatible with several agents (each agent
# has its own ACL entry on the path), TTL-revocable, audit-logged. State lives
# at $AGENTCTL_STATE/share-state/<agent>.json; audit at $AGENTCTL_STATE/share-log
# (root-only, never under the agent-writable $SHARED_ROOT; engram-alpha#4405).

# _state_dir_ok: PURE predicate, no filesystem. 0 only for a non-link directory
# owned by <expected_uid> with no group or other write. Same family as
# _viz_operator_conf_provenance_ok above. Every input must be numeric (is_dir and
# is_link are 0/1); anything else is a refusal.
#
# Usage: _state_dir_ok <uid> <octal_mode> <is_dir> <is_link> <expected_uid>
_state_dir_ok() {
    local uid="${1:-}" mode="${2:-}" is_dir="${3:-}" is_link="${4:-}" expected="${5:-}"
    [[ "$uid" =~ ^[0-9]+$ ]] || return 1
    [[ "$mode" =~ ^[0-7]+$ ]] || return 1
    [[ "$is_dir" =~ ^[01]$ ]] || return 1
    [[ "$is_link" =~ ^[01]$ ]] || return 1
    [[ "$expected" =~ ^[0-9]+$ ]] || return 1
    (( is_link == 0 )) || return 1
    (( is_dir == 1 )) || return 1
    (( uid == expected )) || return 1
    (( (8#$mode) & 8#022 )) && return 1
    return 0
}

# _state_dir_check: measure <path> and apply _state_dir_ok with the LITERAL uid 0
# (never the caller's own uid: that would be satisfied by whoever runs it, not by
# the directory's real owner). `[[ -L ]]` is read FIRST and is the only source of
# the link verdict, because `-d` and `stat -L` both answer through a link. On
# failure: one stderr line naming the path, what was found and the exact sudo
# command that repairs it; non-zero. No fallback path.
_state_dir_check() {
    local path="$1" kind="${2:-state}" is_link=0 is_dir=0 uid="" mode="" st
    [[ -L "$path" ]] && is_link=1
    if st="$(stat -L -c '%u %a' -- "$path" 2>/dev/null)"; then
        read -r uid mode <<< "$st"
        [[ -d "$path" ]] && is_dir=1
    elif (( is_link )); then
        uid=0; mode=0   # a dangling link: reported as a link below
    elif [[ "$kind" == parent ]]; then
        echo "ERROR: $path (the parent of the state directory, a system directory) does not exist. Investigate before running this verb again: the host layout is not what agentctl expects, and no repair is suggested for a system directory." >&2
        return 1
    else
        echo "ERROR: $path does not exist. Fix: sudo install -d -m 0755 -o root -g root $path" >&2
        return 1
    fi
    if _state_dir_ok "$uid" "$mode" "$is_dir" "$is_link" 0; then
        return 0
    fi
    if [[ "$kind" == parent ]]; then
        local what="owner uid $uid, mode $mode"
        (( is_link )) && what="a symbolic link"
        (( ! is_link && ! is_dir )) && what="not a directory"
        echo "ERROR: $path (the parent of the state directory, a system directory) must be a real directory owned by root (uid 0) with no group or other write; found $what. Investigate who changed it and why before running this verb again; it is a system directory, so no repair is suggested here." >&2
        return 1
    fi
    local fix="sudo chown root:root $path && sudo chmod 0755 $path" found="owner uid $uid, mode $mode"
    if (( is_link )); then
        found="a symbolic link"
        fix="inspect it, then: sudo rm -- $path && sudo install -d -m 0755 -o root -g root $path"
    elif (( ! is_dir )); then
        found="not a directory"
        fix="inspect it, then: sudo mv -- $path $path.bad && sudo install -d -m 0755 -o root -g root $path"
    fi
    echo "ERROR: $path must be a real directory owned by root (uid 0) with no group or other write; found $found. Fix: $fix" >&2
    return 1
}

# _state_dir_init: called ONLY from the gate at the top of the four root verbs.
# Verifies the PARENT is itself a root-owned, non-link, non-group/other-writable
# directory, creates a missing state directory with `mkdir -m 0755` (no -p, so a
# name that appeared meanwhile is a loud EEXIST, never a followed path), then
# checks the result. Never chmods an existing path.
_state_dir_init() {
    local parent d
    parent="$(dirname "$AGENTCTL_STATE")"
    _state_dir_check "$parent" parent || return 1
    for d in "$AGENTCTL_STATE" "$AGENTCTL_STATE/share-state"; do
        if [[ ! -e "$d" && ! -L "$d" ]]; then
            mkdir -m 0755 "$d" || { echo "ERROR: could not create $d" >&2; return 1; }
        fi
        _state_dir_check "$d" || return 1
    done
}

# _shared_dir_sticky_ok: PURE predicate for the community health directory. 0 only
# for a non-link directory owned by <expected_uid> with the sticky bit set.
#
# Usage: _shared_dir_sticky_ok <uid> <octal_mode> <is_dir> <is_link> <expected_uid>
_shared_dir_sticky_ok() {
    local uid="${1:-}" mode="${2:-}" is_dir="${3:-}" is_link="${4:-}" expected="${5:-}"
    [[ "$uid" =~ ^[0-9]+$ ]] || return 1
    [[ "$mode" =~ ^[0-7]+$ ]] || return 1
    [[ "$is_dir" =~ ^[01]$ ]] || return 1
    [[ "$is_link" =~ ^[01]$ ]] || return 1
    [[ "$expected" =~ ^[0-9]+$ ]] || return 1
    (( is_link == 0 )) || return 1
    (( is_dir == 1 )) || return 1
    (( uid == expected )) || return 1
    (( (8#$mode) & 8#1000 )) || return 1
    return 0
}

# _shared_dir_sticky_check: the wrapper. The sticky bit is what makes the later
# `[[ -L ]]` test on an entry of this directory meaningful: without it an agent can
# swap the entry between the test and the rename. The repair keeps the real mode
# (setgid included) and adds only the sticky bit.
_shared_dir_sticky_check() {
    local path="$1" is_link=0 is_dir=0 uid="" mode="" st
    [[ -L "$path" ]] && is_link=1
    if st="$(stat -L -c '%u %a' -- "$path" 2>/dev/null)"; then
        read -r uid mode <<< "$st"
        [[ -d "$path" ]] && is_dir=1
    else
        echo "ERROR: $path is missing or unreadable; finalize-name needs the community health directory (root-owned, sticky)." >&2
        return 1
    fi
    if _shared_dir_sticky_ok "$uid" "$mode" "$is_dir" "$is_link" 0; then
        return 0
    fi
    local newmode; newmode="$(printf '%o' $(( 8#$mode | 8#1000 )))"
    echo "ERROR: $path must be a real directory owned by root (uid 0) with the sticky bit; found uid $uid, mode $mode, link=$is_link, directory=$is_dir. Fix (keeps the setgid bit): sudo chown root:agents $path && sudo chmod $newmode $path" >&2
    return 1
}

# _health_rename_check: refuse a health rename that would follow a link or move a
# directory INSIDE an existing one (`mv A B` into an existing B puts A inside it).
# The `-L` test is only meaningful because the sticky gate on the health
# directory holds (an agent cannot swap or unlink the entry of another account).
_health_rename_check() {
    local src="$1" dest="$2"
    if [[ -L "$src" ]]; then
        echo "ERROR: $src is a symbolic link; refusing to rename or chown it." >&2
        return 1
    fi
    if [[ -e "$dest" || -L "$dest" ]]; then
        echo "ERROR: $dest already exists; refusing to rename $src onto or into it." >&2
        return 1
    fi
    return 0
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "ERROR: '$1' requires sudo (modifies ACLs)" >&2
        echo "Try: sudo $0 $1 ..." >&2
        exit 1
    fi
}

audit() {
    local action="$1"; local agent="$2"; local path="$3"; local extras="${4:-}"
    local stamp; stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    # The action has already happened by the time this runs; a failure here is a
    # loud logged error, never a silent success. No mkdir, chgrp or chmod: the
    # directory and its modes were set once, by _state_dir_init.
    if ! _state_dir_check "$AGENTCTL_STATE"; then
        echo "ERROR: $action happened but could not be logged (state directory failed its check). Exit code $EXIT_ACTION_UNLOGGED: the action is DONE; do not repeat it, repair the state directory and add the log line by hand." >&2
        return 1
    fi
    ( umask 022; echo "$stamp $action ${SUDO_USER:-$(id -un)}→$agent path=$path${extras:+ $extras}" >> "$AGENTCTL_STATE/share-log" ) \
        || { echo "ERROR: $action happened but could not be logged (write to $AGENTCTL_STATE/share-log failed). Exit code $EXIT_ACTION_UNLOGGED: the action is DONE; do not repeat it, repair the state directory and add the log line by hand." >&2; return 1; }
}

# _acl_has <path> <key>: 0 when `getfacl -p` prints a line that starts <key>: (for
# example group:agent-x, or default:group:agent-x) for <path> ITSELF, 1 when it does not,
# 2 when getfacl could not read it. The listing is captured first, never piped into
# `grep -q` (under pipefail an early-exiting grep reads a long listing as a failure).
# A read that FAILED is not an absence: callers treat 2 as a refusal either way.
_acl_has() {
    local out line
    out="$(getfacl -p -- "$1" 2>/dev/null)" || return 2
    while IFS= read -r line; do
        [[ "$line" == "$2":* ]] && return 0
    done <<< "$out"
    return 1
}

# _ttl_job_undo <job>: a share whose removal job was queued did not happen after all, so
# take the job back out, or say that it remains. Nothing queued (empty <job>): nothing to do.
_ttl_job_undo() {
    local job="${1:-}"
    [[ -n "$job" ]] || return 0
    if [[ "$job" != unknown ]] && atrm "$job" 2>/dev/null; then
        echo "  the queued auto-unshare job $job was removed" >&2
    else
        echo "  WARNING: queued auto-unshare job $job remains (atrm failed or the id is unknown): the share did not happen, so the job will run 'unshare' for nothing; list it with atq and remove it with atrm" >&2
    fi
}

cmd_share() {
    local agent="${1:-}"; shift || true
    local path="${1:-}"; shift || true
    local mode="rw"
    local ttl="" ttl_given=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mode) mode="${2:-}"; shift 2 ;;
            --ttl)  ttl="${2:-}"; ttl_given=1; shift 2 ;;
            *) echo "ERROR: unknown flag '$1'" >&2; exit 2 ;;
        esac
    done
    [[ -z "$agent" || -z "$path" ]] && {
        echo "Usage: sudo agentctl share <agent> <path> [--mode rw|ro] [--ttl <duration>]" >&2; exit 2
    }
    require_root share
    _state_dir_init || exit 1
    local user; user=$(resolve_user "$agent")
    [[ -e "$path" ]] || { echo "ERROR: path '$path' does not exist" >&2; exit 1; }
    path=$(readlink -f "$path")
    # Residual, not a guard: $path is operator-chosen and was just resolved by
    # readlink -f, so this -L test is a check-then-use gap (the path can change
    # between here and the setfacl calls below). The LEAF is closed by -P on every
    # recursive call plus the read-back below; a swapped MIDDLE component (a parent
    # of $path replaced by a link) stays open and is not closed here (engram-alpha#4405).
    [[ -L "$path" ]] && { echo "ERROR: '$path' is a symbolic link; refusing to set ACLs through it" >&2; exit 1; }
    # setfacl -R -P on a link WITH a trailing slash acts on the link's target (setfacl
    # 2.3.2, measured). readlink -f never prints one; every argument below is that
    # result, so a trailing slash here means something other than readlink answered.
    [[ "$path" != "/" && "$path" == */ ]] && { echo "ERROR: '$path' ends in a trailing slash after resolution; refusing: a recursive ACL call on a link with a trailing slash acts on the link's target" >&2; exit 1; }

    case "$path" in
        /etc/*|/usr/*|/var/*|/sys/*|/proc/*|/dev/*|/boot/*|/root/*|/etc|/usr|/var|/root|/)
            echo "ERROR: refusing to share system path '$path'" >&2; exit 1 ;;
    esac

    local acl_perm
    case "$mode" in
        rw) acl_perm="rwX" ;;
        ro) acl_perm="rX" ;;
        *)  echo "ERROR: --mode must be rw or ro (got '$mode')" >&2; exit 2 ;;
    esac

    # TTL (#4409): a share with --ttl has a scheduled removal or does not happen. The job
    # is queued, and its success read, BEFORE any ACL changes; at's own error is shown,
    # never discarded. The job runs the fixed tool path, not $0.
    local at_job="" at_out=""
    local ttl_forms="Accepted forms: a positive number and a unit spelled out, minutes, hours, days or weeks, for example --ttl 2hours, 3days, 30minutes or 1week (at(1) rejects 2h and 2d)."
    if (( ttl_given )); then
        # A closed grammar, checked before at is called: the value is interpolated into
        # at's timespec, and 0minutes would fire before the grant lands and leave it forever.
        [[ "$ttl" =~ ^[1-9][0-9]*(minutes?|hours?|days?|weeks?)$ ]] \
            || { echo "ERROR: --ttl '$ttl' is not an accepted form; nothing was granted. $ttl_forms" >&2; exit 2; }
        command -v at >/dev/null 2>&1 \
            || { echo "ERROR: --ttl needs 'at' and it is not installed; nothing was granted. Install it (apt install at), or share without --ttl and unshare by hand. $ttl_forms" >&2; exit 1; }
        # at queues a job that nothing runs when atd is down: the share would be permanent
        # while reported as scheduled. Checked where systemctl exists; at is the arbiter elsewhere.
        if command -v systemctl >/dev/null 2>&1 && ! systemctl is-active --quiet atd; then
            echo "ERROR: --ttl needs the at daemon and 'systemctl is-active atd' says it is not running; nothing was granted. Start it (systemctl start atd), or share without --ttl and unshare by hand." >&2
            exit 1
        fi
        [[ -x "$AGENTCTL_TOOL" ]] \
            || { echo "ERROR: --ttl queues '$AGENTCTL_TOOL unshare ...' and that file is not an executable; nothing was granted. Install agentctl there (root:root, mode 0755)." >&2; exit 1; }
        # ttl-queue-begin
        if at_out="$(printf '%s %s %s %s\n' "$(_shq "$AGENTCTL_TOOL")" unshare "$(_shq "$agent")" "$(_shq "$path")" | at "now + $ttl" 2>&1)"; then
            at_job="$(sed -n 's/^job \([0-9][0-9]*\) at .*/\1/p' <<< "$at_out")"
            [[ -n "$at_job" ]] || at_job="unknown"
            echo "  scheduled auto-unshare at: now + $ttl (job $at_job)"
        else
            echo "ERROR: at rejected the time 'now + $ttl'; nothing was granted. at said: $at_out. $ttl_forms" >&2
            exit 1
        fi
        # ttl-queue-end
    fi

    # Parent traversal: walk from path's parent up to /, add g:user:--x ACL.
    # setfacl is idempotent — re-running is safe.
    local parent
    parent=$(dirname "$path")
    while [[ "$parent" != "/" && -n "$parent" ]]; do
        setfacl -m "g:$user:--x" "$parent" \
            || { echo "ERROR: setfacl --x failed on '$parent'" >&2; _ttl_job_undo "$at_job"; exit 1; }
        # Preserve the invoking human user's read+traverse on every ancestor
        # we restrict via named-group --x. Without this, if the invoker is a
        # member of the named group (e.g. the operator is in the agent groups for
        # read access to agent home dirs at mode 0750), the named-group entry
        # overrides their own access — they cannot ls the ancestor. Bug
        # surfaced 2026-05-07 on /home; workaround was setfacl -m u:<operator>:rx.
        # This makes the workaround structural (every share preserves invoker).
        if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
            setfacl -m "u:$SUDO_USER:r-x" "$parent" \
                || echo "WARNING: preserve u:$SUDO_USER:r-x failed on '$parent'" >&2
        fi
        parent=$(dirname "$parent")
    done

    # Target: recursive ACL. -P: never follow a link. Without it a link swapped in at
    # the argument puts the entry (with -d, a DEFAULT entry that later files inherit)
    # on the link's target directory; with it, setfacl applies nothing and exits 0,
    # which is why the read-back below is not optional.
    setfacl -R -P -m "g:$user:$acl_perm" "$path" \
        || { echo "ERROR: setfacl $acl_perm failed on '$path'" >&2; _ttl_job_undo "$at_job"; exit 1; }

    # Default ACL on directories so new files inherit
    if [[ -d "$path" ]]; then
        setfacl -R -P -d -m "g:$user:$acl_perm" "$path" \
            || { echo "ERROR: default ACL setfacl failed on '$path'" >&2; _ttl_job_undo "$at_job"; exit 1; }
    fi

    # Read-back on $path ITSELF, after both calls: refuse loudly, with no "Shared", no
    # state record and no log line, when the entry is not there.
    local rb=0
    _acl_has "$path" "group:$user" || rb=$?
    if (( rb )); then
        echo "ERROR: read-back failed: '$path' does not carry g:$user after setfacl (rc=$rb; 1 = absent: a link swapped in at that name, or a filesystem without ACLs; 2 = could not be read). Nothing is recorded." >&2
        _ttl_job_undo "$at_job"; exit 1
    fi
    if [[ -d "$path" ]]; then
        rb=0
        _acl_has "$path" "default:group:$user" || rb=$?
        if (( rb )); then
            echo "ERROR: read-back failed: '$path' carries no default entry for $user after setfacl -d (rc=$rb). Nothing is recorded." >&2
            _ttl_job_undo "$at_job"; exit 1
        fi
    fi

    # Git safe.directory exception: git 2.35.2+ refuses to operate on repos owned
    # by a different uid (CVE-2022-24765). ACL access is necessary but not
    # sufficient — the agent's gitconfig needs an explicit safe.directory entry
    # at the repo root. Idempotent (git tolerates duplicate entries).
    if command -v git >/dev/null 2>&1; then
        local git_repo_root=""
        if git_repo_root=$(sudo -u "$user" git -C "$path" rev-parse --show-toplevel 2>/dev/null); then
            sudo -u "$user" git config --global --add safe.directory "$git_repo_root" \
                && echo "  + git safe.directory: $git_repo_root (for $user)"
        fi
    fi

    # State tracking
    # $agent is a real account name here: resolve_user (above) proved it exists,
    # so it cannot carry a slash. Keep that order (cell O1).
    local state_dir="$AGENTCTL_STATE/share-state"
    local state_file="$state_dir/$agent.json"
    AGENT="$agent" SHARE_PATH="$path" SHARE_MODE="$mode" SHARE_TTL="$ttl" STATE_FILE="$state_file" \
    python3 - <<'PYEOF' || { echo "ERROR: share happened but its state record could not be written ($state_file). The share IS in force${at_job:+ and its auto-unshare job $at_job remains queued}. Exit code $EXIT_ACTION_UNLOGGED: do not repeat the share; repair the state directory." >&2; exit "$EXIT_ACTION_UNLOGGED"; }
import json, os
from datetime import datetime, timezone
sf = os.environ['STATE_FILE']
entry = {
    "path": os.environ['SHARE_PATH'],
    "mode": os.environ['SHARE_MODE'],
    "ttl": os.environ['SHARE_TTL'] or None,
    "granted_at": datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z'),
}
state = []
if os.path.exists(sf):
    try: state = json.load(open(sf))
    except Exception: state = []
state = [s for s in state if s.get("path") != entry["path"]]
state.append(entry)
# temp file in the (root-only) state directory + atomic replace; mode 0644 from an
# explicit umask, no chgrp, no chmod.
os.umask(0o022)
tmp = f"{sf}.tmp.{os.getpid()}"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
with os.fdopen(fd, "w") as fh:
    json.dump(state, fh, indent=2)
os.replace(tmp, sf)
PYEOF

    audit share "$agent" "$path" "mode=$mode ttl=${ttl:-none}" || exit "$EXIT_ACTION_UNLOGGED"
    echo "✓ Shared $path with $agent (mode=$mode${ttl:+, ttl=$ttl})"
}

cmd_unshare() {
    local agent="${1:-}"; shift || true
    local path="${1:-}"; shift || true
    [[ -z "$agent" || -z "$path" ]] && {
        echo "Usage: sudo agentctl unshare <agent> <path>" >&2; exit 2
    }
    require_root unshare
    _state_dir_init || exit 1
    local user; user=$(resolve_user "$agent")
    path=$(readlink -f "$path" 2>/dev/null || echo "$path")
    # The fallback keeps the operator's RAW path. `setfacl -R -P` on a link WITH a
    # trailing slash acts on the link's target (setfacl 2.3.2, measured), so strip it:
    # the bare name is then the link itself and the -L test below refuses it.
    while [[ "$path" != "/" && "$path" == */ ]]; do path="${path%/}"; done

    # Remove recursive + default ACL
    if [[ -e "$path" ]]; then
        # Residual, not a guard: operator-chosen path resolved by readlink -f; this
        # -L test is a check-then-use gap. The LEAF is closed by -P on every recursive
        # call plus the read-back below; a swapped MIDDLE component stays open and is
        # not closed here (engram-alpha#4405).
        [[ -L "$path" ]] && { echo "ERROR: '$path' is a symbolic link; refusing to remove ACLs through it" >&2; exit 1; }
        # -P: never follow a link at the argument. -n: do NOT recalculate the mask: a
        # plain -x can widen a restricted file (mode 600, mask --- became 640, mask
        # r--, measured by two seats). No `|| true`: a recursive removal that meets a
        # directory it cannot list exits 1 and keeps going, and that is a PARTIAL
        # removal, reported as one below. setfacl's own message stays on stderr.
        local rm_rc=0
        setfacl -R -P -n -x "g:$user" "$path" || rm_rc=1
        if [[ -d "$path" ]]; then
            setfacl -R -P -d -n -x "g:$user" "$path" || rm_rc=1
        fi
        if (( rm_rc )); then
            echo "ERROR: removal from '$path' was PARTIAL: setfacl failed on part of the tree (its message is above). The path it names is the directory it could not LIST: that directory lost its own entry, and the entries that remain sit on its children. Entries may remain; the share record is kept and no ancestor was cleaned. Fix the cause and run unshare again, then check with: getfacl -R -p '$path'" >&2
            audit unshare-partial "$agent" "$path" "removal=incomplete" || exit "$EXIT_ACTION_UNLOGGED"
            exit 1
        fi
        # A link at $path NOW is a refusal: -P applied nothing through it, and getfacl
        # follows it, so a swapped-in link to a directory without the entry would pass the
        # entry test below as "gone" while the real directory was never processed.
        [[ -L "$path" ]] && { echo "ERROR: '$path' is a symbolic link after the removal (swapped in while this ran); the real directory was not processed. The share record is kept. Check with: getfacl -p '$path'" >&2; exit 1; }
        # Read-back on $path ITSELF: the entry (and, on a directory, the default entry)
        # must be gone. A read that fails is not an absence.
        local rb=0
        _acl_has "$path" "group:$user" || rb=$?
        if (( rb != 1 )); then
            echo "ERROR: read-back failed: '$path' still carries g:$user, or its ACL could not be read (rc=$rb; 0 = still there, 2 = unreadable). Not removed; check with: getfacl -p '$path'" >&2
            exit 1
        fi
        if [[ -d "$path" ]]; then
            rb=0
            _acl_has "$path" "default:group:$user" || rb=$?
            if (( rb != 1 )); then
                echo "ERROR: read-back failed: '$path' still carries a default entry for $user, or its ACL could not be read (rc=$rb). Not removed; check with: getfacl -p '$path'" >&2
                exit 1
            fi
        fi
    fi

    # Update state file
    local state_file="$AGENTCTL_STATE/share-state/$agent.json"
    if [[ -f "$state_file" ]]; then
        SHARE_PATH="$path" STATE_FILE="$state_file" python3 - <<'PYEOF' || { echo "ERROR: unshare removed the ACL entries from '$path' (the removal happened) but the state record could not be rewritten ($state_file). Exit code $EXIT_ACTION_UNLOGGED: do not repeat the unshare; repair the record and add the log line by hand. No ancestor was cleaned and no audit line was written." >&2; exit "$EXIT_ACTION_UNLOGGED"; }
import json, os
sf = os.environ['STATE_FILE']
target = os.environ['SHARE_PATH']
state = json.load(open(sf))
state = [s for s in state if s.get("path") != target]
os.umask(0o022)
tmp = f"{sf}.tmp.{os.getpid()}"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
with os.fdopen(fd, "w") as fh:
    json.dump(state, fh, indent=2)
os.replace(tmp, sf)
PYEOF
        # GC parent --x ACLs: remove any parent ACL not needed by remaining shares
        REMAINING=$(STATE_FILE="$state_file" python3 -c "import json, os; print('\n'.join(s['path'] for s in json.load(open(os.environ['STATE_FILE']))))") \
            || { echo "ERROR: unshare removed the ACL entries from '$path' (the removal happened) but the state record could not be read back ($state_file). Exit code $EXIT_ACTION_UNLOGGED: do not repeat the unshare; repair the record and add the log line by hand. No ancestor was cleaned and no audit line was written." >&2; exit "$EXIT_ACTION_UNLOGGED"; }
        # An older record under $SHARED_ROOT (the agent-writable place shares were
        # recorded before #4405) means older shares exist that THIS state cannot see, and
        # they may depend on the ancestors' --x entries. Its mere presence (-e or -L)
        # decides: nothing is read from it, so a planted name can only make this clean-up
        # skip, which is harmless. The target's own ACL was already removed above.
        local old_state="$SHARED_ROOT/share-state/$agent.json"
        local parent
        if [[ -e "$old_state" || -L "$old_state" ]]; then
            echo "WARN: ancestor ACL clean-up SKIPPED: an older share record exists at $old_state (not read). The older shares may depend on the --x entries on the ancestors of '$path'. Check each ancestor with 'getfacl -p <ancestor>', and remove an entry by hand ('setfacl -n -x g:$user <ancestor>') only when no older share needs it." >&2
        else
            parent=$(dirname "$path")
            while [[ "$parent" != "/" && -n "$parent" ]]; do
                local still_needed=0
                while IFS= read -r remp; do
                    [[ -z "$remp" ]] && continue
                    case "$remp" in
                        "$parent"/*|"$parent") still_needed=1; break ;;
                    esac
                done <<< "$REMAINING"
                if [[ $still_needed -eq 0 ]]; then
                    setfacl -n -x "g:$user" "$parent" 2>/dev/null || true
                fi
                parent=$(dirname "$parent")
            done
        fi

        # GC git safe.directory: remove the agent's exception for this repo
        # root only if no remaining share is inside the same repo. Path may be
        # gone post-unshare, so try resolving repo root from path first; if that
        # fails, skip (stale gitconfig entry is harmless).
        if command -v git >/dev/null 2>&1; then
            local unshared_repo_root=""
            if unshared_repo_root=$(sudo -u "$user" git -C "$path" rev-parse --show-toplevel 2>/dev/null); then
                local still_needed_git=0
                while IFS= read -r remp; do
                    [[ -z "$remp" ]] && continue
                    local rem_root=""
                    if rem_root=$(sudo -u "$user" git -C "$remp" rev-parse --show-toplevel 2>/dev/null); then
                        if [[ "$rem_root" == "$unshared_repo_root" ]]; then
                            still_needed_git=1; break
                        fi
                    fi
                done <<< "$REMAINING"
                if [[ $still_needed_git -eq 0 ]]; then
                    sudo -u "$user" git config --global --unset-all safe.directory "$unshared_repo_root" 2>/dev/null \
                        && echo "  - git safe.directory: $unshared_repo_root (removed for $user)"
                fi
            fi
        fi
    fi

    audit unshare "$agent" "$path" || exit "$EXIT_ACTION_UNLOGGED"
    echo "✓ Unshared $path from $agent"
}

cmd_share_status() {
    local agent="${1:-}"
    local state_dir="$AGENTCTL_STATE/share-state"
    echo "(shares granted before the move to $AGENTCTL_STATE are not listed here; their ACLs may still be in force. The old records, if any, are at $SHARED_ROOT/share-state/<agent>.json: look there, and check the ACLs with getfacl)"
    if [[ ! -d "$state_dir" ]]; then
        echo "(no shares — $state_dir not yet created)"
        return 0
    fi
    if [[ -n "$agent" ]]; then
        local _; _=$(resolve_user "$agent") # validate
        local sf="$state_dir/$agent.json"
        if [[ -r "$sf" ]]; then
            echo "=== $agent ==="
            cat "$sf"
        else
            echo "No active shares for $agent"
        fi
    else
        local found=0
        for sf in "$state_dir"/*.json; do
            [[ -f "$sf" ]] || continue
            found=1
            local name; name=$(basename "$sf" .json)
            echo "=== $name ==="
            cat "$sf"
            echo
        done
        [[ $found -eq 0 ]] && echo "No active shares for any agent"
    fi
}

cmd_help() {
    # Print the usage header (everything between the shebang block and the
    # ===== divider). Anchored on the divider, not a hardcoded line number —
    # the old '3,61p' silently truncated the tail whenever the header grew.
    sed -n '3,/^# =====/p' "$0" | sed '$d'
}

