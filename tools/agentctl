# Usage: agentctl __forum-hint-url-ok <url>
# Exercises the --forum-url shape check directly: exit 0 = acceptable; exit 1
# plus the reason on stdout = refused. No sudo, no users, no side effects.
cmd__forum_hint_url_ok() {
    local url="${1-}" why
    if ! why="$(_forum_hint_url_problem "$url")"; then
        echo "forum-url: $why"
        exit 1
    fi
}

