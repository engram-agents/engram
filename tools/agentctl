# Not listed in user-facing help (internal verb, invoked programmatically).
# Usage: agentctl __parse-session-flags [args...]
# Exercises _parse_session_flags directly — no real agent user, no sudo, no
# resolve_user. Prints the parsed fields as KEY=VALUE lines (PLATFORM,
# NO_SHARE, AS_SELF, CD, CHARGE_FILE), followed by one EXTRA:<value> line per
# passthrough arg in original order. Used by the test suite to verify --as-self composes
# with --platform, -c/-d/-r aliases (which land untouched in EXTRA), --cd,
# and --no-share without altering their parsed values.
cmd__parse_session_flags() {
    local platform="" no_share=0 as_self=0 cd="" charge_file="" extra=()
    _parse_session_flags platform no_share as_self cd charge_file extra -- "$@" || exit $?
    printf 'PLATFORM=%s\n' "$platform"
    printf 'NO_SHARE=%s\n' "$no_share"
    printf 'AS_SELF=%s\n' "$as_self"
    printf 'CD=%s\n' "$cd"
    printf 'CHARGE_FILE=%s\n' "$charge_file"
    for a in "${extra[@]}"; do
        printf 'EXTRA:%s\n' "$a"
    done
}

