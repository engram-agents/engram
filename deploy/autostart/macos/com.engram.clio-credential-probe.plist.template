<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.engram.clio-credential-probe.plist: THROWAWAY, ONE-TIME diagnostic
  LaunchDaemon (engram-alpha#3002 follow-on). This is NOT the real wake
  mechanism (see com.engram.clio-wake.plist.template for that). It answers
  a single open question BEFORE the real LaunchDaemon migration is
  installed: can a process with no GUI session anywhere in its ancestry
  (a LaunchDaemon with a UserName key) read this account's macOS login
  Keychain, where Claude Code stores its "Claude Code-credentials" secret?

  Install as a ROOT-owned LaunchDaemon (/Library/LaunchDaemons/) via
  `sudo launchctl bootstrap system/...`, unlike the real wake mechanism's
  user-level, no-sudo LaunchAgent. See this directory's README.md "Before
  installing" section for the exact install/verify/teardown sequence. Load
  it, read $HOME/.engram/credential-probe-result.txt, then
  `sudo launchctl bootout` it immediately. Never leave this loaded as a
  standing job: it is a diagnostic, not a service.

  Substitute __CLIO_ACCOUNT__, __CREDENTIAL_PROBE_SH__, and __HOME__ below
  before loading (launchd does not expand ~ or $HOME, and no real macOS
  account name is hardcoded anywhere in this repo).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.engram.clio-credential-probe</string>

    <!--
      UserName, not the invoking-user default: this is what makes the probe
      meaningful at all. Without it, launchd would run this as root, which
      answers a different (and uninteresting) question: root's own
      keychain state, not this account's.
    -->
    <key>UserName</key>
    <string>__CLIO_ACCOUNT__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CREDENTIAL_PROBE_SH__</string>
    </array>

    <!--
      RunAtLoad true, no StartInterval/StartCalendarInterval: this is a
      one-shot diagnostic, not a recurring service. It only needs to fire
      once, on `sudo launchctl bootstrap`, so the human can read the result
      and tear it down immediately after.
    -->
    <key>RunAtLoad</key>
    <true/>

    <!--
      Own stdout/stderr log path, separate from the real wake mechanism's
      logs entirely: needed specifically because a failure that happens
      BEFORE credential-probe.sh itself can run (e.g. the substituted path
      is wrong, or the script isn't executable) would otherwise be
      invisible, since the script's own result file is never written in
      that case.
    -->
    <key>StandardOutPath</key>
    <string>__HOME__/.engram/credential-probe-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.engram/credential-probe-launchd.log</string>
</dict>
</plist>
