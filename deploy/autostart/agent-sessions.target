# agent-sessions.target — grouping target triggered by agent-sessions.timer
# at 08:15 America/New_York. Wants= each Claude-running agent's per-instance
# agent-session@<name>.service. Stagger (~30s apart) is applied via
# per-instance ExecStartPre drop-ins on the individual instances, NOT here —
# see deploy/autostart/README.md.
#
# Mira runs Codex, not Claude Code, and is deliberately NOT listed below
# pending a supervised trial. When enabled, use the ordinary
# agent-session@mira.service launcher: agentctl detects the Codex platform,
# ensures its managed daemon, and replaces that already-named tmux pane with a
# remote TUI. Do NOT install the retired direct-app-server example.
#
# Luria is NOT listed: she is an off-host agent with no Linux user on this
# machine. Found live at the 2026-07-24 08:15 rehearsal — her instance failed
# with status=217/USER ("Failed to determine user credentials"). List only
# agents whose agent-<name> user exists on THIS host.

[Unit]
Description=All boot-time agent sessions (triggered daily at 08:15 America/New_York)
Wants=agent-session@kepler.service
Wants=agent-session@borges.service
Wants=agent-session@ariadne.service
Wants=agent-session@sol.service
Wants=agent-session@zephyr.service

[Install]
WantedBy=multi-user.target
